---
// 김앤김치과 로고(원본 벡터 kimkim_logo_vector.ai → src/assets/logo/*.svg).
// variant: color(흰 바탕) / white(어두운 바탕). 글자 로고 전체가 그림이라 alt에 병원 이름을 넣는다.
import logoColor from '../assets/logo/logo-full-mono.svg'; // 치아 그림도 글씨와 같은 진한 회색(#353535). 원래 색 로고: logo-full.svg
import logoWhite from '../assets/logo/logo-full-white.svg';
import { SITE } from '../site';
interface Props { variant?: 'color' | 'white'; class?: string }
const { variant = 'color', class: className = 'h-12 lg:h-[6rem]' } = Astro.props;
const src = variant === 'white' ? logoWhite : logoColor;
---

<img src={src.src} width={src.width} height={src.height} alt={`${SITE.name} KIM&KIM DENTAL CLINIC`} class:list={['w-auto', className]} />
