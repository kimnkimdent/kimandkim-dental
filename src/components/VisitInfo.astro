---
// 전 페이지 하단 공통 영역: 공통 메시지 → 병원 방문 안내(진료시간 · 오시는 길·주차 · 예약·문의).
// 내용은 src/site.ts에서 바꾼다. 하단 고정 버튼 "오시는 길"이 여기(#visit)로 온다.
import { SITE, tel } from '../site';
import Container from './Container.astro';
import Button from './Button.astro';
import Mark from './Mark.astro';
const c = SITE.contact;
// 첫 페이지는 영상 첫 화면에 같은 문구가 있어서 파란 공통 메시지 띠를 뺀다
const isHome = Astro.url.pathname === import.meta.env.BASE_URL || Astro.url.pathname === import.meta.env.BASE_URL + '/' || Astro.url.pathname === '/';
---

{!isHome && (
<section class="bg-primary py-16 text-center text-primary-foreground md:py-20">
  <Container>
    <Mark tone="white" class="mx-auto mb-5 size-20 md:size-24" />
    <p class="t-headline font-bold">{SITE.slogan}</p>
    <p class="mt-3 t-mid opacity-90">{SITE.since}년부터 운정 한자리에서, 한 가족의 시간을 함께해 왔습니다.</p>
  </Container>
</section>
)}

<section id="visit" class="scroll-mt-20 bg-surface py-section" aria-labelledby="visit-title">
  <Container>
    <p class="mb-3 t-body font-semibold text-primary">병원 방문 안내</p>
    <h2 id="visit-title" class="t-headline font-bold">진료시간 · 오시는 길</h2>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      <div class="rounded-3xl bg-background p-7 shadow-sm md:p-8">
        <h3 class="t-head font-bold">진료시간</h3>
        <dl class="mt-5 divide-y divide-border">
          {
            SITE.hours.map((h) => (
              <div class="flex flex-wrap justify-between gap-x-4 gap-y-1 py-3">
                <dt class:list={['t-body', h.highlight ? 'font-bold text-primary' : 'font-semibold']}>{h.label}</dt>
                <dd class:list={['t-body text-foreground-muted', h.highlight && 'font-bold']}>{h.time}</dd>
              </div>
            ))
          }
          <div class="flex flex-wrap justify-between gap-x-4 gap-y-1 py-3">
            <dt class="t-body font-semibold">점심시간</dt>
            <dd class="t-body text-foreground-muted">{SITE.lunch}</dd>
          </div>
          <div class="flex flex-wrap justify-between gap-x-4 gap-y-1 py-3">
            <dt class="t-body font-bold">{SITE.closedDays}</dt>
            <dd class="t-body font-bold text-foreground-muted">휴진</dd>
          </div>
        </dl>
        <p class="mt-4 rounded-xl bg-surface px-4 py-3 t-body text-foreground-muted">공휴일 진료 여부는 전화로 문의해 주세요.</p>
      </div>

      <div class="rounded-3xl bg-background p-7 shadow-sm md:p-8">
        <h3 class="t-head font-bold">오시는 길 · 주차</h3>
        <p class="mt-5 t-mid font-semibold">{c.address}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <Button href={c.map} variant="secondary" size="sm">네이버 지도</Button>
          <Button href={c.kakaoMap} variant="secondary" size="sm">카카오맵</Button>
        </div>
        <p class="mt-6 t-body font-semibold text-primary">무료 주차</p>
        <ul class="mt-2 space-y-1.5 t-body text-foreground-muted">
          {c.parking.map((p) => <li>· {p}</li>)}
        </ul>
      </div>

      <div class="flex flex-col rounded-3xl bg-background p-7 shadow-sm md:p-8">
        <h3 class="t-head font-bold">예약 · 문의</h3>
        <p class="mt-5 t-body text-foreground-muted">대표전화</p>
        <a href={tel} class="mt-1 text-[3rem] font-extrabold tracking-tight text-primary md:text-[3.6rem]">{c.phone}</a>
        <div class="mt-auto grid gap-2 pt-6">
          <Button href={c.booking} variant="naver" full>네이버 예약</Button>
          <Button href={tel} variant="secondary" full>전화 상담</Button>
        </div>
      </div>
    </div>
  </Container>
</section>
