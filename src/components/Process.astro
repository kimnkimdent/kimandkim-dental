---
// 번호가 붙은 진료 과정(가로 흐름, 휴대폰은 2열). PC에서는 카드 사이에 화살표. items: { title, text?, img? } — img가 있으면 카드 위에 그림이 들어간다.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { items: { title: string; text?: string; img?: ImageMetadata }[]; trim?: boolean } // trim: 휴대폰에서 그림 위아래 빈 곳을 잘라 상자를 낮춘다(그림 주위 여백이 넓을 때만)
const { items, trim = false } = Astro.props;
const cols = { 4: 'lg:grid-cols-4', 5: 'lg:grid-cols-5', 6: 'lg:grid-cols-6' }[items.length] ?? 'lg:grid-cols-4';
const withImg = items.some((it) => it.img);
---

<ol class:list={['grid gap-3 md:gap-4', withImg ? 'sm:grid-cols-2' : 'grid-cols-2', cols]}>
  {
    items.map((it, i) => (
      <li class="relative rounded-2xl border border-border bg-background p-5 md:p-6">
        {it.img && <Image src={it.img} alt={`${it.title} 과정 그림`} widths={[360, 480]} sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 100vw" class:list={['h-auto w-full rounded-xl bg-white', trim ? 'mb-3 aspect-[5/4] object-cover sm:mb-5 sm:aspect-[8/9] sm:object-contain' : 'mb-5 aspect-[8/9] object-contain']} />}
        <div class="flex items-center gap-3">
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary t-body font-bold text-primary-foreground">{i + 1}</span>
          <p class="t-mid font-bold">{it.title}</p>
        </div>
        {it.text && <p class="mt-1.5 t-body leading-relaxed text-foreground-muted">{it.text}</p>}
        {i < items.length - 1 && <span aria-hidden="true" class="absolute top-1/3 -right-[3rem] z-10 hidden size-11 items-center justify-center rounded-full border border-border bg-background text-[1.8rem] text-primary shadow-sm lg:flex">→</span>}
      </li>
    ))
  }
</ol>
