---
// 하위 페이지 맨 위 큰 제목 영역(h1). 경로 표시 · 작은 라벨 · 제목 · 설명.
// 장식: watermark(글자, 예: 易地思之)가 있으면 제목 뒤 왼쪽에 크게. 없으면 KIM+ 심볼을 오른쪽에 아주 크게 깔아
// 화면 가장자리에서 일부가 잘리고, 아래 카드(진료 노트 등)가 일부를 가리게 둔다.
import Container from './Container.astro';
import { br } from '../site';
import Mark from './Mark.astro';
import ServiceIcon from './ServiceIcon.astro';
interface Props {
  crumbs?: string[]; // 예: ['병원소개', '김앤김 이야기']
  eyebrow?: string;
  title: string;
  accent?: string[]; // 제목 안에서 하늘색(primary-bright)으로 칠할 말(예: ['2012년', '작은 약속'])
  as?: 'h1' | 'h2'; // 첫 페이지에 이어 붙일 땐 h2(한 페이지에 h1은 하나)
  suffix?: string; // 제목 뒤에 아주 작게 붙는 말(예: '김앤김치과')
  lead?: string;
  watermark?: string;
  clinic?: 'silver' | 'adult' | 'kids'; // 진료 과목 색
  icon?: 'about' | 'philosophy' | 'silver' | 'adult' | 'kids' | 'qna'; // 라벨 옆 픽토그램(홈 진료 안내와 같은 그림). 없으면 clinic 값을 쓴다
}
const { crumbs = [], eyebrow, title, suffix, as: Tag = 'h1', lead, watermark, clinic, icon, accent = [] } = Astro.props;
// 제목을 강조할 말 기준으로 나눈다(강조할 말은 그대로 남김)
let parts = [title];
for (const a of accent) parts = parts.flatMap((p) => (accent.includes(p) ? [p] : p.split(a).flatMap((t, k) => (k ? [a, t] : [t]))));
const pictogram = icon ?? clinic;
---

<section class="relative isolate overflow-hidden bg-gradient-to-b from-primary-surface to-background pt-14 pb-16 md:pt-20 md:pb-24">
  {!watermark && <Mark tone="faint" class="pointer-events-none absolute top-1/2 right-[4%] -z-10 h-[min(80%,26rem)] w-auto -translate-y-1/2 md:h-[min(84%,46rem)]" />}
  <Container class="relative">
    {crumbs.length > 0 && <p class="relative z-10 t-body text-foreground-muted">홈 &gt; {crumbs.join(' > ')}</p>}

    <!-- 제목 묶음 -->
    <div class="relative">
      {
        watermark && (
          <p aria-hidden="true" class="pointer-events-none absolute top-1/2 left-[-0.06em] -translate-y-1/2 font-serif text-[11rem] leading-none font-bold whitespace-nowrap text-primary opacity-[0.08] select-none sm:text-[16rem] md:text-[22rem]">
            {watermark}
          </p>
        )
      }
      {eyebrow && <p class="relative mt-6 flex items-center gap-2.5 t-mid font-semibold text-primary">{pictogram && <ServiceIcon name={pictogram} class={['silver','adult','kids'].includes(pictogram) ? 'size-20 md:size-24' : 'size-10 md:size-12'} />}{eyebrow}</p>}
      <Tag class:list={['relative t-display font-bold whitespace-pre-line', eyebrow ? 'mt-2' : 'mt-6']}>{parts.map((p) => (accent.includes(p) ? <span class="text-primary-bright">{p}</span> : p))}{suffix && <span class="ml-3 align-baseline t-mid font-semibold text-foreground-muted">{suffix}</span>}</Tag>
      {lead && <p data-speakable class="relative mt-5 max-w-prose t-mid whitespace-pre-line text-foreground-muted">{br(lead)}</p>}
    </div>

    <div class="relative">
      <slot />
    </div>
  </Container>
</section>
