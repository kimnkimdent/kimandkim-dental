---
// "이런 고민 있으신가요?" 한 줄 띠: 진료실 사진을 어둡게 깐 위로, 환자분 말 같은 말풍선이 한 줄로 천천히 흐른다.
// 같은 목록을 두 번 이어 붙여 끊김 없이 반복. 마우스를 올리면 멈추고, '동작 줄이기' 설정이면 흐르지 않고 줄바꿈해 모두 보인다.
// 실버·청장년·어린이 클리닉 제목 바로 아래에 같은 모양으로 쓴다. 목록은 각 페이지에서 넘긴다.
import { Image } from 'astro:assets';
import bg from '../assets/photos/treatment-room.jpg';
interface Props { items: string[]; title?: string }
const { items, title = '이런 고민 있으신가요?' } = Astro.props;
---

<section class="relative isolate overflow-hidden py-10 text-white md:py-14" aria-label={title}>
  <Image src={bg} alt="" aria-hidden="true" widths={[800, 1600]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-secondary/75"></div>
  <h2 class="px-gutter text-center t-headline font-bold">{title}</h2>
  <ul class="sr-only">{items.map((w) => <li>{w}</li>)}</ul>
  <div aria-hidden="true" class="worry-flow mt-6 overflow-hidden md:mt-8">
    <div class="worry-track flex w-max py-3">
      {[...items, ...items].map((w, i) => (
        <p class:list={[i >= items.length && 'dup', 'mr-5 shrink-0 rounded-[2.4rem] px-7 py-5 font-serif t-mid font-bold whitespace-nowrap md:px-9 md:py-6 md:text-[2rem]', i % 2 ? 'rounded-br-md bg-primary-bright text-secondary' : 'rounded-bl-md bg-background text-foreground shadow-sm']} style={`margin-top:${[0, 1.6, 0.6, 2.2][i % 4]}rem`}>
          “{w}”
        </p>
      ))}
    </div>
  </div>
</section>

<style>
  /* 같은 줄을 두 번 이어 붙였으므로 절반(-50%)만큼 움직이면 처음과 같아진다 */
  .worry-flow { mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .worry-track { align-items: flex-start; animation: worry-flow 70s linear infinite; }
  .worry-flow:hover .worry-track { animation-play-state: paused; }
  @keyframes worry-flow { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .worry-track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
    .dup { display: none; }
  }
</style>
