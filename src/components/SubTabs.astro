---
// 같은 메뉴 안의 하위 페이지 이동 탭(예: 청장년 클리닉 > 임플란트 · 자연치아·심미보철 · 사랑니·구강외과).
import { url } from '../site';
interface Props { items: { href: string; label: string }[]; current: string }
const { items, current } = Astro.props;
---

<nav aria-label="하위 메뉴" class="mt-8 flex flex-wrap gap-2">
  {
    items.map((it) => (
      <a
        href={url(it.href)}
        aria-current={it.href === current ? 'page' : undefined}
        class:list={[
          'inline-flex min-h-11 items-center rounded-full border px-5 t-body font-semibold transition-colors',
          it.href === current ? 'border-primary bg-primary text-primary-foreground' : 'border-border-accent bg-background text-foreground-muted hover:border-primary hover:text-primary',
        ]}
      >
        {it.label}
      </a>
    ))
  }
</nav>
