---
// 버튼. href가 있으면 링크(<a>), 없으면 <button>으로 그려진다.
// 내부 링크는 url('/qna/')처럼 url()로 감싸서 넘긴다. 전화는 tel 값(site.ts의 tel).
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'naver' | 'white';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  full?: boolean; // 가로로 꽉 채우기
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', type = 'button', full = false, class: className = '', ...rest } = Astro.props;

const base = 'inline-flex items-center justify-center gap-2 rounded-full font-bold whitespace-nowrap transition-colors duration-150';
const sizes = {
  sm: 'min-h-10 px-5 py-2 t-body',
  md: 'min-h-12 px-6 py-2.5 t-body',
  lg: 'min-h-14 px-8 py-3 t-mid',
};
const variants = {
  primary: 'border border-primary bg-primary text-primary-foreground hover:bg-secondary hover:border-secondary',
  secondary: 'border border-border-accent bg-background text-foreground hover:border-primary hover:text-primary',
  ghost: 'text-primary hover:bg-primary-surface',
  white: 'border border-white bg-white text-primary hover:bg-primary-surface',
  naver: 'border border-[#03a94d] bg-[#03a94d] text-white hover:bg-[#02923f]', // 네이버 예약(네이버 초록, 흰 글자 대비 확보)
};
const classes = [base, sizes[size], variants[variant], full && 'w-full', className];
const external = href?.startsWith('http');
---

{
  href ? (
    <a href={href} class:list={classes} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
