---
// 첫 페이지 4가지 원칙 아래: 진료 안내 한 줄 + 실버 · 청장년 · 어린이 클리닉 바로가기 버튼 3개(가운데 정렬).

import ServiceIcon from '../ServiceIcon.astro';
import { url } from '../../site';

const tabs = [
  { id: 'silver', label: '실버 클리닉' },
  { id: 'adult', label: '청장년 클리닉' },
  { id: 'kids', label: '어린이·청소년 클리닉' },
] as const;
---

<div id="clinics" class="mt-16 scroll-mt-28 md:mt-20">
  <div class="text-center">
    <p class="t-mid font-semibold text-foreground lg:text-[2.8rem]">아이부터 부모님까지, 연령에 맞춰 진료합니다.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3 lg:mt-10 lg:gap-5">
      {tabs.map((t) => (
        <a href={url(`/${t.id}/`)} class="inline-flex min-h-12 items-center gap-2 rounded-full lg:min-h-[6.4rem] lg:gap-3 lg:px-10 lg:text-[2rem] border border-border-accent bg-background px-6 t-body font-semibold text-foreground transition-colors hover:border-primary hover:bg-primary hover:text-primary-foreground">
          <ServiceIcon name={t.id} class="size-14 lg:size-20" />{t.label}
        </a>
      ))}
    </div>
  </div>
</div>
