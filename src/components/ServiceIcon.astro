---
// 홈 진료 안내 카드 픽토그램(내용에 맞춘 그림). 진한색 = 감싼 곳의 primary(진료 과목 색), 연한색 = primary-surface.
// about(한 가족) · philosophy(마음을 감싼 손) · silver(지팡이 짚은 어르신) · adult(믿음의 방패+치아) · kids(아이 얼굴) · qna(물음 말풍선)
interface Props { name: 'about' | 'philosophy' | 'silver' | 'adult' | 'kids' | 'qna'; class?: string }
const { name, class: className = 'size-12' } = Astro.props;
const D = 'var(--primary)';
const L = 'var(--primary-surface)';
---

<svg aria-hidden="true" viewBox="0 0 48 48" class={className} fill="none" stroke-linecap="round" stroke-linejoin="round">
  {name === 'about' && (
    <>
      {/* 한 가족: 어른 둘 + 아이 하나 */}
      <circle cx="14" cy="13" r="5.5" fill={D} />
      <circle cx="34" cy="13" r="5.5" fill={D} />
      <circle cx="24" cy="25" r="4.2" fill={D} />
      <path d="M4.5 41v-9c0-6 4.2-10.5 9.5-10.5 3.1 0 5.8 1.5 7.5 3.9" fill={L} stroke={D} stroke-width="2.6" />
      <path d="M43.5 41v-9c0-6-4.2-10.5-9.5-10.5-3.1 0-5.8 1.5-7.5 3.9" fill={L} stroke={D} stroke-width="2.6" />
      <path d="M16.5 41v-3.5c0-4.4 3.4-7.5 7.5-7.5s7.5 3.1 7.5 7.5V41z" fill={L} stroke={D} stroke-width="2.6" />
      <path d="M3 41h42" stroke={D} stroke-width="2.6" />
    </>
  )}
  {name === 'philosophy' && (
    <>
      {/* 두 손이 감싼 마음 */}
      <path d="M24 26.5c-.6 0-1.1-.2-1.5-.6l-6.3-6c-2.7-2.6-2.8-6.9-.2-9.4 2.2-2.2 5.8-2.2 8 0 2.2-2.2 5.8-2.2 8 0 2.6 2.5 2.5 6.8-.2 9.4l-6.3 6c-.4.4-.9.6-1.5.6z" fill={D} />
      <path d="M4 30l8.5-3.4c1.7-.7 3.6-.6 5.2.3L24 30l6.3-3.1c1.6-.9 3.5-1 5.2-.3L44 30v8l-9 3c-1.3.4-2.6.4-3.9 0L24 38.6 16.9 41c-1.3.4-2.6.4-3.9 0L4 38z" fill={L} stroke={D} stroke-width="2.6" />
    </>
  )}
  {name === 'silver' && (
    <>
      {/* 지팡이를 짚은 어르신 */}
      <circle cx="19" cy="9" r="5.5" fill={D} />
      <path d="M12 31.5V25c0-5 3-8.8 7-8.8s7 3.8 7 8.8v6.5z" fill={L} stroke={D} stroke-width="2.6" />
      <path d="M15.5 31.5V43M22.5 31.5V43" stroke={D} stroke-width="2.8" />
      <path d="M25 24.5l6 4" stroke={D} stroke-width="2.6" />
      <path d="M33 30v13" stroke={D} stroke-width="2.8" />
      <path d="M29.5 30.5c0-2.6 1.6-4.2 3.6-4.2 2.1 0 3.6 1.6 3.6 3.7" stroke={D} stroke-width="2.8" />
      <path d="M8 43h32" stroke={D} stroke-width="2.6" />
    </>
  )}
  {name === 'adult' && (
    <>
      {/* 믿음의 방패 + 치아 */}
      <path d="M24 4l16 6v11.5c0 10-6.8 18.3-16 21.5-9.2-3.2-16-11.5-16-21.5V10z" fill={L} stroke={D} stroke-width="2.6" />
      <path d="M24 15.2c-2-1.7-4.9-2-6.6-.6-2 1.7-1.7 5-1 7.5.7 2.1 1.1 4.4 1.7 6.5.3 1.1 1.8 1.2 2.1.1l1.1-3.5c.4-1.1 1.8-1.1 2.2 0l1.1 3.5c.4 1.1 1.9 1 2.1-.1.6-2.1 1-4.4 1.7-6.5.7-2.5 1-5.8-1-7.5-1.7-1.4-4.6-1.1-6.6.6z" fill={D} />
    </>
  )}
  {name === 'kids' && (
    <>
      {/* 웃는 아이 얼굴(양갈래 머리) */}
      <circle cx="9" cy="13" r="5" fill={D} />
      <circle cx="39" cy="13" r="5" fill={D} />
      <circle cx="24" cy="26" r="16" fill={L} stroke={D} stroke-width="2.6" />
      <path d="M11 20c3-6 8-9 13-9s10 3 13 9c-4-1.5-8-4-9.5-6.5C24.5 17 17 20 11 20z" fill={D} />
      <circle cx="18.5" cy="26.5" r="1.9" fill={D} />
      <circle cx="29.5" cy="26.5" r="1.9" fill={D} />
      <path d="M18.5 32c3.2 3.2 7.8 3.2 11 0" stroke={D} stroke-width="2.6" />
    </>
  )}
  {name === 'qna' && (
    <>
      {/* 물음표 말풍선 */}
      <path d="M8 8h32a4 4 0 0 1 4 4v20a4 4 0 0 1-4 4H22l-9 7v-7H8a4 4 0 0 1-4-4V12a4 4 0 0 1 4-4z" fill={L} stroke={D} stroke-width="2.6" />
      <path d="M19.5 17.5a4.5 4.5 0 1 1 6.4 4.1c-1.2.6-1.9 1.4-1.9 2.6v1.3" stroke={D} stroke-width="3" />
      <circle cx="24" cy="30" r="1.9" fill={D} />
    </>
  )}
</svg>
