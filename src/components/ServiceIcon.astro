---
// 홈 진료 안내 카드 픽토그램(내용에 맞춘 그림). 진한색 = 감싼 곳의 primary(진료 과목 색), 연한색 = primary-surface.
// about(치아+의료 십자) · philosophy(겹친 두 하트) · silver(할머니·할아버지 얼굴) · adult(엄마·아빠 얼굴) · kids(아이 얼굴) · qna(물음 말풍선)
interface Props { name: 'about' | 'philosophy' | 'silver' | 'adult' | 'kids' | 'qna'; class?: string }
const { name, class: className = 'size-12' } = Astro.props;
const D = 'var(--primary)';
const L = 'var(--primary-surface)';
// 그림마다 실제 차지하는 영역에 맞춘 보기 영역(같은 크기로 보이게). 실버·청장년(두 얼굴)은 20% 크게
const VB: Record<Props['name'], string> = {"about":"3.7 2.3 44.5 44.5","philosophy":"1.6 -0.95 46.8 46.8","silver":"6.42 3.92 35.17 35.17","adult":"5.54 6.54 36.42 36.42","kids":"2.4 3.4 43.2 43.2","qna":"2.4 3.9 43.2 43.2"};
---

<svg aria-hidden="true" viewBox={VB[name]} class={className} overflow="visible" fill="none" stroke-linecap="round" stroke-linejoin="round">
  {name === 'about' && (
    <>
      {/* 치아 + 의료 십자: 우리 동네 치과 */}
      <path transform="translate(1.5 2) scale(0.98)" d="M20 7.5C16.2 3.6 9.6 2.6 6.4 6.4 2.6 11 3.8 18.6 5.8 24.8c1.8 5.6 3 11.6 4.8 15 1.4 2.6 4.4 2.2 5.4-.4l2-5.6c.8-2.2 3.2-2.2 4 0l2 5.6c1 2.6 4 3 5.4.4 1.8-3.4 3-9.4 4.8-15 2-6.2 3.2-13.8-.6-18.4C30.4 2.6 23.8 3.6 20 7.5Z" fill={L} stroke={D} stroke-width="2.6" stroke-linejoin="round" />
      <path d="M12.5 10.5c2-1.3 4.6-1.4 6.8-.2" stroke={D} stroke-width="2.4" />
      <path d="M33 22h6a1.6 1.6 0 0 1 1.6 1.6V28h4.4a1.6 1.6 0 0 1 1.6 1.6v6a1.6 1.6 0 0 1-1.6 1.6h-4.4v4.4a1.6 1.6 0 0 1-1.6 1.6h-6a1.6 1.6 0 0 1-1.6-1.6v-4.4H27a1.6 1.6 0 0 1-1.6-1.6v-6A1.6 1.6 0 0 1 27 28h4.4v-4.4A1.6 1.6 0 0 1 33 22z" fill={D} stroke="#fff" stroke-width="2" />
    </>
  )}
  {name === 'philosophy' && (
    <>
      {/* 작은 하트(왼쪽 아래)와 큰 하트(오른쪽 위)가 살짝 겹침: 환자의 마음과 의사의 마음 */}
      <path transform="translate(15 30) rotate(-14) scale(0.95) translate(-12 -12)" d="M12 21c-.4 0-.8-.1-1.1-.4L3.6 14C.9 11.4.8 7.1 3.4 4.5c2.3-2.3 6-2.3 8.6 0 2.6-2.3 6.3-2.3 8.6 0 2.6 2.6 2.5 6.9-.2 9.5l-7.3 6.6c-.3.3-.7.4-1.1.4z" fill={L} stroke={D} stroke-width="2.74" />
      <path transform="translate(29.5 20) rotate(10) scale(1.45) translate(-12 -12)" d="M12 21c-.4 0-.8-.1-1.1-.4L3.6 14C.9 11.4.8 7.1 3.4 4.5c2.3-2.3 6-2.3 8.6 0 2.6-2.3 6.3-2.3 8.6 0 2.6 2.6 2.5 6.9-.2 9.5l-7.3 6.6c-.3.3-.7.4-1.1.4z" fill={L} stroke={D} stroke-width="1.79" />
    </>
  )}
  {name === 'silver' && (
    <>
      {/* 할머니(쪽진 머리) + 할아버지(안경, 옆머리) */}
      <circle cx="15" cy="9.5" r="4" fill={D} />
      <circle cx="15" cy="25" r="10.5" fill={L} stroke={D} stroke-width="2.4" />
      <circle cx="11.01" cy="26" r="1.5" fill={D} />
      <circle cx="18.990000000000002" cy="26" r="1.5" fill={D} />
      <path d="M11.01 29.41c3.99 3.5700000000000003 3.99 3.5700000000000003 7.98 0" stroke={D} stroke-width="2.2" />
      <path d="M5.2 22.5c1.6-5.4 5.4-8 9.8-8s8.2 2.6 9.8 8c-3-1.6-6.4-3.2-9.8-3.2s-6.8 1.6-9.8 3.2z" fill={D} />
      <circle cx="33" cy="27" r="10.5" fill={L} stroke={D} stroke-width="2.4" />
      <circle cx="29.009999999999998" cy="28" r="1.5" fill={D} />
      <circle cx="36.99" cy="28" r="1.5" fill={D} />
      <path d="M29.009999999999998 31.41c3.99 3.5700000000000003 3.99 3.5700000000000003 7.98 0" stroke={D} stroke-width="2.2" />
      <path d="M22.6 24.5c.2-2.2 1-3.6 2.2-4.6M43.4 24.5c-.2-2.2-1-3.6-2.2-4.6" stroke={D} stroke-width="2.6" />
      <circle cx="29" cy="28" r="2.9" fill="#fff" stroke={D} stroke-width="1.6" />
      <circle cx="37" cy="28" r="2.9" fill="#fff" stroke={D} stroke-width="1.6" />
      <path d="M31.9 28h2.2" stroke={D} stroke-width="1.6" />
      <circle cx="29" cy="28" r="1.1" fill={D} />
      <circle cx="37" cy="28" r="1.1" fill={D} />
    </>
  )}
  {name === 'adult' && (
    <>
      {/* 엄마(단발) + 아빠(짧은 머리) */}
      <path d="M3.5 33V24c0-6.4 5-11 11-11s11 4.6 11 11v9c-2-.6-3-2.2-3.4-4" fill={D} />
      <circle cx="14.5" cy="25.5" r="9.5" fill={L} stroke={D} stroke-width="2.4" />
      <circle cx="10.89" cy="26.5" r="1.5" fill={D} />
      <circle cx="18.11" cy="26.5" r="1.5" fill={D} />
      <path d="M10.89 29.49c3.61 3.2300000000000004 3.61 3.2300000000000004 7.22 0" stroke={D} stroke-width="2.2" />
      <path d="M5.4 23.5c1.4-4.6 4.8-7 9.1-7 3.4 0 6.6 1.8 8.4 5.2-4.6-.4-8.6-1.6-10.4-3.8-1.6 2.6-4 4.6-7.1 5.6z" fill={D} />
      <circle cx="33.5" cy="26" r="10.5" fill={L} stroke={D} stroke-width="2.4" />
      <circle cx="29.509999999999998" cy="27" r="1.5" fill={D} />
      <circle cx="37.49" cy="27" r="1.5" fill={D} />
      <path d="M29.509999999999998 30.41c3.99 3.5700000000000003 3.99 3.5700000000000003 7.98 0" stroke={D} stroke-width="2.2" />
      <path d="M23.4 23.8c1-5.6 5-8.8 10.1-8.8s9.1 3.2 10.1 8.8c-2.6-2.2-5.8-3.2-9-3.2-3.6 0-7.6 1-11.2 3.2z" fill={D} />
    </>
  )}
  {name === 'kids' && (
    <>
      {/* 웃는 아이 얼굴(양갈래 머리) */}
      <circle cx="9" cy="13" r="5" fill={D} />
      <circle cx="39" cy="13" r="5" fill={D} />
      <circle cx="24" cy="26" r="16" fill={L} stroke={D} stroke-width="2.6" />
      <path d="M11 20c3-6 8-9 13-9s10 3 13 9c-4-1.5-8-4-9.5-6.5C24.5 17 17 20 11 20z" fill={D} />
      <circle cx="18.5" cy="26.5" r="1.9" fill={D} />
      <circle cx="29.5" cy="26.5" r="1.9" fill={D} />
      <path d="M18.5 32c3.2 3.2 7.8 3.2 11 0" stroke={D} stroke-width="2.6" />
    </>
  )}
  {name === 'qna' && (
    <>
      {/* 물음표 말풍선 */}
      <path d="M8 8h32a4 4 0 0 1 4 4v20a4 4 0 0 1-4 4H22l-9 7v-7H8a4 4 0 0 1-4-4V12a4 4 0 0 1 4-4z" fill={L} stroke={D} stroke-width="2.6" />
      <path d="M19.5 17.5a4.5 4.5 0 1 1 6.4 4.1c-1.2.6-1.9 1.4-1.9 2.6v1.3" stroke={D} stroke-width="3" />
      <circle cx="24" cy="30" r="1.9" fill={D} />
    </>
  )}
</svg>
