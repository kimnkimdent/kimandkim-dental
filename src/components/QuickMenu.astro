---
// 고정 빠른 메뉴. 휴대폰: 화면 아래 3버튼(네이버 예약 · 전화 상담 · 오시는 길). 넓은 화면: 오른쪽 세로 묶음 + 맨 위로.
import { SITE, url, tel } from '../site';

const item = 'flex min-h-15 flex-col items-center justify-center gap-1 t-body font-bold transition-colors lg:size-[7.2rem] lg:rounded-2xl lg:text-[1.3rem]';
const icon = 'size-5 lg:size-6';
---

<nav
  aria-label="빠른 메뉴"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-border-accent bg-background pb-[env(safe-area-inset-bottom)] lg:inset-x-auto lg:top-1/2 lg:right-5 lg:bottom-auto lg:flex lg:-translate-y-1/2 lg:flex-col lg:gap-2 lg:border-0 lg:bg-transparent lg:pb-0"
>
  <a href={SITE.contact.booking} target="_blank" rel="noopener" class:list={[item, 'bg-[#03a94d] text-white hover:bg-[#02923f] lg:shadow-lg']}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M8 2.5v4M16 2.5v4M3 10h18M8.5 15l2.3 2.3 4.7-4.6"/></svg>
    네이버 예약
  </a>
  <a href={tel} class:list={[item, 'bg-primary text-white hover:bg-secondary lg:shadow-lg']}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
    전화 상담
  </a>
  <a href="#visit" class:list={[item, 'bg-background text-foreground hover:bg-surface lg:border lg:border-border lg:shadow-lg']}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
    오시는 길
  </a>
  <a href="#top" class:list={[item, 'hidden bg-background text-foreground-muted hover:bg-surface lg:flex lg:border lg:border-border lg:shadow-lg']}>
    <svg aria-hidden="true" class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    TOP
  </a>
</nav>
