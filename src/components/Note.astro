---
// 역지사지 진료 노트: 대표원장 1인칭 인용. 상자 없이 가운데 정렬한 '헌사' 느낌.
// 위: 원장님 원형 사진 + 라벨 / 뒤: 易地思之 큰 한자 워터마크 / 가운데: 명조 본문 / 아래: 양옆 가는 선 사이 서명.
// 줄바꿈: \n = 항상(PC는 이 자리에서만 바꿈), | = 휴대폰에서만.
// align 값은 예전 호환용(지금은 항상 가운데).
import { Image } from 'astro:assets';
import doctor from '../assets/doctor-kim.jpg';
interface Props { quote: string; align?: 'center' | 'left' }
const { quote } = Astro.props;
const lines = quote.split('\n').map((l) => l.split('|'));
---

<figure class="note relative isolate mx-auto max-w-[112rem] py-6 text-center md:py-10">
  <!-- 장식: 易地思之 워터마크 -->
  <span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-1/2 -z-10 -translate-x-1/2 -translate-y-1/2 font-serif text-[9rem] leading-none font-bold whitespace-nowrap text-primary opacity-[0.05] select-none md:text-[18rem]">易地思之</span>

  <!-- 사진 + 라벨 -->
  <span class="mx-auto block size-20 overflow-hidden rounded-full bg-primary-surface shadow-lg ring-4 ring-background md:size-24"><Image src={doctor} alt="대표원장 김정민" width={400} height={400} class="size-full origin-[50%_25%] translate-y-[6%] scale-[1.35] object-cover object-top" /></span>
  <p class="mt-5 t-body font-semibold tracking-[0.3em] text-primary">역지사지 진료 노트</p>

  <!-- 본문 -->
  <blockquote class="mt-6 font-serif text-[1.8rem] leading-[1.9] font-semibold break-keep text-secondary md:mt-8 md:text-[2.4rem] md:leading-[1.85] lg:whitespace-nowrap">
    <span aria-hidden="true" class="text-primary/50">“</span>{lines.map((parts, i) => (<>{i > 0 && <br />}{parts.map((p, j) => (<>{j > 0 && <><br class="md:hidden" /><span class="hidden md:inline"> </span></>}{p}</>))}</>))}<span aria-hidden="true" class="text-primary/50">”</span>
  </blockquote>

  <!-- 서명 -->
  <figcaption class="mt-8 flex items-center justify-center gap-4 md:mt-10">
    <span aria-hidden="true" class="h-px w-10 bg-primary/40 md:w-16"></span>
    <span class="t-body text-foreground-muted">대표원장 <span class="ml-1 font-serif t-mid font-bold tracking-[0.2em] text-foreground">김정민</span></span>
    <span aria-hidden="true" class="h-px w-10 bg-primary/40 md:w-16"></span>
  </figcaption>
</figure>
