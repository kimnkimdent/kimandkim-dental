---
// 진료 과목 픽토그램: 진료 과목 색으로 채운 치아 + 안쪽 흰 기호.
// silver(실버) = 하트(편안함) · adult(청장년) = 플러스(KIM+, 믿음) · kids(어린이·청소년) = 별(안심·칭찬)
// 색은 감싼 곳의 data-clinic 색(primary)을 따른다. 장식용.
interface Props { clinic: 'silver' | 'adult' | 'kids'; class?: string }
const { clinic, class: className = 'size-12' } = Astro.props;
const tooth =
  'M20 7.5C16.2 3.6 9.6 2.6 6.4 6.4 2.6 11 3.8 18.6 5.8 24.8c1.8 5.6 3 11.6 4.8 15 1.4 2.6 4.4 2.2 5.4-.4l2-5.6c.8-2.2 3.2-2.2 4 0l2 5.6c1 2.6 4 3 5.4.4 1.8-3.4 3-9.4 4.8-15 2-6.2 3.2-13.8-.6-18.4C30.4 2.6 23.8 3.6 20 7.5Z';
const glyph = {
  silver: 'M20 26.5c-.4 0-.8-.1-1.1-.4l-4.6-4.3c-2-1.9-2.1-5-.2-6.9 1.6-1.6 4.2-1.6 5.9 0 1.6-1.6 4.3-1.6 5.9 0 1.9 1.9 1.8 5-.2 6.9l-4.6 4.3c-.3.3-.7.4-1.1.4z',
  adult: 'M18.3 13.5h3.4v4.8h4.8v3.4h-4.8v4.8h-3.4v-4.8h-4.8v-3.4h4.8z',
  kids: 'M20 12.6l2.1 4.6 5 .5-3.8 3.4 1.1 4.9L20 23.5l-4.4 2.5 1.1-4.9-3.8-3.4 5-.5z',
}[clinic];
---

<span data-clinic={clinic} class:list={['inline-flex shrink-0 items-center justify-center', className]} aria-hidden="true">
  <svg viewBox="0 0 40 44" class="h-full w-auto">
    <path d={tooth} fill="var(--color-primary)" />
    <path d={glyph} fill="#fff" />
  </svg>
</span>
