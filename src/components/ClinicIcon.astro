---
// 진료 과목 그림: 실버(어르신 두 분) · 청장년(어른 두 분) · 어린이(아이 둘) 얼굴 일러스트를 동그랗게 넣는다. 장식용.
import { Image } from 'astro:assets';
import silver from '../assets/clinic/silver.png';
import adult from '../assets/clinic/adult.png';
import kids from '../assets/clinic/kids.png';
interface Props { clinic: 'silver' | 'adult' | 'kids'; class?: string }
const { clinic, class: className = 'size-12' } = Astro.props;
const src = { silver, adult, kids }[clinic];
---

<span data-clinic={clinic} class:list={['inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full', className]} aria-hidden="true">
  <Image src={src} alt="" width={240} height={240} class="size-full object-cover" />
</span>
