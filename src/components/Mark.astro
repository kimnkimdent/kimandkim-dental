---
// 로고 심볼(KIM+ 스마일 치아)을 픽토그램처럼 쓰는 부품. 장식용이라 화면읽기에서는 숨긴다.
// tone: color(하늘색+남색) / white(어두운 바탕) / faint(배경 워터마크용, 흐리게)
// blink: 흰 로고에서 웃는 입과 +가 번갈아 사라졌다 나타나는 움직임(첫 화면용). '동작 줄이기' 설정이면 멈춘다.
import mark from '../assets/logo/mark.svg';
import markWhite from '../assets/logo/mark-white.svg';
import whiteRaw from '../assets/logo/mark-white.svg?raw';
interface Props { tone?: 'color' | 'white' | 'faint'; class?: string; blink?: boolean }
const { tone = 'color', class: className = 'size-10', blink = false } = Astro.props;
const src = tone === 'white' ? markWhite : mark;
// blink용: 흰 로고 SVG의 path를 순서대로 꺼낸다(2번 = 웃는 입, 4번 = +)
const viewBox = whiteRaw.match(/viewBox="([^"]+)"/)?.[1];
const paths = whiteRaw.match(/<path[^>]*\/>/g) ?? [];
const cls = (i: number) => (i === 2 ? 'mark-smile' : i === 4 ? 'mark-plus' : '');
---

{
  blink ? (
    <svg viewBox={viewBox} aria-hidden="true" class:list={['mark-blink shrink-0 select-none', className]}>
      {paths.map((p, i) => <g class={cls(i)} set:html={p} />)}
    </svg>
  ) : (
    <img src={src.src} alt="" aria-hidden="true" width={src.width} height={src.height} class:list={['shrink-0 select-none', tone === 'faint' && 'opacity-[0.12]', className]} />
  )
}

<style>
  @media all {
    .mark-smile { animation: mark-blink 4s ease-in-out infinite; }
    .mark-plus { animation: mark-blink 4s ease-in-out 2s infinite; transform-box: fill-box; transform-origin: center; }
  }
  /* 잠깐 사라졌다가 다시 또렷하게 나타난다 */
  @keyframes mark-blink {
    0%, 55%, 100% { opacity: 1; transform: scale(1); }
    70%, 80% { opacity: 0; transform: scale(0.85); }
  }
  .mark-smile { transform-box: fill-box; transform-origin: center; }
</style>
