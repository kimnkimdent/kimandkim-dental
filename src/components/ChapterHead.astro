---
// 한 페이지 안의 큰 묶음(예: 청장년 클리닉의 임플란트 / 자연치아·심미보철 / 사랑니·구강외과)이 시작되는 자리 표지.
// 진한 남색 띠 위에 큰 번호 · 묶음 이름 · 한 줄 소개, 오른쪽엔 전체 묶음 목록(지금 묶음 강조)을 둬서 어디까지 왔는지 보이게 한다.
// photo: 배경 사진(진한 남색을 덮어 글이 잘 읽히게). position: 사진에서 보일 위치.
// id를 여기에 걸어 상단 메뉴·탭(#implant 등)이 이 표지로 이동한다.
import Container from './Container.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../site';
interface Props { id: string; index: number; title: string; lead?: string; items: { href: string; label: string }[]; photo?: ImageMetadata; position?: string }
const { id, index, title, lead, items, photo, position = '50% 40%' } = Astro.props;
const no = (n: number) => String(n).padStart(2, '0');
---

<section id={id} class="relative isolate flex min-h-[31.4rem] scroll-mt-20 items-center overflow-hidden bg-secondary text-white md:block md:min-h-0" aria-labelledby={`${id}-title`}>
  {photo && <Image src={photo} alt="" aria-hidden="true" widths={[800, 1600]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" style={`object-position:${position}`} />}
  {photo && <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-r from-secondary/90 via-secondary/75 to-secondary/45"></div>}
  <Container class="grid w-full gap-6 py-10 md:gap-8 md:grid-cols-[1fr_auto] md:items-end md:py-24">
    <div class="flex items-end gap-5 md:gap-8">
      <span aria-hidden="true" class="ch-no text-[6.4rem] leading-[0.8] font-extrabold tracking-tight text-primary-bright tabular-nums md:text-[10rem]">{no(index)}</span>
      <div class="ch-copy">
        <p class="t-body font-semibold tracking-[0.2em] text-white/60">{no(index)} / {no(items.length)}</p>
        <h2 id={`${id}-title`} class="mt-1 text-[2.8rem] leading-tight font-bold md:text-[4rem]">{title}</h2>
        {lead && <p class="mt-2 t-mid text-white/80">{lead}</p>}
      </div>
    </div>
    <ol class="flex flex-wrap gap-2 md:flex-col md:items-end md:gap-1.5">
      {items.map((x, i) => (
        <li>
          <a href={url(x.href)} aria-current={i + 1 === index ? 'true' : undefined} class:list={['inline-flex min-h-11 items-center gap-2 rounded-full px-4 t-body font-semibold transition-colors md:min-h-9', i + 1 === index ? 'bg-primary-bright text-secondary' : 'text-white/60 hover:text-white']}>
            <span class="tabular-nums">{no(i + 1)}</span>{x.label}
          </a>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  /* 스크롤 움직임: 띠지가 화면에 들어오면 큰 숫자는 왼쪽에서 커지며 들어오고, 제목 묶음은 조금 늦게 아래에서 올라온다.
     띠지마다 새 단락이 시작된다는 느낌을 준다. 지원하지 않는 브라우저에서는 움직임 없이 그대로 보인다. */
  @supports (animation-timeline: view()) {
    .ch-no {
      animation: ch-no-in cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-timeline: view();
      animation-range: entry 0% cover 60%;
    }
    .ch-copy {
      animation: ch-copy-in cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-timeline: view();
      animation-range: entry 10% cover 65%;
    }
  }
  @keyframes ch-no-in {
    from { opacity: 0; transform: translateX(-10rem) scale(0.3); }
  }
  @keyframes ch-copy-in {
    from { opacity: 0; transform: translateY(6.4rem); }
  }
</style>
