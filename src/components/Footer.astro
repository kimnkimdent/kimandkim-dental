---
// 바닥글. 내용은 src/site.ts에서 바꾼다. 아래 여백은 휴대폰 하단 고정 버튼에 가리지 않기 위한 것.
import { SITE, tel } from '../site';
const { representative, businessNumber } = SITE.legal;
---

<footer class="bg-secondary pb-[calc(6rem+env(safe-area-inset-bottom))] text-secondary-foreground lg:pb-0">
  <div class="mx-auto max-w-site px-gutter py-12">
    <p class="t-mid font-extrabold">{SITE.fullName}</p>
    <p class="mt-4 t-body leading-relaxed opacity-75">
      {SITE.fullName} <span class="px-1.5 opacity-50">|</span> 대표자 {representative}
      {businessNumber && <><span class="px-1.5 opacity-50">|</span> 사업자등록번호 {businessNumber}</>}
      <br />
      {SITE.contact.address} <span class="px-1.5 opacity-50">|</span> 대표전화 <a href={tel} class="hover:underline">{SITE.contact.phone}</a>
    </p>
    <!-- TODO(확인 필요): 이용약관 · 개인정보처리방침 · 비급여 진료비 안내 페이지 내용을 받으면 링크 연결 -->
    <p class="mt-6 t-body opacity-60">Copyright © {SITE.fullName}. All rights reserved.</p>
  </div>
</footer>
