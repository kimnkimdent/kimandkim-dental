---
// 손가락으로 숫자 세기 픽토그램(1·2·3). 둥근 만화풍 손: 편 손가락 + 접은 손가락 마디 + 앞으로 접은 엄지.
// 굵은 테두리 = primary(진한 남색), 손 바탕 = primary-surface(연한 하늘색). 장식용(숫자는 화면읽기용으로 따로 둔다).
interface Props { n: 1 | 2 | 3; class?: string }
const { n, class: className = 'size-14' } = Astro.props;
const D = 'var(--primary)';
const L = 'var(--primary-surface)';
const SW = 3.4; // 테두리 두께
// 검지·중지·약지 위치(x 시작)
const fingers = [13, 22.5, 32];
---

<svg aria-hidden="true" viewBox="5 1 52 62" class={className} fill="none" stroke-linecap="round" stroke-linejoin="round" overflow="visible">
  {/* 편 손가락 */}
  {fingers.slice(0, n).map((x) => <rect x={x} y="4" width="9" height="34" rx="4.5" fill={L} stroke={D} stroke-width={SW} />)}
  {/* 접은 손가락 마디 */}
  {fingers.slice(n).map((x, i) => <rect x={x} y={20 + i * 1.5} width="9.5" height="18" rx="4.75" fill={L} stroke={D} stroke-width={SW} />)}
  {/* 새끼손가락(접음) */}
  <rect x="41.5" y="25" width="9" height="15" rx="4.5" fill={L} stroke={D} stroke-width={SW} />
  {/* 손바닥 */}
  <path d="M10 37c0-3.3 2.7-6 6-6h29c3.3 0 6 2.7 6 6v6c0 9.4-7.6 17-17 17h-6C17.4 60 10 52.6 10 43.5z" fill={L} stroke={D} stroke-width={SW} />
  {/* 엄지: 손바닥 앞을 비스듬히 가로질러 접힘 */}
  <rect x="7.5" y="35" width="25" height="10.5" rx="5.25" transform="rotate(-28 20 40)" fill={L} stroke={D} stroke-width={SW} />
</svg>
