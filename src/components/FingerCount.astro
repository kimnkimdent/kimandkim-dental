---
// 손가락으로 숫자 세기 픽토그램(1·2·3). 진한색 = primary, 연한색 = primary-surface. 장식용(숫자는 화면읽기용으로 따로 둔다).
interface Props { n: 1 | 2 | 3; class?: string }
const { n, class: className = 'size-14' } = Astro.props;
const D = 'var(--primary)';
const L = 'var(--primary-surface)';
// 손바닥(주먹 부분) + 펼친 손가락. 손가락 x 위치: 검지 16, 중지 22, 약지 28
const up = [16, 22, 28].slice(0, n);
const down = [16, 22, 28].slice(n);
---

<svg aria-hidden="true" viewBox="4 2 34 44" class={className} fill="none" stroke-linecap="round" stroke-linejoin="round">
  {/* 펼친 손가락 */}
  {up.map((x) => <rect x={x - 2.8} y="5" width="5.6" height="20" rx="2.8" fill={L} stroke={D} stroke-width="2.4" />)}
  {/* 접은 손가락(손바닥 위 둥근 마디) */}
  {down.map((x) => <rect x={x - 2.8} y="17" width="5.6" height="9" rx="2.8" fill={L} stroke={D} stroke-width="2.4" />)}
  {/* 새끼손가락(접음) */}
  <rect x="31.4" y="19" width="5" height="8" rx="2.5" fill={L} stroke={D} stroke-width="2.4" />
  {/* 손바닥 */}
  <path d="M12 24h24v7c0 7-5 12-12 12h-1c-6 0-11-4.5-11-10.5z" fill={L} stroke={D} stroke-width="2.4" />
  {/* 엄지(손바닥 앞으로 접음) */}
  <path d="M7.5 25.5c-1.6-1.6-1.4-4.2.5-5.4 1.6-1 3.6-.6 4.8.9L19 28" fill={L} stroke={D} stroke-width="2.4" />
</svg>
