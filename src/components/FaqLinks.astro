---
// 진료 페이지 하단 "자주 묻는 질문": 최근에 올린 질문부터 5개(limit)를 카드로 보여 준다.
// 카드마다 질문(Q)과 답변 첫 부분(A)을 미리 보여 주고, 누르면 궁금해요 Q&A 페이지의 해당 답변으로 이동한다.
// 첫 카드는 크게(PC에서 왼쪽 두 줄 차지), 나머지는 작은 카드. 아래에 전체 보기 버튼.
// group 하나 또는 groups 여러 개(여러 개면 각 분류의 최근 질문을 번갈아 섞는다). '최근' = src/data/qna.json에서 분류 안 뒤쪽에 있는 질문.
import { url } from '../site';
import { groupOf } from '../qna';
interface Props { group?: string; groups?: string[]; limit?: number }
const ids = Astro.props.groups ?? [Astro.props.group!];
const limit = Astro.props.limit ?? 5;
const lists = ids.map((id) => [...groupOf(id).items].reverse());
const all = Array.from({ length: Math.max(...lists.map((l) => l.length)) }).flatMap((_, k) => lists.map((l) => l[k]).filter(Boolean));
const items = all.slice(0, limit);
const plain = (s: string) => s.replace(/[*_#>`]/g, '').replace(/\s+/g, ' ').trim();
const [first, ...rest] = items;
---

<div class="grid gap-4 lg:grid-cols-3">
  {
    first && (
      <a href={url(`/qna/#${first.id}`)} class="group relative flex flex-col overflow-hidden rounded-3xl bg-primary p-8 text-primary-foreground shadow-sm transition-transform hover:-translate-y-1 md:p-10 lg:row-span-2">
        <span aria-hidden="true" class="pointer-events-none absolute -right-4 -bottom-10 text-[18rem] leading-none font-extrabold opacity-10">Q</span>
        <span class="inline-flex w-fit items-center rounded-full bg-primary-foreground/15 px-4 py-1.5 text-14 md:text-13 font-semibold">자주 묻는 질문</span>
        <p class="mt-6 t-head font-bold leading-snug">
          <span aria-hidden="true" class="mr-1">Q.</span>
          {first.q}
        </p>
        <p class="mt-5 line-clamp-4 t-body leading-relaxed opacity-85">
          <span class="font-bold">A. </span>
          {plain(first.a)}
        </p>
        <span class="mt-auto inline-flex items-center gap-2 pt-8 t-body font-semibold">
          답변 전체 보기 <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </span>
      </a>
    )
  }
  {
    rest.map((it) => (
      <a href={url(`/qna/#${it.id}`)} class="group flex flex-col rounded-3xl border border-border bg-background px-4 py-5 transition-all hover:-translate-y-1 hover:border-primary hover:shadow-md md:p-7">
        <p class="flex gap-2.5 text-[1.8rem] font-bold leading-snug md:gap-3 md:t-mid">
          <span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-surface t-body font-extrabold text-primary">Q</span>
          <span class="pt-0.5">{it.q}</span>
        </p>
        <p class="mt-3 line-clamp-2 pl-[4.2rem] text-[1.6rem] leading-relaxed text-foreground-muted md:pl-11 md:t-body">{plain(it.a)}</p>
        <span class="mt-auto inline-flex items-center gap-1.5 pt-4 pl-[4.2rem] t-body md:pl-11 font-semibold text-primary">
          답변 보기 <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </span>
      </a>
    ))
  }
</div>
<div class="mt-8 text-center">
  <a href={url(`/qna/#${ids[0]}`)} class="inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-7 t-body font-semibold text-primary-foreground hover:opacity-90">
    궁금해요 Q&amp;A 전체 보기 →
  </a>
</div>
