---
// 진료 페이지 하단 "자주 묻는 질문": 최근에 올린 질문부터 5개(limit)만 보이고, 아래 버튼으로 궁금해요 Q&A 전체로 이어진다.
// 질문을 누르면 궁금해요 Q&A 페이지의 해당 답변으로 이동한다.
// group 하나 또는 groups 여러 개(여러 개면 각 분류의 최근 질문을 번갈아 섞는다). '최근' = src/data/qna.json에서 분류 안 뒤쪽에 있는 질문.
import { url, br } from '../site';
import { groupOf } from '../qna';
interface Props { group?: string; groups?: string[]; limit?: number }
const ids = Astro.props.groups ?? [Astro.props.group!];
const limit = Astro.props.limit ?? 5;
const lists = ids.map((id) => [...groupOf(id).items].reverse());
const all = Array.from({ length: Math.max(...lists.map((l) => l.length)) }).flatMap((_, k) => lists.map((l) => l[k]).filter(Boolean));
const items = all.slice(0, limit);
---

<ul class="divide-y divide-border overflow-hidden rounded-3xl border border-border bg-background">
  {
    items.map((it, i) => (
      <li>
        <a href={url(`/qna/#${it.id}`)} class="group flex min-h-16 items-center gap-4 px-6 py-4 transition-colors hover:bg-surface md:px-8">
          <span class="t-body font-bold text-primary">{String(i + 1).padStart(2, '0')}</span>
          <span class="flex-1 t-mid font-semibold whitespace-pre-line">{br(it.q)}</span>
          <span aria-hidden="true" class="t-mid text-foreground-subtle transition-transform group-hover:translate-x-1">→</span>
        </a>
      </li>
    ))
  }
</ul>
<p class="mt-6 text-center">
  <a href={url(`/qna/#${ids[0]}`)} class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border-accent px-6 t-body font-semibold text-primary hover:border-primary">
    궁금해요 Q&amp;A 더 보기 →
  </a>
</p>
