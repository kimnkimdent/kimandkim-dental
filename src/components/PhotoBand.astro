---
// 페이지 중간에 들어가는 가로 꽉 찬 사진 띠. 사진을 어둡게 눌러 깔고 그 위에 짧은 문구를 올린다.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from './Container.astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  eyebrow?: string;
  text: string; // 큰 문구(줄바꿈 \n 가능)
  sub?: string;
  position?: string; // 사진 초점 위치. 예: '50% 30%'
}
const { src, alt, eyebrow, text, sub, position = '50% 50%' } = Astro.props;
---

<section class="relative isolate flex min-h-[32rem] items-center overflow-hidden bg-secondary py-20 text-white md:min-h-[44rem]">
  <Image src={src} alt={alt} widths={[800, 1600, 2000]} sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover" style={`object-position: ${position}`} />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[hsl(214_45%_10%/0.6)]"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-primary opacity-35 mix-blend-multiply"></div>
  <Container class="text-center">
    {eyebrow && <p class="t-mid font-semibold text-primary-bright">{eyebrow}</p>}
    <p class="mx-auto mt-3 max-w-[80rem] t-headline font-bold whitespace-pre-line">{text}</p>
    {sub && <p class="mx-auto mt-4 max-w-prose t-mid opacity-85">{sub}</p>}
  </Container>
</section>
