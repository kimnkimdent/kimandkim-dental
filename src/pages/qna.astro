---
// 궁금해요 Q&A: 분류 탭(앵커) + 전체 질문과 답(펼쳐 보이게. 검색·AI가 그대로 읽는다). 질문 추가는 src/qna.ts.
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { SITE, tel, br } from '../site';
import { qna, allQna, qnaUpdated, qnaAuthor } from '../qna';
import { faqSchema } from '../seo';

// 진료 안내 서브 타이틀 → 그 주제를 다루는 질문(qna.ts의 id)
const target: Record<string, string> = {
  '/silver/#denture': 'silver-5', '/silver/#insurance': 'silver-1', '/silver/#safe': 'silver-3', '/silver/#care': 'natural-4',
  '/adult/#implant': 'implant', '/adult/#natural': 'natural', '/adult/#wisdom': 'wisdom',
  '/kids/#first': 'kids-1', '/kids/#checkup': 'kids-2', '/kids/#care': 'kids-3', '/kids/#teen': 'kids-3',
};
const rows = [['/silver/', '#silver'], ['/adult/', '#implant'], ['/kids/', '#kids']].map(([page, href]) => {
  const n = SITE.nav.find((x) => x.href === page)!;
  return { label: n.label, href, items: n.children!.map((c) => ({ label: c.label, href: '#' + target[c.href] })) };
});
// 분류마다 브랜드 색 안에서 진남색 → 하늘색으로 차례로 밝아진다(로고 남색 #0a659c · 하늘색 #1cb4e0 사이). 흰 글자가 읽히는 진하기까지만.
// 분류 → 진료 안내 클리닉 캐릭터(실버·청장년·어린이)
const face: Record<string, 'silver' | 'adult' | 'kids'> = { silver: 'silver', implant: 'adult', natural: 'adult', wisdom: 'adult', kids: 'kids' };
const tone: Record<string, string> = {
  silver: '--primary: hsl(208, 85%, 20%); --primary-surface: hsl(208, 60%, 95%);',
  implant: '--primary: hsl(205, 88%, 27%); --primary-surface: hsl(205, 65%, 95%);',
  natural: '--primary: hsl(203, 88%, 33%); --primary-surface: hsl(202, 70%, 94.5%);',
  wisdom: '--primary: hsl(198, 85%, 36%); --primary-surface: hsl(197, 75%, 94%);',
  kids: '--primary: hsl(194, 82%, 39%); --primary-surface: hsl(193, 80%, 93.5%);',
};
---

<Layout
  title="궁금해요 Q&A"
  description="파주 운정 김앤김치과 진료실에서 가장 많이 받은 질문과 답. 보험 임플란트·틀니, 임플란트, 신경 치료, 사랑니, 어린이 치아까지."
  crumbs={[{ name: '궁금해요 Q&A', path: '/qna/' }]}
  schema={[faqSchema(Astro.site!, allQna, qnaUpdated)]}
  keywords={["파주 치과 질문", "운정 치과 Q&A", "야당동 치과", "치과 질문", "임플란트 비용", "보험 틀니", "사랑니 발치 후 주의사항", "아이 첫 치과"]}
>
  <PageHero icon="qna"
    crumbs={['궁금해요 Q&A']}
    eyebrow="궁금해요 Q&A"
    title="환자분들이 물어보신 질문에 답합니다"
    lead="파주 운정 김앤김치과 진료실에서 가장 많이 받은 질문을 모았습니다. 내가 환자라면 궁금했을 질문부터 정직하게 답하겠습니다."
  >
    <!-- 분류 탭: 전체 + 진료 안내 3개 클리닉별 서브 타이틀(src/site.ts 메뉴와 같은 이름). 누르면 그 주제의 첫 질문으로 이동 -->
    <nav aria-label="질문 분류" class="mt-8 space-y-4">
      <a href="#all" class="inline-flex min-h-11 items-center rounded-full border border-primary bg-primary px-5 t-body font-semibold text-primary-foreground">전체 {allQna.length}</a>
      {rows.map((r) => (
        <div class="flex flex-wrap items-center gap-2">
          <a href={r.href} class="mr-2 inline-flex min-h-11 w-full items-center t-body font-bold text-secondary hover:text-primary sm:w-40">{r.label}</a>
          {r.items.map((c) => (
            <a href={c.href} class="inline-flex min-h-11 items-center rounded-full border border-border-accent bg-background px-5 t-body font-semibold text-foreground-muted hover:border-primary hover:text-primary">{c.label}</a>
          ))}
        </div>
      ))}
    </nav>
  </PageHero>

  <div id="all" class="bg-background pb-section">
    <Container>
      {
        qna.map((g, gi) => {
          const [first, ...rest] = g.items;
          return (
          <section id={g.id} class="qna-group scroll-mt-28 pt-16 md:pt-20" style={tone[g.id] ?? ''}>
            <div class="flex items-center gap-4">
              <span aria-hidden="true" class="t-display leading-none font-extrabold text-primary/15">{String(gi + 1).padStart(2, '0')}</span>
              <ServiceIcon name={face[g.id] ?? 'adult'} class="size-16 md:size-20" />
              <div>
                <p class="inline-flex rounded-full bg-primary-surface px-4 py-1.5 text-14 md:text-13 font-semibold text-primary">{g.tab}</p>
                <h2 class="mt-2 t-headline font-extrabold">“{g.title}”</h2>
              </div>
            </div>
            <ul class="mt-8 grid gap-4 md:grid-cols-2">
              {first && (
                <li id={first.id} class="qna-item relative scroll-mt-28 overflow-hidden rounded-3xl bg-primary p-8 text-primary-foreground shadow-sm md:col-span-2 md:p-10">
                  <span aria-hidden="true" class="pointer-events-none absolute -right-4 -bottom-12 text-[18rem] leading-none font-extrabold opacity-10">Q</span>
                  <span class="relative inline-flex w-fit items-center rounded-full bg-primary-foreground/15 px-4 py-1.5 text-14 md:text-13 font-semibold">자주 묻는 질문</span>
                  <h3 class="relative mt-5 t-head font-bold leading-snug whitespace-pre-line"><span aria-hidden="true">Q. </span>{br(first.q)}</h3>
                  <p class="relative mt-4 t-mid leading-relaxed whitespace-pre-line opacity-90"><span class="font-bold">A. </span>{br(first.a)}</p>
                </li>
              )}
              {rest.map((it) => (
                <li id={it.id} class="qna-item scroll-mt-28 rounded-3xl border border-border bg-background px-4 py-5 transition-colors hover:border-primary md:p-7">
                  <h3 class="flex gap-2.5 text-[1.8rem] font-bold leading-snug whitespace-pre-line md:gap-3 md:t-mid">
                    <span aria-hidden="true" class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary-surface t-body font-extrabold text-primary">Q</span>
                    <span class="pt-0.5">{br(it.q)}</span>
                  </h3>
                  <p class="mt-3 pl-[4.2rem] text-[1.6rem] leading-relaxed whitespace-pre-line text-foreground-muted md:pl-11 md:t-body"><span class="font-bold text-primary">A. </span>{br(it.a)}</p>
                </li>
              ))}
            </ul>
          </section>
          );
        })
      }

      <div class="mt-12 rounded-3xl bg-primary-surface p-8 text-center md:p-12">
        <h2 class="t-head font-bold">찾으시는 답이 없나요?</h2>
        <p class="mt-3 t-mid text-foreground-muted">파주 운정 김앤김치과에 전화 {SITE.contact.phone} 또는 네이버 예약으로 편하게 물어보세요.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <Button href={SITE.contact.booking} variant="naver">네이버 예약</Button>
          <Button href={tel} variant="secondary">전화 상담</Button>
        </div>
      </div>
    </Container>
  </div>
</Layout>

<style>
  /* 진료 페이지에서 질문을 눌러 들어오면 그 질문을 강조한다 */
  .qna-item:target {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-surface);
  }
</style>
