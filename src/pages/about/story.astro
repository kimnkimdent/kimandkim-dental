---
// 김앤김 이야기: 2012 → 2026, 한 줄기 곡선을 따라 내려가며 사진·글이 이어지는 연대기.
// 스크롤하면 곡선이 아래로 그려지고 각 장면이 떠오른다(자바스크립트 없이 CSS만. 지원 안 하는 브라우저·"동작 줄이기"에서는 처음부터 다 보임).
// 장면을 추가하려면 chapters 배열에 { mark, year, title, text, photos, side }를 넣는다. 원고에 없는 연도·사실은 넣지 않는다.
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Container from '../../components/Container.astro';
import Photo from '../../components/Photo.astro';
import Mark from '../../components/Mark.astro';
import FamilyTeeth from '../../components/FamilyTeeth.astro';
import { SITE } from '../../site';
import { Image } from 'astro:assets';
import Section from '../../components/Section.astro';
import doctor from '../../assets/photos/doctor-profile.jpg';
import { DOCTOR } from '../../seo'; // 약력·진료 분야는 src/seo.ts의 DOCTOR에서 고친다
import kidCheckup from '../../assets/photos/kid-checkup.jpg';
import chairTalk from '../../assets/photos/chair-talk.jpg';
import deskSmile from '../../assets/photos/desk-lean.jpg';
import kidFriendly from "../../assets/photos/kid-friendly.jpg";
import modelExplain from '../../assets/photos/model-explain.jpg';
import exterior from '../../assets/photos/exterior.jpg';

// 지금 연도: 사이트를 올릴(반영할) 때의 연도로 자동으로 바뀐다(2027년에 다시 올리면 2027).
const { career, fields } = DOCTOR;
const NOW = Math.max(2026, new Date().getFullYear());
const years = NOW - SITE.since; // 14

const chapters = [
  {
    mark: String(SITE.since),
    year: SITE.since,
    title: '운정 야당동의\n작은 약속',
    text: '우리 동네 가족들이 믿고 다닐 수 있는 치과. 2012년, 파주 운정 야당동에서 그 약속으로 문을 열었습니다.',
    photos: [{ src: exterior, alt: '김앤김치과가 있는 대홍프라자 건물 외관' }],
  },
  {
    mark: '처음엔 혼자',
    teeth: 1 as const, // 표지 안 치아 수 = 가족 수(혼자 → 가족 → 세 세대)
    title: '처음엔\n혼자 오셨습니다',
    text: '치과 문을 열기까지 망설이셨던 분이 상담을 받고, 치료를 마치고, 다음 검진 날짜를 잡고 가셨습니다.',
    photos: [{ src: chairTalk, alt: '진료 의자에 앉은 여성 환자와 이야기하는 대표원장' }],
  },
  {
    mark: '가족과 함께',
    teeth: 2 as const,
    title: '다음엔\n가족과 함께',
    text: '처음 혼자 오셨던 분이 어느새 배우자분과, 자녀분과, 부모님까지 모시고 오십니다.',
    photos: [
      { src: modelExplain, alt: '치아 모형으로 여성 환자에게 설명하는 대표원장' },
      { src: kidFriendly, alt: '아이와 눈을 맞추며 설명하는 대표원장' },
    ],
  },
  {
    mark: '세 세대',
    teeth: 3 as const,
    title: '할머니의 틀니,\n손주의 첫 불소',
    text: '할머니가 틀니를 맞추시던 날, 손주는 첫 불소를 바르고 갑니다. 그 믿음이 쌓여 지금의 김앤김치과가 되었습니다.',
    photos: [{ src: kidCheckup, alt: '아이 첫 검진을 하는 대표원장' }],
  },
  {
    mark: String(NOW),
    year: NOW,
    title: '지금도,\n같은 자리에서',
    text: '공감은 따뜻하게, 진단은 정확하게. 모두가 환하게 웃으며 인사하는 동네 치과로 함께하겠습니다.',
    photos: [{ src: deskSmile, alt: '접수 데스크에 팔을 올리고 데스크 안쪽을 보며 웃는 대표원장 김정민' }],
    now: true,
  },
];

---

<Layout
  title="김앤김 이야기"
  description="2012년 파주 운정 야당동에서 시작해 지금도 같은 자리에서 한 가족의 시간을 함께하는 김앤김치과 이야기와 대표원장 김정민 소개(경희대 치과대학, AAID·ICOI·AACD 정회원)."
  keywords={["김앤김치과 소개", "운정 야당동 치과", "2012년 개원", "김정민 원장"]}
  crumbs={[{ name: '병원소개', path: '/about/story/' }, { name: '김앤김 이야기', path: '/about/story/' }]}
>
  <PageHero
    crumbs={['병원소개', '김앤김 이야기']}
    eyebrow="김앤김 이야기"
    title={'2012년, 운정 야당동의\n작은 약속에서 시작했습니다'}
    lead="우리 동네 가족들이 믿고 다닐 수 있는 치과. 그 약속을 지키며 한자리에서 가족의 시간을 함께해 왔습니다." />

  <!-- 숫자로 보는 14년 -->
  <section class="bg-background pt-6 pb-4 md:pt-10">
    <Container>
      <!-- 2012에서 지금(올해)까지 숫자가 돌아 올라가고, 그 뒤로 다음 해들이 흐릿하게 이어지며 '계속'을 보여 준다 -->
      <div class="grid items-center gap-y-3 text-center md:grid-cols-[1fr_auto_1fr] md:gap-x-8">
        <p class="t-mid font-semibold text-foreground-muted md:text-right">
          <span class="font-serif text-[2.4rem] font-bold text-primary-bright md:text-[3.2rem]">{SITE.since}</span>년부터
        </p>
        <p class="relative">
          <span class="sr-only">{NOW}</span>
          <span aria-hidden="true" class="year-roll font-serif text-[8.8rem] leading-none font-bold text-primary md:text-[15rem]" style={`--from: ${SITE.since}; --to: ${NOW}`}></span>
        </p>
        <div aria-hidden="true" class="future relative h-[4.8rem] overflow-hidden md:h-[6rem]">
          <div class="future-track flex h-full w-max items-center gap-6 font-serif text-[3.2rem] font-bold text-primary md:gap-8 md:text-[4rem]">
            {[1, 2, 3, 4, 5, 6, 1, 2, 3, 4, 5, 6].map((k) => <span style={`opacity: ${Math.max(0.12, 0.5 - ((k - 1) % 6) * 0.08)}`}>{NOW + k}</span>)}
          </div>
        </div>
      </div>
      <p class="mt-6 text-center t-mid">
        같은 자리에서 <strong class="story-count text-[3.2rem] leading-none font-extrabold text-primary md:text-[4.4rem]" style={`--to: ${years}`}><span class="sr-only">{years}</span></strong><strong class="text-primary">년</strong>,
        <strong class="inline-flex items-center gap-2 text-primary">그리고 계속됩니다 <span aria-hidden="true" class="pulse-dot inline-block size-3 rounded-full bg-primary-bright"></span></strong>
      </p>
    </Container>
  </section>

  <!-- 곡선을 따라 내려가는 연대기 -->
  <section class="story bg-background pt-10 pb-section" aria-label={`${SITE.since}년부터 ${NOW}년까지`}>
    <Container>
      <ol class="relative">
        {
          chapters.map((c, i) => {
            const right = i % 2 === 1; // 사진이 오른쪽에 오는 장면
            const bend = right ? 30 : 70; // 곡선이 휘는 방향(글 쪽으로)
            const last = i === chapters.length - 1;
            return (
              <li class="story-row relative grid grid-cols-[3.6rem_1fr] gap-x-5 pb-16 md:grid-cols-[1fr_12rem_1fr] md:gap-x-0 md:pb-28">
                {/* 곡선 조각: 이 장면의 맨 위 가운데에서 시작해 한쪽으로 휘었다가 다음 장면 맨 위 가운데로 이어진다 */}
                {!last && (
                  <svg aria-hidden="true" class="pointer-events-none absolute inset-0 -z-0 hidden h-full w-full md:block" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <path d={`M50 0 C ${bend} 25, ${bend} 75, 50 100`} fill="none" stroke="var(--color-primary-bright)" stroke-opacity="0.35" stroke-width="4" vector-effect="non-scaling-stroke" stroke-linecap="round" />
                  </svg>
                )}
                {/* 휴대폰: 왼쪽 세로 줄 */}
                {!last && <span aria-hidden="true" class="absolute top-0 bottom-0 left-[1.7rem] w-1 rounded-full bg-primary-bright/35 md:hidden"></span>}

                {/* 표지(곡선 위 동그라미) */}
                <div class="relative z-10 row-span-2 md:col-start-2 md:row-span-1 md:row-start-1 md:flex md:justify-center">
                  <span class:list={[
                    'story-dot flex items-center justify-center rounded-full border-4 border-background font-bold shadow-md',
                    c.year ? 'size-14 bg-primary text-[1.3rem] text-primary-foreground md:size-24 md:text-[2rem]' : 'size-14 bg-primary-surface text-[1.1rem] text-primary md:size-24 md:text-[1.4rem]',
                  ]}>
                    {c.now ? <Mark tone="white" class="h-8 w-auto md:h-12" /> : c.teeth ? (
                      <span role="img" aria-label={c.mark} class="flex items-center justify-center"><FamilyTeeth count={c.teeth} class="size-[3.4rem] md:size-[6rem]" /></span>
                    ) : <span class="px-1 text-center leading-tight">{c.mark}</span>}
                  </span>
                </div>

                {/* 사진 */}
                <div class:list={['story-in relative z-10 md:row-start-1', right ? 'md:col-start-3 md:pl-10' : 'md:col-start-1 md:pr-10', 'col-start-2 mt-0']}>
                  {c.photos.length === 1 ? (
                    <Photo src={c.photos[0].src} alt={c.photos[0].alt} class="shadow-lg [&_img]:rounded-3xl" />
                  ) : (
                    <div class="grid grid-cols-2 gap-3">
                      {c.photos.map((p, k) => <Photo src={p.src} alt={p.alt} ratio="aspect-[3/4]" class:list={['shadow-lg [&_img]:object-[70%_50%]', k === 1 && 'mt-10']} />)}
                    </div>
                  )}
                </div>

                {/* 글 */}
                <div class:list={['story-in relative z-10 col-start-2 mt-6 md:row-start-1 md:mt-0 md:self-center', right ? 'md:col-start-1 md:pr-10 md:text-right' : 'md:col-start-3 md:pl-10']}>
                  {c.now ? (
                    <p class="font-serif text-[4.8rem] leading-none font-bold tracking-[0.08em] text-primary md:text-[7.6rem]">NOW</p>
                  ) : c.year ? (
                    <p class:list={['font-serif text-[4rem] leading-none font-bold md:text-[6.4rem]', c.now ? 'text-primary' : 'text-primary-bright']}>
                      {c.year}
                    </p>
                  ) : (
                    <p class="t-body font-bold tracking-widest text-primary">{c.mark}</p>
                  )}
                  <h2 class="mt-3 t-headline font-bold whitespace-pre-line">{c.title}</h2>
                  <p class:list={['mt-4 max-w-[44rem] t-mid leading-relaxed text-foreground-muted', right && 'md:ml-auto']}>{c.text}</p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </Container>
  </section>

  <!-- 대표원장 소개(같은 페이지 아래). 메뉴의 '대표원장 소개'가 여기(#doctor)로 온다 -->
  <Section id="doctor" tone="surface" eyebrow="대표원장 소개" title="상담부터 치료 후 점검까지, 직접 봅니다">
    <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
      <div class="overflow-hidden rounded-3xl bg-primary-surface">
        <Image src={doctor} alt="김앤김치과 대표원장 김정민" widths={[400, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full" />
      </div>
      <div>
        <h2 class="t-headline font-bold">안녕하세요,<br />김앤김치과 대표원장 김정민입니다.</h2>
        <div class="mt-6 space-y-3 t-mid leading-relaxed text-foreground-muted">
          <p>첫 상담과 진단, 수술, 치료 후 경과 확인까지 제가 직접 진료합니다.</p>
          <p>오래 믿고 다니실 수 있는 치과가 되도록, 한 분 한 분 끝까지 책임지겠습니다.</p>
        </div>

        <h3 class="mt-12 t-head font-bold">약력 · 학회</h3>
        <ul class="mt-4 space-y-2.5">
          {career.map((c) => <li class="flex items-center gap-3 t-mid"><Mark class="h-6 w-auto" />{c}</li>)}
        </ul>

        <h3 class="mt-12 t-head font-bold">주요 진료 분야</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {fields.map((f) => <li class="rounded-full bg-primary-surface px-5 py-2 t-body font-semibold text-primary">{f}</li>)}
        </ul>
      </div>
    </div>
  </Section>
</Layout>

<style>
  /* 14년: 화면에 들어오면 0 → 14로 올라간다 */
  @property --n {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }
  .story-count {
    --n: var(--to);
    counter-reset: n var(--n);
    font-variant-numeric: tabular-nums;
  }
  .story-count::before {
    content: counter(n);
  }
  /* 연도 숫자: 2012 → 올해까지 돌아 올라간다 */
  @property --y {
    syntax: '<integer>';
    inherits: false;
    initial-value: 2012;
  }
  .year-roll {
    --y: var(--to);
    counter-reset: y var(--y);
    font-variant-numeric: tabular-nums;
  }
  .year-roll::before {
    content: counter(y);
  }
  /* 다음 해들: 오른쪽으로 갈수록 흐려지게 */
  .future {
    mask-image: linear-gradient(to right, black 0%, black 35%, transparent 100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes count {
      from { --n: 0; }
    }
    @keyframes draw {
      from { stroke-dashoffset: 1; }
      to { stroke-dashoffset: 0; }
    }
    @keyframes grow {
      from { transform: scaleY(0); }
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(4rem); }
    }
    @keyframes pop {
      from { transform: scale(0.4); }
    }
    .story-count {
      animation: count 2.6s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    @keyframes roll {
      from { --y: var(--from); }
    }
    @keyframes drift {
      to { transform: translateX(-50%); }
    }
    @keyframes future-in {
      from { opacity: 0; transform: translateX(-3rem); }
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.8); opacity: 0.35; }
    }
    /* 페이지가 열리면 2.6초 동안 2012 → 올해. 이어서 다음 해들이 나타나 천천히 흘러가고(끝없이), 점이 깜빡인다 */
    .year-roll {
      animation: roll 2.6s 0.3s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .future {
      animation: future-in 0.8s 2.7s ease-out both;
    }
    .future-track {
      animation: drift 24s 2.9s linear infinite;
    }
    .pulse-dot {
      animation: pulse 1.8s 2.9s ease-in-out infinite;
    }
    @supports (animation-timeline: view()) {
      .story-dot {
        animation: pop ease-out both;
        animation-timeline: view();
        animation-range: entry 10% entry 70%;
      }
      .story-in {
        animation: rise ease-out both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }
</style>
