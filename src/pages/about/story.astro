---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Photo from '../../components/Photo.astro';
import SubTabs from '../../components/SubTabs.astro';
import { SITE } from '../../site';
import deskWide from '../../assets/photos/desk-wide.jpg';
import kidCheckup from '../../assets/photos/kid-checkup.jpg';
import consultWoman from '../../assets/photos/consult-woman.jpg';
import consultMan from '../../assets/photos/consult-man.jpg';
import consultRoom from '../../assets/photos/consult-room.jpg';
import doctorTeam from '../../assets/photos/doctor-team.jpg';
import treatmentRoom from '../../assets/photos/treatment-room.jpg';
import surgeryRoom from '../../assets/photos/surgery-room.jpg';
import xrayRoom from '../../assets/photos/xray-room.jpg';
import exterior from '../../assets/photos/exterior.jpg';

const tabs = SITE.nav[0].children!;
const family = [
  { alt: '아이 첫 검진', src: kidCheckup },
  { alt: '엄마 상담', src: consultWoman },
  { alt: '아버지 임플란트 상담', src: consultMan },
  { alt: '상담실', src: consultRoom },
];
const tour = [
  { alt: '건물 외관 (대홍프라자 5층)', src: exterior },
  { alt: '접수 데스크', src: deskWide },
  { alt: '진료실', src: treatmentRoom },
  { alt: '수술실', src: surgeryRoom },
  { alt: '상담실', src: consultRoom },
  { alt: '엑스레이·CT 촬영실', src: xrayRoom },
];
---

<Layout
  title="김앤김 이야기"
  description="2012년 파주 운정 야당동에서 시작한 김앤김치과. 우리 동네 가족들이 믿고 다닐 수 있는 치과라는 약속을 지켜 왔습니다."
  keywords={["김앤김치과 소개", "운정 야당동 치과"]}
  crumbs={[{ name: '병원소개', path: '/about/story/' }, { name: '김앤김 이야기', path: '/about/story/' }]}
>
  <PageHero
    crumbs={['병원소개', '김앤김 이야기']}
    eyebrow="김앤김 이야기"
    title={'2012년, 운정 야당동의\n작은 약속에서 시작했습니다'}
    lead="우리 동네 가족들이 믿고 다닐 수 있는 치과. 그 약속을 지키며 한자리에서 가족의 시간을 함께해 왔습니다."
  >
    <SubTabs items={tabs} current="/about/story/" />
  </PageHero>

  <div class="bg-background">
    <div class="mx-auto max-w-site px-gutter">
      <Photo src={deskWide} alt="김앤김치과 접수 데스크" ratio="aspect-[21/9]" />
    </div>
  </div>

  <Section eyebrow="처음엔 혼자, 다음엔 가족과" title="한 가족의 시간이 쌓여 지금의 김앤김치과가 되었습니다">
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
      {family.map((f) => <li><Photo src={f.src} alt={f.alt} ratio="aspect-square" /></li>)}
    </ul>
    <p class="mt-10 max-w-prose t-mid leading-relaxed text-foreground-muted">
      처음 혼자 오셨던 분이 어느새 배우자분과, 자녀분과, 부모님까지 모시고 오십니다. 할머니가 틀니를 맞추시던 날, 손주는 첫 불소를 바르고 갑니다. 그 믿음이 쌓여 지금의 김앤김치과가 되었습니다.
    </p>
  </Section>

  <Section tone="surface" eyebrow="Smile & Trust" title={'공감은 따뜻하게,\n진단은 정확하게'}>
    <div class="grid items-center gap-10 md:grid-cols-2">
      <Photo src={doctorTeam} alt="접수 데스크 앞에서 웃고 있는 대표원장 김정민" />
      <p class="t-mid leading-relaxed text-foreground-muted">모두가 환하게 웃으며 인사하는 동네 치과로 함께하겠습니다.</p>
    </div>
  </Section>

  <Section eyebrow="병원 둘러보기" title="편안하게 머무실 수 있도록">
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      {tour.map((t) => <li><Photo src={t.src} alt={t.alt} caption={t.alt} /></li>)}
    </ul>
  </Section>
</Layout>
