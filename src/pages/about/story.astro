---
// 김앤김 이야기: 2012 → 2026, 한 줄기 곡선을 따라 내려가며 사진·글이 이어지는 연대기.
// 스크롤하면 곡선이 아래로 그려지고 각 장면이 떠오른다(자바스크립트 없이 CSS만. 지원 안 하는 브라우저·"동작 줄이기"에서는 처음부터 다 보임).
// 장면을 추가하려면 chapters 배열에 { mark, year, title, text, photos, side }를 넣는다. 원고에 없는 연도·사실은 넣지 않는다.
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Container from '../../components/Container.astro';
import Photo from '../../components/Photo.astro';
import SubTabs from '../../components/SubTabs.astro';
import Mark from '../../components/Mark.astro';
import { SITE } from '../../site';
import deskWide from '../../assets/photos/desk-wide.jpg';
import kidCheckup from '../../assets/photos/kid-checkup.jpg';
import consultMan from '../../assets/photos/consult-man.jpg';
import consultRoom from '../../assets/photos/consult-room.jpg';
import doctorTeam from '../../assets/photos/doctor-team.jpg';
import kidFriendly from "../../assets/photos/kid-friendly.jpg";
import modelExplain from '../../assets/photos/model-explain.jpg';
import treatmentRoom from '../../assets/photos/treatment-room.jpg';
import surgeryRoom from '../../assets/photos/surgery-room.jpg';
import xrayRoom from '../../assets/photos/xray-room.jpg';
import exterior from '../../assets/photos/exterior.jpg';

const tabs = SITE.nav[0].children!;
const NOW = 2026;
const years = NOW - SITE.since; // 14

const chapters = [
  {
    mark: String(SITE.since),
    year: SITE.since,
    title: '운정 야당동의\n작은 약속',
    text: '우리 동네 가족들이 믿고 다닐 수 있는 치과. 2012년, 파주 운정 야당동에서 그 약속으로 문을 열었습니다.',
    photos: [{ src: exterior, alt: '김앤김치과가 있는 대홍프라자 건물 외관' }],
  },
  {
    mark: '처음엔 혼자',
    title: '처음엔\n혼자 오셨습니다',
    text: '치과 문을 열기까지 망설이셨던 분이 상담을 받고, 치료를 마치고, 다음 검진 날짜를 잡고 가셨습니다.',
    photos: [{ src: consultMan, alt: '대표원장과 상담하는 남성' }],
  },
  {
    mark: '가족과 함께',
    title: '다음엔\n가족과 함께',
    text: '처음 혼자 오셨던 분이 어느새 배우자분과, 자녀분과, 부모님까지 모시고 오십니다.',
    photos: [
      { src: modelExplain, alt: '치아 모형으로 여성 환자에게 설명하는 대표원장' },
      { src: kidFriendly, alt: '아이와 눈을 맞추며 설명하는 대표원장' },
    ],
  },
  {
    mark: '세 세대',
    title: '할머니의 틀니,\n손주의 첫 불소',
    text: '할머니가 틀니를 맞추시던 날, 손주는 첫 불소를 바르고 갑니다. 그 믿음이 쌓여 지금의 김앤김치과가 되었습니다.',
    photos: [{ src: kidCheckup, alt: '아이 첫 검진을 하는 대표원장' }],
  },
  {
    mark: String(NOW),
    year: NOW,
    title: `${years}년,\n같은 자리에서`,
    text: '공감은 따뜻하게, 진단은 정확하게. 모두가 환하게 웃으며 인사하는 동네 치과로 함께하겠습니다.',
    photos: [{ src: doctorTeam, alt: '접수 데스크 앞에서 웃고 있는 대표원장 김정민' }],
    now: true,
  },
];

const tour = [
  { alt: '접수 데스크', src: deskWide },
  { alt: '진료실', src: treatmentRoom },
  { alt: '수술실', src: surgeryRoom },
  { alt: '상담실', src: consultRoom },
  { alt: '엑스레이·CT 촬영실', src: xrayRoom },
  { alt: '건물 외관 (대홍프라자 5층)', src: exterior },
];
---

<Layout
  title="김앤김 이야기"
  description="2012년 파주 운정 야당동에서 시작해 2026년 지금까지 14년, 같은 자리에서 한 가족의 시간을 함께해 온 김앤김치과 이야기."
  keywords={["김앤김치과 소개", "운정 야당동 치과", "2012년 개원"]}
  crumbs={[{ name: '병원소개', path: '/about/story/' }, { name: '김앤김 이야기', path: '/about/story/' }]}
>
  <PageHero
    crumbs={['병원소개', '김앤김 이야기']}
    eyebrow="김앤김 이야기"
    title={'2012년, 운정 야당동의\n작은 약속에서 시작했습니다'}
    lead="우리 동네 가족들이 믿고 다닐 수 있는 치과. 그 약속을 지키며 한자리에서 가족의 시간을 함께해 왔습니다."
  >
    <SubTabs items={tabs} current="/about/story/" />
  </PageHero>

  <!-- 숫자로 보는 14년 -->
  <section class="bg-background pt-6 pb-4 md:pt-10">
    <Container>
      <div class="flex flex-wrap items-end justify-center gap-x-6 gap-y-2 text-center md:gap-x-12">
        <p><span class="block t-body font-semibold text-foreground-muted">시작</span><span class="font-serif text-[4.4rem] leading-none font-bold text-primary-bright md:text-[8rem]">{SITE.since}</span></p>
        <p class="pb-3 t-head text-foreground-subtle md:pb-6" aria-hidden="true">→</p>
        <p><span class="block t-body font-semibold text-foreground-muted">지금</span><span class="font-serif text-[4.4rem] leading-none font-bold text-primary md:text-[8rem]">{NOW}</span></p>
        <p class="w-full pt-4 t-mid md:w-auto md:pt-0 md:pb-6">
          같은 자리에서 <strong class="story-count text-[3.6rem] leading-none font-extrabold text-primary md:text-[5.6rem]" style={`--to: ${years}`}><span class="sr-only">{years}</span></strong><strong class="text-primary">년</strong>
        </p>
      </div>
    </Container>
  </section>

  <!-- 곡선을 따라 내려가는 연대기 -->
  <section class="story bg-background pt-10 pb-section" aria-label={`${SITE.since}년부터 ${NOW}년까지`}>
    <Container>
      <ol class="relative">
        {
          chapters.map((c, i) => {
            const right = i % 2 === 1; // 사진이 오른쪽에 오는 장면
            const bend = right ? 30 : 70; // 곡선이 휘는 방향(글 쪽으로)
            const last = i === chapters.length - 1;
            return (
              <li class="story-row relative grid grid-cols-[3.6rem_1fr] gap-x-5 pb-16 md:grid-cols-[1fr_12rem_1fr] md:gap-x-0 md:pb-28">
                {/* 곡선 조각: 이 장면의 맨 위 가운데에서 시작해 한쪽으로 휘었다가 다음 장면 맨 위 가운데로 이어진다 */}
                {!last && (
                  <svg aria-hidden="true" class="pointer-events-none absolute inset-0 -z-0 hidden h-full w-full md:block" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <path d={`M50 0 C ${bend} 25, ${bend} 75, 50 100`} fill="none" stroke="var(--color-surface-accent)" stroke-width="6" vector-effect="non-scaling-stroke" stroke-linecap="round" />
                    <path class="story-path" d={`M50 0 C ${bend} 25, ${bend} 75, 50 100`} pathLength="1" fill="none" stroke="var(--color-primary-bright)" stroke-width="6" vector-effect="non-scaling-stroke" stroke-linecap="round" />
                  </svg>
                )}
                {/* 휴대폰: 왼쪽 세로 줄 */}
                {!last && <span aria-hidden="true" class="absolute top-0 bottom-0 left-[1.7rem] w-1 rounded-full bg-surface-accent md:hidden"><span class="story-line block h-full w-full rounded-full bg-primary-bright"></span></span>}

                {/* 표지(곡선 위 동그라미) */}
                <div class="relative z-10 row-span-2 md:col-start-2 md:row-span-1 md:row-start-1 md:flex md:justify-center">
                  <span class:list={[
                    'story-dot flex items-center justify-center rounded-full border-4 border-background font-bold shadow-md',
                    c.year ? 'size-14 bg-primary text-[1.3rem] text-primary-foreground md:size-24 md:text-[2rem]' : 'size-14 bg-primary-surface text-[1.1rem] text-primary md:size-24 md:text-[1.4rem]',
                  ]}>
                    {c.now ? <Mark tone="white" class="h-8 w-auto md:h-12" /> : <span class="px-1 text-center leading-tight">{c.mark}</span>}
                  </span>
                </div>

                {/* 사진 */}
                <div class:list={['story-in relative z-10 md:row-start-1', right ? 'md:col-start-3 md:pl-10' : 'md:col-start-1 md:pr-10', 'col-start-2 mt-0']}>
                  {c.photos.length === 1 ? (
                    <Photo src={c.photos[0].src} alt={c.photos[0].alt} class="shadow-lg [&_img]:rounded-3xl" />
                  ) : (
                    <div class="grid grid-cols-2 gap-3">
                      {c.photos.map((p, k) => <Photo src={p.src} alt={p.alt} ratio="aspect-[3/4]" class:list={['shadow-lg [&_img]:object-[70%_50%]', k === 1 && 'mt-10']} />)}
                    </div>
                  )}
                </div>

                {/* 글 */}
                <div class:list={['story-in relative z-10 col-start-2 mt-6 md:row-start-1 md:mt-0 md:self-center', right ? 'md:col-start-1 md:pr-10 md:text-right' : 'md:col-start-3 md:pl-10']}>
                  {c.year ? (
                    <p class:list={['font-serif text-[4rem] leading-none font-bold md:text-[6.4rem]', c.now ? 'text-primary' : 'text-primary-bright']}>
                      {c.year}{c.now && <span class="ml-2 align-middle font-sans text-[1.4rem] font-bold tracking-widest text-primary md:text-[1.6rem]">NOW</span>}
                    </p>
                  ) : (
                    <p class="t-body font-bold tracking-widest text-primary">{c.mark}</p>
                  )}
                  <h2 class="mt-3 t-headline font-bold whitespace-pre-line">{c.title}</h2>
                  <p class:list={['mt-4 max-w-[44rem] t-mid leading-relaxed text-foreground-muted', right && 'md:ml-auto']}>{c.text}</p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </Container>
  </section>

  <Section tone="surface" eyebrow="병원 둘러보기" title="편안하게 머무실 수 있도록">
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
      {tour.map((t) => <li><Photo src={t.src} alt={t.alt} caption={t.alt} /></li>)}
    </ul>
  </Section>
</Layout>

<style>
  /* 14년: 화면에 들어오면 0 → 14로 올라간다 */
  @property --n {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }
  .story-count {
    --n: var(--to);
    counter-reset: n var(--n);
    font-variant-numeric: tabular-nums;
  }
  .story-count::before {
    content: counter(n);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes count {
      from { --n: 0; }
    }
    @keyframes draw {
      from { stroke-dashoffset: 1; }
      to { stroke-dashoffset: 0; }
    }
    @keyframes grow {
      from { transform: scaleY(0); }
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(4rem); }
    }
    @keyframes pop {
      from { transform: scale(0.4); }
    }
    .story-count {
      animation: count 1.6s ease-out both;
    }
    @supports (animation-timeline: view()) {
      .story-count {
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
      /* 곡선: 그 장면이 화면을 지나가는 동안 위에서 아래로 그려진다 */
      .story-row {
        view-timeline-name: --row;
      }
      .story-path {
        stroke-dasharray: 1;
        animation: draw linear both;
        animation-timeline: --row;
        animation-range: cover 25% cover 75%;
      }
      .story-line {
        transform-origin: top;
        animation: grow linear both;
        animation-timeline: --row;
        animation-range: cover 20% cover 70%;
      }
      .story-dot {
        animation: pop ease-out both;
        animation-timeline: view();
        animation-range: entry 10% entry 70%;
      }
      .story-in {
        animation: rise ease-out both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }
</style>
