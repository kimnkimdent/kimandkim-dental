---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import SubTabs from '../../components/SubTabs.astro';
import { Image } from 'astro:assets';
import doctor from '../../assets/doctor-kim.jpg';
import { SITE } from '../../site';

const tabs = SITE.nav[0].children!;
const career = [
  '경희대학교 치과대학 졸업',
  '전) 복음병원 치과 과장',
  'GAO Implant course 수료',
  'AAID 미국 임플란트 학회 정회원',
  'ICOI 세계 구강 임플란트 학회 정회원',
  'AACD 미국 심미치과학회 정회원',
];
const fields = ['임플란트', '구강외과', '보존·보철', '실버·어린이 진료'];
---

<Layout
  title="대표원장 소개"
  description="김앤김치과 대표원장 김정민. 경희대학교 치과대학 졸업. 첫 상담과 진단, 수술, 치료 후 경과 확인까지 직접 진료합니다."
  crumbs={[{ name: '병원소개', path: '/about/story/' }, { name: '대표원장 소개', path: '/about/doctor/' }]}
>
  <PageHero crumbs={['병원소개', '대표원장 소개']} eyebrow="대표원장 김정민" title="상담부터 치료 후 점검까지, 직접 봅니다">
    <SubTabs items={tabs} current="/about/doctor/" />
  </PageHero>

  <Section>
    <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
      <div class="overflow-hidden rounded-3xl bg-primary-surface">
        <Image src={doctor} alt="김앤김치과 대표원장 김정민" widths={[400, 800]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full" />
      </div>
      <div>
        <h2 class="t-headline font-bold">안녕하세요,<br />김앤김치과 대표원장 김정민입니다.</h2>
        <div class="mt-6 space-y-3 t-mid leading-relaxed text-foreground-muted">
          <p>첫 상담과 진단, 수술, 치료 후 경과 확인까지 제가 직접 진료합니다.</p>
          <p>오래 믿고 다니실 수 있는 치과가 되도록, 한 분 한 분 끝까지 책임지겠습니다.</p>
        </div>

        <h3 class="mt-12 t-head font-bold">약력 · 학회</h3>
        <ul class="mt-4 space-y-2.5">
          {career.map((c) => <li class="flex gap-3 t-mid"><span class="mt-[0.9rem] size-1.5 shrink-0 rounded-full bg-primary"></span>{c}</li>)}
        </ul>

        <h3 class="mt-12 t-head font-bold">주요 진료 분야</h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {fields.map((f) => <li class="rounded-full bg-primary-surface px-5 py-2 t-body font-semibold text-primary">{f}</li>)}
        </ul>
      </div>
    </div>
  </Section>
</Layout>
