---
// HOME: 첫 화면 → 병원 요약(AI 인용용) → 메뉴 바로가기 카드 6개 → 최근 Q&A 3개
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Mark from '../components/Mark.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { SITE, url, tel, br } from '../site';
import { allQna, qna } from '../qna';
import { Image } from 'astro:assets';
import phSilver from '../assets/photos/doctor-warm.jpg';
import phAdult from '../assets/photos/band-surgery.jpg';
import phKids from '../assets/photos/kid-checkup.jpg';

// 진료 안내: 클리닉 3개를 번호 붙은 큰 블록으로(위: 색 띠 제목 / 아래: 글 + 사진 카드). 서브 타이틀은 src/site.ts 메뉴에서 가져온다.
const sub = (h: string) => SITE.nav.find((n) => n.href === h)!.children!;
const clinics = [
  { href: '/silver/', clinic: 'silver', en: 'Silver Clinic', title: '실버 클리닉', quote: '“내 부모님이라면”', lead: '드시는 약부터 먼저 살피고, 틀니 하나도 편안해지실 때까지 맞춰 드립니다.', head: '부모님의 식사 시간을 편안하게', photo: phSilver, alt: '어르신 환자를 따뜻하게 맞이하는 대표원장', pos: '50% 30%' },
  { href: '/adult/', clinic: 'adult', en: 'Adult Clinic', title: '청장년 클리닉', quote: '“내가 이 비용을 낸다면”', lead: '살릴 방법부터 먼저 말씀드리고, 꼭 필요한 치료만 기간과 비용까지 미리 안내합니다.', head: '꼭 필요한 치료부터 정직하게', photo: phAdult, alt: '직원과 함께 진료하는 대표원장', pos: '50% 35%' },
  { href: '/kids/', clinic: 'kids', en: 'Kids Clinic', title: '어린이·청소년 클리닉', quote: '“내 아이라면”', lead: '무엇을 할지 먼저 말하고, 보여 주고, 아이가 준비될 때까지 기다립니다.', head: '다음에 또 와도 괜찮은 치과', photo: phKids, alt: '아이의 치아를 검진하는 모습', pos: '50% 40%' },
] as const;

const cards = [
  { href: '/about/story/', icon: 'about' as const, title: '병원소개', quote: '처음엔 혼자,\n다음엔 가족과 함께', desc: '김앤김 이야기\n대표원장 소개' },
  { href: '/philosophy/', icon: 'philosophy' as const, title: '진료철학', quote: '“내가 환자라면,\n내 가족이라면”', desc: '3가지 질문과\n진료실 4가지 원칙' },
  { href: '/silver/', clinic: 'silver' as const, icon: 'silver' as const, title: '실버 클리닉', quote: '“내 부모님이라면”', desc: '보험 임플란트·틀니\n만성질환 안전 진료' },
  { href: '/adult/', clinic: 'adult' as const, icon: 'adult' as const, title: '청장년 클리닉', quote: '“내가 이 비용을 낸다면”', desc: '임플란트 · 자연치아·심미보철\n사랑니·구강외과' },
  { href: '/kids/', clinic: 'kids' as const, icon: 'kids' as const, title: '어린이·청소년 클리닉', quote: '“내 아이라면”', desc: '영유아 검진 · 충치 예방\n청소년 관리' },
  { href: '/qna/', icon: 'qna' as const, title: '궁금해요 Q&A', quote: '환자분들이 물어보신 질문에 답합니다', desc: '진료 과목별\n자주 묻는 질문과 답' },
];

const etc = cards.filter((c) => !('clinic' in c));

// 최근 질문 3개: 가장 나중에 추가된 질문부터
const recent = allQna.slice(-3).reverse();
const tabOf = (id: string) => qna.find((g) => g.items.some((i) => i.id === id))!.tab;
---

<Layout keywords={["파주 치과", "운정 치과", "야당동 치과", "운정신도시 치과"]}>
  <!-- 첫 화면: 진료 장면 영상 배경(소리 없음·자동 반복). 영상 파일: public/video/ (0.8배속+중간 프레임 보간 23초, PC 1920px 약 4.4MB, 휴대폰 세로 약 1MB)
       "동작 줄이기" 설정이면 영상 대신 첫 장면 사진만 보인다. -->
  <section style={`--poster: url(${url("/video/hero-poster.jpg")})`} class="hero-video relative isolate flex min-h-[calc(100svh-7.6rem)] items-center overflow-hidden bg-secondary lg:min-h-[calc(100svh-10.4rem)]">
    <video
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={url('/video/hero-poster.jpg')}
      aria-hidden="true"
    >
      <source src={url('/video/hero-mobile.mp4')} type="video/mp4" media="(max-width: 767px)" />
      <source src={url('/video/hero-desktop.mp4')} type="video/mp4" />
    </video>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,hsl(216_62%_11%/0.65)_0%,hsl(216_62%_11%/0.45)_60%,hsl(216_62%_11%/0.6)_100%)]"></div>

    <Container class="py-16 text-white">
      <div class="mx-auto flex flex-col items-center text-center">
        <Mark tone="white" class="mb-6 h-[7.2rem] w-auto md:h-[10rem]" />
        <p class="t-mid font-semibold text-primary-bright">{SITE.slogan}</p>
        <h1 class="mt-3 text-[clamp(2.2rem,6.4vw,5.2rem)] leading-tight font-bold whitespace-nowrap drop-shadow-sm">한 가족의 시간을 함께해 온 치과</h1>
        <p class="mt-5 t-mid opacity-90 lg:whitespace-nowrap">
          아이의 첫 이부터 부모님의 틀니까지, {SITE.since}년부터 파주 운정 가족의 치아 건강을 돌봐왔습니다.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <!-- 휴대폰: 버튼을 약 30% 작게, 전화번호는 '전화 상담' 아래 작게 -->
          <Button href={SITE.contact.booking} variant="naver" size="lg" class="max-md:min-h-11 max-md:min-w-[13rem] max-md:px-6 max-md:py-2 max-md:text-[1.4rem]">네이버 예약</Button>
          <Button href={tel} variant="white" size="lg" class="max-md:min-h-11 max-md:min-w-[13rem] max-md:flex-col max-md:gap-0 max-md:px-6 max-md:py-1.5 max-md:text-[1.4rem] max-md:leading-tight">
            전화 상담
            <span class="font-semibold max-md:text-[1.15rem] max-md:opacity-75">{SITE.contact.phone}</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- 병원 요약 문장은 화면에 보이지 않고 검색·AI용 정보(src/site.ts의 summary → 구조화데이터·llms.txt)에만 들어간다 -->

  <Section eyebrow="진료 안내" title="우리 가족 누구나, 필요한 진료를 한곳에서">
    <div class="space-y-12 md:space-y-16">
      {
        clinics.map((c, i) => (
          <article data-clinic={c.clinic} class="overflow-hidden rounded-3xl shadow-sm">
            <!-- 색 띠: 번호 · 클리닉 이름 · 한 줄 소개 -->
            <header class="bg-primary px-6 py-8 text-white md:px-12 md:py-10">
              <p class="t-body font-semibold tracking-[0.2em] text-primary-bright">KIM&amp;KIM CLINIC {String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 text-[2.6rem] font-bold md:text-[3.6rem]"><a href={url(c.href)} class="hover:underline">{c.title}</a> <span class="ml-1 font-serif text-[1.8rem] font-semibold opacity-80 md:text-[2.2rem]">{c.quote}</span></h3>
              <p class="mt-3 t-mid leading-relaxed opacity-85">{c.lead}</p>
            </header>
            <!-- 카드: 왼쪽 글(서브 타이틀 체크 목록) · 오른쪽 사진 -->
            <div class:list={['grid bg-background md:grid-cols-2', i % 2 && 'md:[&>figure]:order-first']}>
              <div class="flex flex-col justify-center p-6 md:p-12">
                <p class="t-body font-semibold text-primary italic">{c.en}</p>
                <p class="mt-1 t-headline font-bold">{c.head}</p>
                <ul class="mt-6 space-y-1">
                  {sub(c.href).map((x) => (
                    <li><a href={url(x.href)} class="group flex min-h-11 items-center gap-3 border-b border-border py-2 t-mid hover:text-primary"><span aria-hidden="true" class="font-bold text-primary">✓</span>{x.label}<span aria-hidden="true" class="ml-auto text-foreground-subtle transition-transform group-hover:translate-x-1 group-hover:text-primary">→</span></a></li>
                  ))}
                </ul>
                <a href={url(c.href)} class="mt-8 inline-flex min-h-11 items-center self-start rounded-full bg-primary px-6 t-body font-semibold text-primary-foreground hover:opacity-90">{c.title} 자세히 보기 →</a>
              </div>
              <figure class="relative min-h-[24rem] md:min-h-[42rem]">
                <Image src={c.photo} alt={c.alt} widths={[640, 1000]} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" style={`object-position:${c.pos}`} />
              </figure>
            </div>
          </article>
        ))
      }
    </div>

    <!-- 그 밖의 안내: 병원소개 · 진료철학 · 궁금해요 Q&A -->
    <ul class="mt-12 grid gap-3 md:mt-16 md:grid-cols-3 md:gap-4">
      {
        etc.map((c) => (
          <li class="group relative flex items-center gap-4 rounded-2xl border border-border bg-background p-5 transition-shadow hover:shadow-lg md:p-6">
            <ServiceIcon name={c.icon} class="size-12 shrink-0" />
            <div>
              <h3 class="t-head font-bold"><a href={url(c.href)} class="after:absolute after:inset-0 after:content-['']">{c.title}</a></h3>
              <p class="mt-1 t-body text-foreground-muted">{c.desc.split(/\s*\n\s*/).join(' · ')}</p>
            </div>
            <span aria-hidden="true" class="ml-auto text-[2rem] text-foreground-subtle transition-transform group-hover:translate-x-1 group-hover:text-primary">→</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="surface" eyebrow="궁금해요 Q&A" title="최근 질문">
    <ul class="grid gap-4 lg:grid-cols-3">
      {
        recent.map((it) => (
          <li>
            <a href={url(`/qna/#${it.id}`)} class="flex h-full flex-col rounded-3xl bg-background p-7 shadow-sm transition-shadow hover:shadow-lg">
              <span class="self-start rounded-full bg-primary-surface px-3 py-1 t-body font-semibold text-primary">{tabOf(it.id)}</span>
              <p class="mt-4 t-mid font-bold whitespace-pre-line">Q. {br(it.q)}</p>
              <p class="mt-3 line-clamp-3 t-body text-foreground-muted whitespace-pre-line">{br(it.a)}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 text-center">
      <Button href={url('/qna/')} variant="secondary">전체 질문 보기</Button>
    </div>
  </Section>
</Layout>
