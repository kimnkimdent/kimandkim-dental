---
// HOME: 첫 화면 → 병원 요약(AI 인용용) → 메뉴 바로가기 카드 6개 → 최근 Q&A 3개
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Mark from '../components/Mark.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { SITE, url, tel, br } from '../site';
import { allQna, qna } from '../qna';
import StoryBody from '../components/home/StoryBody.astro';
import PhilosophyBody from '../components/home/PhilosophyBody.astro';

const cards = [
  { href: '/about/story/', icon: 'about' as const, title: '병원소개', quote: '처음엔 혼자,\n다음엔 가족과 함께', desc: '김앤김 이야기\n대표원장 소개' },
  { href: '/philosophy/', icon: 'philosophy' as const, title: '진료철학', quote: '“내가 환자라면,\n내 가족이라면”', desc: '3가지 질문과\n진료실 4가지 원칙' },
  { href: '/silver/', clinic: 'silver' as const, icon: 'silver' as const, title: '실버 클리닉', quote: '“내 부모님이라면”', desc: '보험 임플란트·틀니\n만성질환 안전 진료' },
  { href: '/adult/', clinic: 'adult' as const, icon: 'adult' as const, title: '청장년 클리닉', quote: '“내가 이 비용을 낸다면”', desc: '임플란트 · 자연치아·심미보철\n사랑니·구강외과' },
  { href: '/kids/', clinic: 'kids' as const, icon: 'kids' as const, title: '어린이·청소년 클리닉', quote: '“내 아이라면”', desc: '영유아 검진 · 충치 예방\n청소년 치아 관리' },
  { href: '/qna/', icon: 'qna' as const, title: '궁금해요 Q&A', quote: '환자분들이 물어보신 질문에 답합니다', desc: '진료 과목별\n자주 묻는 질문과 답' },
];

// 최근 질문 3개: 가장 나중에 추가된 질문부터
const recent = allQna.slice(-3).reverse();
const tabOf = (id: string) => qna.find((g) => g.items.some((i) => i.id === id))!.tab;
---

<Layout keywords={["파주 치과", "운정 치과", "야당동 치과", "운정신도시 치과"]}>
  <!-- 첫 화면: 진료 장면 영상 배경(소리 없음·자동 반복). 영상 파일: public/video/ (0.7배속+중간 프레임 보간 25초, PC는 화면 높이에 맞춰 꽉 채움(위아래 조금 잘릴 수 있음), 끝과 처음을 겹쳐 끊김 없이 반복, PC 약 5MB, 휴대폰 약 1.5MB)
       휴대폰 "동작 줄이기" 설정과 관계없이 항상 재생한다(원장님 요청). -->
  <section style={`--poster: url(${url("/video/hero-poster.jpg")})`} class="hero-video relative isolate flex min-h-[calc(100svh-7.6rem)] items-center overflow-hidden bg-secondary lg:min-h-[calc(100svh-10.4rem)]">
    <video
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={url('/video/hero-poster.jpg')}
      aria-hidden="true"
    >
      <source src={url('/video/hero-mobile.mp4')} type="video/mp4" media="(max-width: 767px)" />
      <source src={url('/video/hero-desktop.mp4')} type="video/mp4" />
    </video>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,hsl(216_62%_11%/0.65)_0%,hsl(216_62%_11%/0.45)_60%,hsl(216_62%_11%/0.6)_100%)]"></div>

    <Container class="py-16 text-white">
      <div class="mx-auto flex flex-col items-center text-center">
        <Mark tone="white" blink class="mb-6 h-[7.2rem] w-auto md:h-[10rem]" />
        <p class="t-mid font-semibold text-primary-bright">{SITE.slogan}</p>
        <h1 class="mt-3 text-[clamp(2.2rem,6.4vw,5.2rem)] leading-tight font-bold whitespace-nowrap drop-shadow-sm">한 가족의 시간을 함께해 온 치과</h1>
        <p class="mt-5 t-mid opacity-90 lg:whitespace-nowrap">
          아이의 첫 이부터 부모님의 틀니까지, {SITE.since}년부터 파주 운정 가족의 치아 건강을 돌봐왔습니다.
        </p>
      </div>
    </Container>
  </section>

  <!-- 병원 요약 문장은 화면에 보이지 않고 검색·AI용 정보(src/site.ts의 summary → 구조화데이터·llms.txt)에만 들어간다 -->

  <!-- 영상 아래로 스크롤하면: 병원소개(김앤김 이야기·대표원장 소개) → 진료철학. 각 페이지와 같은 내용(src/components/home/) -->
  <StoryBody home />
  <PhilosophyBody home />
</Layout>
