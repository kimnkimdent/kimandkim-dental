---
// HOME: 첫 화면 → 병원 요약(AI 인용용) → 메뉴 바로가기 카드 6개 → 최근 Q&A 3개
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Mark from '../components/Mark.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { SITE, url, tel, br } from '../site';
import { allQna, qna } from '../qna';

const cards = [
  { href: '/about/story/', icon: 'about' as const, title: '병원소개', quote: '처음엔 혼자,\n다음엔 가족과 함께', subs: [['/about/story/', '김앤김 이야기'], ['/about/story/#doctor', '대표원장 소개']] },
  { href: '/philosophy/', icon: 'philosophy' as const, title: '진료철학', quote: '“내가 환자라면,\n내 가족이라면”', subs: [['/philosophy/', '세 가지 질문과 진료실 4가지 원칙']] },
  { href: '/silver/', clinic: 'silver' as const, icon: 'silver' as const, title: '실버 치아 클리닉', quote: '“내 부모님이라면”', subs: [['/silver/', '보험 임플란트·틀니'], ['/silver/#safe', '만성질환 안전 진료']] },
  { href: '/adult/implant/', clinic: 'adult' as const, icon: 'adult' as const, title: '청장년 클리닉', quote: '“내가 이 비용을 낸다면”', subs: [['/adult/implant/', '임플란트'], ['/adult/natural/', '자연치아·심미보철'], ['/adult/wisdom/', '사랑니·구강외과']] },
  { href: '/kids/', clinic: 'kids' as const, icon: 'kids' as const, title: '어린이·청소년 클리닉', quote: '“내 아이라면”', subs: [['/kids/', '영유아 검진 · 충치 예방 · 청소년 관리']] },
  { href: '/qna/', icon: 'qna' as const, title: '궁금해요 Q&A', quote: '환자분들이 물어보신 질문에 답합니다', subs: [['/qna/', '전체 질문 보기']] },
];

// 최근 질문 3개: 가장 나중에 추가된 질문부터
const recent = allQna.slice(-3).reverse();
const tabOf = (id: string) => qna.find((g) => g.items.some((i) => i.id === id))!.tab;
---

<Layout keywords={["파주 치과", "운정 치과", "야당동 치과", "운정신도시 치과"]}>
  <!-- 첫 화면: 진료 장면 영상 배경(소리 없음·자동 반복). 영상 파일: public/video/ (0.8배속+중간 프레임 보간 23초, PC 1920px 약 4.4MB, 휴대폰 세로 약 1MB)
       "동작 줄이기" 설정이면 영상 대신 첫 장면 사진만 보인다. -->
  <section style={`--poster: url(${url("/video/hero-poster.jpg")})`} class="hero-video relative isolate flex min-h-[calc(100svh-7.6rem)] items-center overflow-hidden bg-secondary lg:min-h-[calc(100svh-10.4rem)]">
    <video
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={url('/video/hero-poster.jpg')}
      aria-hidden="true"
    >
      <source src={url('/video/hero-mobile.mp4')} type="video/mp4" media="(max-width: 767px)" />
      <source src={url('/video/hero-desktop.mp4')} type="video/mp4" />
    </video>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,hsl(214_45%_12%/0.65)_0%,hsl(214_45%_12%/0.45)_60%,hsl(214_45%_12%/0.6)_100%)]"></div>

    <Container class="py-16 text-white">
      <div class="mx-auto flex flex-col items-center text-center">
        <Mark tone="white" class="mb-6 h-[7.2rem] w-auto md:h-[10rem]" />
        <p class="t-mid font-semibold text-primary-bright">{SITE.slogan}</p>
        <h1 class="mt-3 text-[clamp(2.2rem,6.4vw,5.2rem)] leading-tight font-bold whitespace-nowrap drop-shadow-sm">한 가족의 시간을 함께해 온 치과</h1>
        <p class="mt-5 t-mid opacity-90 lg:whitespace-nowrap">
          아이의 첫 이부터 부모님의 틀니까지, {SITE.since}년부터 파주 운정 가족의 치아 건강을 돌봐왔습니다.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <!-- 휴대폰: 버튼을 약 30% 작게, 전화번호는 '전화 상담' 아래 작게 -->
          <Button href={SITE.contact.booking} variant="naver" size="lg" class="max-md:min-h-11 max-md:min-w-[13rem] max-md:px-6 max-md:py-2 max-md:text-[1.4rem]">네이버 예약</Button>
          <Button href={tel} variant="white" size="lg" class="max-md:min-h-11 max-md:min-w-[13rem] max-md:flex-col max-md:gap-0 max-md:px-6 max-md:py-1.5 max-md:text-[1.4rem] max-md:leading-tight">
            전화 상담
            <span class="font-semibold max-md:text-[1.15rem] max-md:opacity-75">{SITE.contact.phone}</span>
          </Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- 병원 요약 문장은 화면에 보이지 않고 검색·AI용 정보(src/site.ts의 summary → 구조화데이터·llms.txt)에만 들어간다 -->

  <Section eyebrow="진료 안내" title="우리 가족 누구나, 필요한 진료를 한곳에서">
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:grid-cols-6 lg:gap-3">
      {
        cards.map((c) => (
          <li class="group relative flex flex-col rounded-2xl border border-border bg-background p-4 transition-shadow hover:shadow-lg md:rounded-3xl md:p-6 lg:p-5">
            <ServiceIcon name={c.icon} class="mb-3 size-10 transition-transform group-hover:-rotate-6 md:size-12" />
            <h3 class="text-[1.6rem] leading-snug font-bold md:text-[2rem] lg:text-[1.7rem]">
              <a href={url(c.href)} class="after:absolute after:inset-0 after:content-['']">{c.title}</a>
            </h3>
            <p class:list={['mt-1.5 text-[1.3rem] leading-snug whitespace-pre-line text-primary md:mt-2 md:text-[1.5rem] lg:text-[1.35rem]', c.quote.startsWith('“') && '-indent-[0.45em] pl-[0.45em]']}>{c.quote}</p>
            <p class="relative z-10 mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-4 max-md:hidden lg:hidden">
              {c.subs.map(([h, l]) => (
                <a href={url(h)} class="text-[1.3rem] text-foreground-muted underline-offset-4 hover:text-primary hover:underline">{l}</a>
              ))}
            </p>
            <span aria-hidden="true" class="absolute top-4 right-4 text-[1.6rem] text-foreground-subtle transition-transform group-hover:translate-x-1 group-hover:text-primary md:top-6 md:right-6 md:text-[2rem] lg:top-5 lg:right-5 lg:text-[1.6rem]">→</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="surface" eyebrow="궁금해요 Q&A" title="최근 질문">
    <ul class="grid gap-4 lg:grid-cols-3">
      {
        recent.map((it) => (
          <li>
            <a href={url(`/qna/#${it.id}`)} class="flex h-full flex-col rounded-3xl bg-background p-7 shadow-sm transition-shadow hover:shadow-lg">
              <span class="self-start rounded-full bg-primary-surface px-3 py-1 t-body font-semibold text-primary">{tabOf(it.id)}</span>
              <p class="mt-4 t-mid font-bold whitespace-pre-line">Q. {br(it.q)}</p>
              <p class="mt-3 line-clamp-3 t-body text-foreground-muted whitespace-pre-line">{br(it.a)}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 text-center">
      <Button href={url('/qna/')} variant="secondary">전체 질문 보기</Button>
    </div>
  </Section>
</Layout>
