---
// HOME: 첫 화면 → 병원 요약(AI 인용용) → 메뉴 바로가기 카드 6개 → 최근 Q&A 3개
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Mark from '../components/Mark.astro';
import { SITE, url, tel } from '../site';
import { allQna, qna } from '../qna';

const cards = [
  { href: '/about/story/', title: '병원소개', quote: '처음엔 혼자, 다음엔 가족과 함께', subs: [['/about/story/', '김앤김 이야기'], ['/about/doctor/', '대표원장 소개']] },
  { href: '/philosophy/', title: '진료철학', quote: '“내가 환자라면, 내 가족이라면”', subs: [['/philosophy/', '세 가지 질문과 진료실 4가지 원칙']] },
  { href: '/silver/', title: '실버 치아 클리닉', quote: '“내 부모님이라면”', subs: [['/silver/', '보험 임플란트·틀니'], ['/silver/#safe', '만성질환 안전 진료']] },
  { href: '/adult/implant/', title: '청장년 클리닉', quote: '“내가 이 비용을 낸다면”', subs: [['/adult/implant/', '임플란트'], ['/adult/natural/', '자연치아·심미보철'], ['/adult/wisdom/', '사랑니·구강외과']] },
  { href: '/kids/', title: '어린이·청소년 클리닉', quote: '“내 아이라면”', subs: [['/kids/', '영유아 검진 · 충치 예방 · 청소년 관리']] },
  { href: '/qna/', title: '궁금해요 Q&A', quote: '환자분들이 물어보신 질문에 답합니다', subs: [['/qna/', '전체 질문 보기']] },
];

// 최근 질문 3개: 가장 나중에 추가된 질문부터
const recent = allQna.slice(-3).reverse();
const tabOf = (id: string) => qna.find((g) => g.items.some((i) => i.id === id))!.tab;
---

<Layout keywords={["파주 치과", "운정 치과", "야당동 치과", "운정신도시 치과"]}>
  <!-- 첫 화면: 진료 장면 영상 배경(소리 없음·자동 반복). 영상 파일: public/video/ (PC 1920px 약 4MB, 휴대폰 세로 약 1MB)
       "동작 줄이기" 설정이면 영상 대신 첫 장면 사진만 보인다. -->
  <section style={`--poster: url(${url("/video/hero-poster.jpg")})`} class="hero-video relative isolate flex min-h-[calc(100svh-7.6rem)] items-center overflow-hidden bg-secondary lg:min-h-[calc(100svh-10.4rem)]">
    <video
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={url('/video/hero-poster.jpg')}
      aria-hidden="true"
    >
      <source src={url('/video/hero-mobile.mp4')} type="video/mp4" media="(max-width: 767px)" />
      <source src={url('/video/hero-desktop.mp4')} type="video/mp4" />
    </video>
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,hsl(214_45%_12%/0.65)_0%,hsl(214_45%_12%/0.45)_60%,hsl(214_45%_12%/0.6)_100%)]"></div>

    <Container class="py-16 text-white">
      <div class="mx-auto flex flex-col items-center text-center">
        <Mark tone="white" class="mb-6 h-[7.2rem] w-auto md:h-[10rem]" />
        <p class="t-mid font-semibold text-primary-bright">{SITE.slogan}</p>
        <h1 class="mt-3 text-[clamp(2.2rem,6.4vw,5.2rem)] leading-tight font-bold whitespace-nowrap drop-shadow-sm">한 가족의 시간을 함께해 온 치과</h1>
        <p class="mt-5 t-mid opacity-90 lg:whitespace-nowrap">
          아이의 첫 이부터 부모님의 틀니까지, {SITE.since}년부터 파주 운정 가족의 치아 건강을 돌봐왔습니다.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href={SITE.contact.booking} variant="naver" size="lg">네이버 예약</Button>
          <Button href={tel} variant="white" size="lg">전화 상담 {SITE.contact.phone}</Button>
        </div>
      </div>
    </Container>
  </section>

  <!-- 병원 요약: 검색·AI가 인용하기 좋은 사실 정보 -->
  <div class="border-y border-border bg-background">
    <Container class="py-6">
      <p data-speakable class="t-body text-foreground-muted">
        김앤김치과는 {SITE.since}년부터 파주 운정신도시 야당동에서 진료해 온 치과입니다. 대표원장 김정민이 임플란트, 틀니, 자연치아 보존, 어린이 진료까지 직접 진료합니다.
      </p>
    </Container>
  </div>

  <Section eyebrow="진료 안내" title="우리 가족 누구나, 필요한 진료를 한곳에서">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        cards.map((c) => (
          <li class="group relative flex flex-col rounded-3xl border border-border bg-background p-7 transition-shadow hover:shadow-lg md:p-8">
            <Mark class="mb-5 h-14 w-auto transition-transform group-hover:-rotate-6" />
            <h3 class="t-head font-bold">
              <a href={url(c.href)} class="after:absolute after:inset-0 after:content-['']">{c.title}</a>
            </h3>
            <p class="mt-3 t-mid text-primary">{c.quote}</p>
            <p class="relative z-10 mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-6">
              {c.subs.map(([h, l]) => (
                <a href={url(h)} class="t-body text-foreground-muted underline-offset-4 hover:text-primary hover:underline">{l}</a>
              ))}
            </p>
            <span aria-hidden="true" class="absolute top-7 right-7 t-head text-foreground-subtle transition-transform group-hover:translate-x-1 group-hover:text-primary md:top-8 md:right-8">→</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="surface" eyebrow="궁금해요 Q&A" title="최근 질문">
    <ul class="grid gap-4 lg:grid-cols-3">
      {
        recent.map((it) => (
          <li>
            <a href={url(`/qna/#${it.id}`)} class="flex h-full flex-col rounded-3xl bg-background p-7 shadow-sm transition-shadow hover:shadow-lg">
              <span class="self-start rounded-full bg-primary-surface px-3 py-1 t-body font-semibold text-primary">{tabOf(it.id)}</span>
              <p class="mt-4 t-mid font-bold">Q. {it.q}</p>
              <p class="mt-3 line-clamp-3 t-body text-foreground-muted">{it.a}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 text-center">
      <Button href={url('/qna/')} variant="secondary">전체 질문 보기</Button>
    </div>
  </Section>
</Layout>
