---
import { SITE, br } from '../site';
import { Image } from 'astro:assets';
import bandRoom from '../assets/photos/treatment-room.jpg';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Note from '../components/Note.astro';
import SubTabs from '../components/SubTabs.astro';
import Process from '../components/Process.astro';
import FaqLinks from '../components/FaqLinks.astro';
import DentalArt from '../components/DentalArt.astro';
import Photo from '../components/Photo.astro';
import doctorWarm from '../assets/photos/doctor-warm.jpg';

const worries = ['빠진 이가 많아 식사가 불편해요', '쓰던 틀니가 헐겁거나 잇몸이 아파요', '당뇨·고혈압 약을 먹고 있어 치료가 걱정돼요', '잇몸이 내려가고, 이가 시리고, 입이 자주 말라요', '딱딱한 음식은 아예 못 씹겠어요', '틀니를 끼면 말할 때 발음이 새요', '잇몸에서 피가 나고 입 냄새가 나요', '혈액순환제(아스피린)를 먹는데 이를 뽑아도 될까요?'];
const dentures = [
  { art: 'full', t: '전체 틀니', d: '치아가 모두 없을 때 잇몸 전체를 덮는 틀니' },
  { art: 'partial', t: '부분 틀니', d: '남은 치아에 고리를 걸어 빈자리를 채우는 틀니' },
  { art: 'implant-denture', t: '임플란트 틀니', d: '아래턱에 임플란트를 보통 2개 심고 똑딱이로 연결해 덜 움직이는 틀니' },
] as const;
---

<Layout
  title="실버 클리닉 · 보험 임플란트 · 보험 틀니"
  description="파주 운정 김앤김치과 실버 클리닉. 만 65세 이상 보험 임플란트·보험 틀니, 당뇨·고혈압 등 만성질환이 있어도 드시는 약부터 확인하는 안전 진료."
  crumbs={[{ name: '실버 클리닉', path: '/silver/' }]}
  treatment
  clinic="silver"
  keywords={["보험 임플란트", "보험 틀니", "실버 치과", "틀니", "당뇨 임플란트"]}
  procedures={["전체 틀니", "부분 틀니", "임플란트 틀니", "보험 임플란트", "보험 틀니", "잇몸 치료", "시린 이 치료(GI 충전)"]}
>
  <PageHero clinic="silver" crumbs={['실버 클리닉']} eyebrow="“내 부모님이라면”" title="부모님엔 편안함을" lead="부모님의 식사 시간을 편안하게 돌봐드립니다.">
    <SubTabs items={SITE.nav.find((n) => n.href === '/silver/')!.children!} current="" />
    <!-- 역지사지 진료 노트: 제목 바로 아래 -->
    <div class="relative mt-10 md:mt-12">
      <Note align="left" quote={'제 부모님이라면 무엇보다|안전하고 덜 힘드셨으면 합니다.\n그래서 드시는 약과 혈압·혈당부터 확인하고,|틀니 하나를 맞춰도|식사 때 불편한 곳이 없는지|몇 번이고 다시 봐 드립니다.\n편안한 한 끼가 부모님의 하루를|바꾼다는 걸 알기 때문입니다.'} />
    </div>
  </PageHero>

  <!-- 배경: 진료실 사진을 어둡게 눌러 깔고, 그 위로 말풍선이 흐른다 -->
  <div class="relative isolate overflow-hidden">
    <Image src={bandRoom} alt="" aria-hidden="true" widths={[800, 1600]} sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-secondary/75"></div>
  <Section class="!bg-transparent text-white" title="이런 고민 있으신가요?" align="center">
    <!-- 부모님이 직접 하시는 말처럼: 말풍선이 높낮이를 달리해 두 줄로 천천히 흘러간다(같은 목록을 두 번 이어 붙여 끊김 없이 반복) -->
    <ul class="sr-only">{worries.map((w) => <li>{w}</li>)}</ul>
    <div aria-hidden="true" class="worry-flow -mx-4 space-y-4 overflow-hidden md:-mx-8">
      {
        [worries.slice(0, 4), worries.slice(4)].map((row, r) => (
          <div class:list={['worry-track flex w-max py-3', r ? 'worry-rev' : '']}>
            {[...row, ...row].map((w, i) => (
              <p class:list={['worry mr-5 shrink-0 rounded-[2.4rem] px-7 py-5 font-serif t-mid font-bold whitespace-nowrap md:px-9 md:py-6 md:text-[2rem]', (i + r) % 2 ? 'rounded-br-md bg-primary-bright text-secondary' : 'rounded-bl-md bg-background text-foreground shadow-sm']} style={`margin-top:${[0, 2.4, 0.8, 3.2][(i + r * 2) % 4]}rem`}>
                “{w}”
              </p>
            ))}
          </div>
        ))
      }
    </div>
  </Section>
  </div>


  <Section id="denture" eyebrow="틀니 클리닉" title="잇몸에 맞춰, 편안하게 씹으실 수 있도록">
    <ul class="grid gap-4 md:grid-cols-3">
      {
        dentures.map((x) => (
          <li class="rounded-3xl border border-border p-5 md:p-6">
            <DentalArt name={x.art} class="h-auto w-full" />
            <h3 class="mt-5 px-2 t-head font-bold text-primary">{x.t}</h3>
            <p class="mt-3 px-2 t-body text-foreground-muted whitespace-pre-line">{br(x.d)}</p>
          </li>
        ))
      }
    </ul>
    <h3 class="mt-12 mb-5 t-head font-bold">틀니 진료 과정</h3>
    <Process items={[{ title: '검진·본뜨기' }, { title: '맞춤 제작' }, { title: '장착' }, { title: '적응·조정' }]} />
    <p class="mt-4 t-body text-foreground-muted">검진·본뜨기 → 맞춤 제작 → 장착 → 적응·조정까지 함께합니다.</p>
    <p class="mt-2 t-body text-foreground-muted">장착 후 조정: 보험 틀니는 3개월 안에 6회까지, 비급여 틀니는 편하게 쓰실 수 있을 때까지 맞춰 드립니다.</p>
  </Section>

  <Section id="insurance" tone="surface" eyebrow="국가보험 임플란트·틀니 (2026년 기준)" title="만 65세 이상이시라면 건강보험이 적용됩니다">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="flex items-center gap-6 rounded-3xl bg-background p-8 shadow-sm">
        <div class="flex-1">
        <h3 class="t-head font-bold">보험 임플란트</h3>
        <p class="mt-2 t-body text-foreground-muted">만 65세 이상</p>
        <p class="mt-5 t-headline font-bold text-primary">평생 2개 · 본인부담 30%</p>
        </div>
        <DentalArt name="implant" class="h-auto w-28 shrink-0 md:w-36" />
      </div>
      <div class="flex items-center gap-6 rounded-3xl bg-background p-8 shadow-sm">
        <div class="flex-1">
        <h3 class="t-head font-bold">보험 틀니</h3>
        <p class="mt-2 t-body text-foreground-muted">만 65세 이상</p>
        <p class="mt-5 t-headline font-bold text-primary">7년마다 1회 · 본인부담 30%</p>
        </div>
        <DentalArt name="full" class="h-auto w-28 shrink-0 md:w-36" />
      </div>
    </div>
    <p class="mt-4 t-body text-foreground-muted">대상 여부는 내원 시 확인해 드립니다.</p>
  </Section>

  <Section id="safe" eyebrow="만성질환 안전 진료" title="드시는 약부터, 먼저 살핍니다">
    <Process
      items={[
        { title: '문진', text: '복용 약 확인' },
        { title: '혈압·혈당 체크' },
        { title: '내과 협진', text: '필요 시' },
        { title: '신중한 시술', text: '꼼꼼한 지혈' },
        { title: '경과 확인', text: '다음 날' },
      ]}
    />
    <p class="mt-6 rounded-2xl bg-primary-surface px-6 py-4 t-mid font-semibold text-primary">진료 오실 때 약 봉투나 처방전을 가져와 주세요.</p>
  </Section>

  <Section id="care" tone="surface" eyebrow="잇몸 · 시린 이 · 구강건조 관리" title="노년기 구강 건강을 꾸준히 지킵니다">
    <p class="max-w-prose t-mid leading-relaxed text-foreground-muted">보험 잇몸 치료와 시린 이 치료(GI 충전), 정기 불소 관리로 노년기 구강 건강을 지킵니다.</p>
  </Section>

  <Section eyebrow="자주 묻는 질문" title="부모님 치아, 이것이 궁금해요">
    <FaqLinks group="silver" />
  </Section>
</Layout>

<style>
  /* 말풍선 흐름: 같은 줄을 두 번 이어 붙였으므로 절반(-50%)만큼 움직이면 처음과 같아진다 */
  .worry-flow { mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .worry-track { align-items: flex-start; animation: worry-flow 60s linear infinite; }
  .worry-rev { animation-direction: reverse; animation-duration: 70s; }
  .worry-flow:hover .worry-track { animation-play-state: paused; }
  @keyframes worry-flow { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .worry-track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; }
  }
</style>
