---
import { SITE, br } from '../site';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Note from '../components/Note.astro';
import SubTabs from '../components/SubTabs.astro';
import ChapterHead from '../components/ChapterHead.astro';
import Process from '../components/Process.astro';
import FaqLinks from '../components/FaqLinks.astro';
import DentalArt from '../components/DentalArt.astro';
import Photo from '../components/Photo.astro';
import dFull from '../assets/denture/full.jpg';
import dPartial from '../assets/denture/partial.jpg';
import dImplant from '../assets/denture/implant.jpg';
import step1 from '../assets/denture/step1.jpg';
import step2 from '../assets/denture/step2.jpg';
import step3 from '../assets/denture/step3.jpg';
import step4 from '../assets/denture/step4.jpg';
import insImplant from '../assets/denture/ins-implant.jpg';
import insDenture from '../assets/denture/ins-denture.jpg';
import WorryBand from '../components/WorryBand.astro';
import tGum from '../assets/treat/treat-08.jpg';
import chRoom from '../assets/photos/treatment-room.jpg';
import chConsult from '../assets/photos/xray-room.jpg';
import chModel from '../assets/photos/surgery.jpg';
import chDesk from '../assets/photos/desk-consult.jpg';
import doctorWarm from '../assets/photos/doctor-warm.jpg';

const worries = ['빠진 이가 많아 식사가 불편해요', '쓰던 틀니가 헐겁거나 잇몸이 아파요', '당뇨·고혈압 약을 먹고 있어 치료가 걱정돼요', '잇몸이 내려가고, 이가 시리고, 입이 자주 말라요', '딱딱한 음식은 아예 못 씹겠어요', '틀니를 끼면 말할 때 발음이 새요', '잇몸에서 피가 나고 입 냄새가 나요', '혈액순환제(아스피린)를 먹는데 이를 뽑아도 될까요?'];
const dentures = [
  { art: 'full', img: dFull, t: '전체 틀니', d: '치아가 하나도 남지 않았을 때 쓰는 틀니예요. 위아래 잇몸 전체를 덮어 붙잡아 다시 씹을 수 있게 해 주고, 입가가 꺼져 보이지 않게 얼굴 모양도 받쳐 줍니다. 만 65세 이상은 보험이 적용됩니다.' },
  { art: 'partial', img: dPartial, t: '부분 틀니', d: '아직 남아 있는 치아가 있을 때 쓰는 틀니예요. 남은 치아에 금속 고리를 걸어 빈자리를 채우기 때문에, 남은 치아를 뽑지 않고 살리면서 씹는 불편을 줄일 수 있어요. 빼서 닦을 수 있어 관리도 어렵지 않습니다.' },
  { art: 'implant-denture', img: dImplant, t: '임플란트 틀니', d: '틀니가 자꾸 들뜨거나 잇몸이 아파 식사가 불편할 때 쓰는 방법이에요. 잇몸뼈에 임플란트를 2~4개 심고 그 위에 틀니를 똑딱이처럼 끼워 고정해, 일반 틀니보다 덜 움직이고 식사 때 들뜨는 불편을 줄여 줍니다.' },
] as const;
const chapters = SITE.nav.find((n) => n.href === '/silver/')!.children!;
---

<Layout
  title="실버 클리닉 · 보험 임플란트 · 보험 틀니"
  description="파주 운정 김앤김치과 실버 클리닉. 만 65세 이상 보험 임플란트·보험 틀니, 당뇨·고혈압 등 만성질환이 있어도 드시는 약부터 확인하는 안전 진료."
  crumbs={[{ name: '실버 클리닉', path: '/silver/' }]}
  treatment
  clinic="silver"
  keywords={["보험 임플란트", "보험 틀니", "실버 치과", "틀니", "당뇨 임플란트"]}
  procedures={["전체 틀니", "부분 틀니", "임플란트 틀니", "보험 임플란트", "보험 틀니", "잇몸 치료", "시린 이 치료(GI 충전)"]}
>
  <PageHero clinic="silver" crumbs={['실버 클리닉']} eyebrow="“내 부모님이라면”" title="부모님엔 편안함을" suffix="김앤김치과" lead="잘 안 씹혀도 자식 걱정할까 봐 말씀 안 하시는 부모님. 드시는 약이 많아 치과 치료가 더 망설여지시는 부모님. 그 마음까지 헤아려, 부모님의 식사 시간을 편안하게 돌봐드립니다.">
    <SubTabs items={SITE.nav.find((n) => n.href === '/silver/')!.children!} current="" />
  </PageHero>

  <WorryBand items={worries} />

  <!-- 역지사지 진료 노트: 고민 띠 바로 아래 -->
  <Section class="!pt-0">
    <Note align="left" quote={'제 부모님이라면 무엇보다|안전하고 덜 힘드셨으면 합니다.\n그래서 드시는 약과|혈압·혈당부터 확인하고,\n틀니 하나를 맞춰도|식사 때 불편한 곳이 없는지|몇 번이고 다시 봐 드립니다.\n편안한 한 끼가 부모님의 하루를|바꾼다는 걸 알기 때문입니다.'} />
  </Section>


  <ChapterHead id="denture" photo={chModel} position="50% 22%" index={1} title="틀니 클리닉" items={chapters} />

  <Section title="잇몸에 맞춰, 편안하게 씹으실 수 있도록">
    <ul class="grid gap-4 md:grid-cols-3">
      {
        dentures.map((x) => (
          <li class="rounded-3xl border border-border p-5 md:p-6">
            <Image src={x.img} alt={`${x.t} 모형 그림`} widths={[400, 660]} sizes="(min-width: 768px) 30vw, 100vw" class="aspect-[11/10] h-auto w-full rounded-2xl bg-white object-contain" />
            <h3 class="mt-5 px-2 t-head font-bold text-primary">{x.t}</h3>
            <p class="mt-3 px-2 t-body text-foreground-muted whitespace-pre-line">{br(x.d)}</p>
          </li>
        ))
      }
    </ul>
    <h3 class="mt-12 mb-5 t-head font-bold">틀니 진료 과정</h3>
    <Process
      items={[
        { img: step1, title: '검진·본뜨기', text: '남은 치아와 잇몸 상태를 먼저 살피고, 말랑한 재료로 입안 모양을 그대로 본뜹니다. 몇 분이면 끝나는 과정이라 편하게 계시면 됩니다.' },
        { img: step2, title: '맞춤 제작', text: '본뜬 모형에 맞춰 잇몸 모양과 씹는 높이를 하나하나 맞춥니다. 중간에 미리 끼워 보며 불편한 곳이 없는지 함께 확인합니다.' },
        { img: step3, title: '장착', text: '완성된 틀니를 끼우고, 끼우고 빼는 방법과 닦는 법을 천천히 알려 드립니다. 처음 며칠은 어색할 수 있어 무엇을 드시면 좋은지도 안내합니다.' },
        { img: step4, title: '적응·조정', text: '쓰시다가 눌리거나 아픈 곳이 있으면 언제든 말씀해 주세요. 맞물림과 잇몸 닿는 부분을 다시 다듬어 편안해지실 때까지 맞춰 드립니다.' },
      ]}
    />
        <p class="mt-2 t-body text-foreground-muted">장착 후 조정: 보험 틀니는 3개월 안에 6회까지, 비급여 틀니는 편하게 쓰실 수 있을 때까지 맞춰 드립니다.</p>
  </Section>

  <ChapterHead id="insurance" photo={chConsult} position="50% 35%" index={2} title="보험 임플란트·틀니" lead="만 65세 이상 국가 건강보험 적용 (2026년 기준)" items={chapters} />

  <Section tone="surface" title="만 65세 이상이시라면 건강보험이 적용됩니다">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="flex items-center gap-5 overflow-hidden rounded-3xl bg-background p-6 shadow-sm md:gap-8 md:p-8">
        <div class="flex w-32 shrink-0 justify-center md:w-44"><Image src={insImplant} alt="잇몸뼈에 심은 임플란트 모형" widths={[240, 420]} sizes="(min-width: 768px) 16rem, 12rem" class="h-auto w-24 md:w-32" /></div>
        <div class="flex-1">
          <p class="inline-flex rounded-full bg-primary-surface px-3 py-1 t-body font-semibold text-primary">만 65세 이상</p>
          <h3 class="mt-3 t-head font-bold">보험 임플란트</h3>
          <p class="mt-4 t-headline font-bold text-primary">평생 2개</p>
          <p class="mt-1 t-body text-foreground-muted">본인부담 30%</p>
        </div>
      </div>
      <div class="flex items-center gap-5 overflow-hidden rounded-3xl bg-background p-6 shadow-sm md:gap-8 md:p-8">
        <div class="flex w-32 shrink-0 justify-center md:w-44"><Image src={insDenture} alt="전체 틀니 모형" widths={[240, 420]} sizes="(min-width: 768px) 16rem, 12rem" class="h-auto w-full" /></div>
        <div class="flex-1">
          <p class="inline-flex rounded-full bg-primary-surface px-3 py-1 t-body font-semibold text-primary">만 65세 이상</p>
          <h3 class="mt-3 t-head font-bold">보험 틀니</h3>
          <p class="mt-4 t-headline font-bold text-primary">7년마다 1회</p>
          <p class="mt-1 t-body text-foreground-muted">본인부담 30% · 전체·부분 틀니 모두</p>
        </div>
      </div>
    </div>
    <p class="mt-4 t-body text-foreground-muted">대상 여부는 내원 시 확인해 드립니다.</p>
  </Section>

  <ChapterHead id="safe" photo={chDesk} index={3} title="만성질환 안전 진료" items={chapters} />

  <Section title="드시는 약부터, 먼저 살핍니다">
    <Process
      items={[
        { title: '문진', text: '복용 약 확인' },
        { title: '혈압·혈당 체크' },
        { title: '내과 협진', text: '필요 시' },
        { title: '신중한 시술', text: '꼼꼼한 지혈' },
        { title: '경과 확인', text: '다음 날' },
      ]}
    />
    <p class="mt-6 rounded-2xl bg-primary-surface px-6 py-4 t-mid font-semibold text-primary">진료 오실 때 약 봉투나 처방전을 가져와 주세요.</p>
  </Section>

  <ChapterHead id="care" photo={chRoom} index={4} title="잇몸·시린 이 관리" lead="잇몸 · 시린 이 · 구강건조까지 꾸준히" items={chapters} />

  <Section tone="surface" title="노년기 구강 건강을 꾸준히 지킵니다">
    <Image src={tGum} alt="잇몸 경계를 관리하는 잇몸 치료 그림" widths={[480, 640]} sizes="(min-width: 768px) 50vw, 100vw" class="mb-6 w-full rounded-3xl bg-white object-contain md:w-1/2" />
    <p class="max-w-prose t-mid leading-relaxed text-foreground-muted">보험 잇몸 치료와 시린 이 치료(GI 충전), 정기 불소 관리로 노년기 구강 건강을 지킵니다.</p>
  </Section>

  <Section eyebrow="자주 묻는 질문" title="부모님 치아, 이것이 궁금해요">
    <FaqLinks group="silver" />
  </Section>
</Layout>

