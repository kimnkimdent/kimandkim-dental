---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Note from '../components/Note.astro';
import Process from '../components/Process.astro';
import FaqLinks from '../components/FaqLinks.astro';
import Photo from '../components/Photo.astro';

const worries = ['빠진 이가 많아 식사가 불편해요', '쓰던 틀니가 헐겁거나 잇몸이 아파요', '당뇨·고혈압 약을 먹고 있어 치료가 걱정돼요', '잇몸이 내려가고, 이가 시리고, 입이 자주 말라요'];
// TODO(원장님 확인): 임플란트 틀니 설명
const dentures = [
  { t: '전체 틀니', d: '치아가 모두 없을 때 잇몸 전체를 덮는 틀니' },
  { t: '부분 틀니', d: '남은 치아에 고리를 걸어 빈자리를 채우는 틀니' },
  { t: '임플란트 틀니', d: '임플란트에 똑딱이로 연결해 덜 움직이는 틀니' },
];
---

<Layout
  title="실버 치아 클리닉 · 보험 임플란트 · 보험 틀니"
  description="파주 운정 김앤김치과 실버 치아 클리닉. 만 65세 이상 보험 임플란트·보험 틀니, 당뇨·고혈압 등 만성질환이 있어도 드시는 약부터 확인하는 안전 진료."
  crumbs={[{ name: '실버 치아 클리닉', path: '/silver/' }]}
  treatment
  keywords={["보험 임플란트", "보험 틀니", "실버 치과", "틀니", "당뇨 임플란트"]}
  procedures={["전체 틀니", "부분 틀니", "임플란트 틀니", "보험 임플란트", "보험 틀니", "잇몸 치료", "시린 이 치료(GI 충전)"]}
>
  <PageHero crumbs={['실버 치아 클리닉']} eyebrow="“내 부모님이라면”" title="부모님엔 편안함을" lead="부모님의 식사 시간을 편안하게 돌봐드립니다." />

  <div class="bg-background">
    <div class="mx-auto max-w-site px-gutter">
      <Photo alt="식탁에서 손주와 웃으며 식사하는 실버 부부" ratio="aspect-[21/9]" />
    </div>
  </div>

  <Section>
    <Note quote="제 부모님이라면 무엇보다 안전하고 덜 힘드셨으면 합니다. 그래서 드시는 약부터 확인합니다." />
  </Section>

  <Section tone="surface" title="이런 고민 있으신가요?" align="center">
    <ul class="mx-auto grid max-w-[88rem] gap-3 sm:grid-cols-2">
      {
        worries.map((w) => (
          <li class="flex items-center gap-3 rounded-2xl bg-background px-6 py-5 t-mid font-semibold shadow-sm">
            <svg aria-hidden="true" class="size-6 shrink-0 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4.5 4.5L19 7" /></svg>
            {w}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section eyebrow="틀니 클리닉" title="잇몸에 맞춰, 편안하게 씹으실 수 있도록">
    <ul class="grid gap-4 md:grid-cols-3">
      {
        dentures.map((x) => (
          <li class="rounded-3xl border border-border p-7">
            <h3 class="t-head font-bold text-primary">{x.t}</h3>
            <p class="mt-3 t-body text-foreground-muted">{x.d}</p>
          </li>
        ))
      }
    </ul>
    <h3 class="mt-12 mb-5 t-head font-bold">틀니 진료 과정</h3>
    <Process items={[{ title: '검진·본뜨기' }, { title: '맞춤 제작' }, { title: '장착' }, { title: '적응·조정' }]} />
    <p class="mt-4 t-body text-foreground-muted">검진·본뜨기 → 맞춤 제작 → 장착 → 적응·조정까지 함께합니다.</p>
  </Section>

  <Section tone="surface" eyebrow="국가보험 임플란트·틀니 (2026년 기준)" title="만 65세 이상이시라면 건강보험이 적용됩니다">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">보험 임플란트</h3>
        <p class="mt-2 t-body text-foreground-muted">만 65세 이상</p>
        <p class="mt-5 t-headline font-bold text-primary">평생 2개 · 본인부담 30%</p>
      </div>
      <div class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">보험 틀니</h3>
        <p class="mt-2 t-body text-foreground-muted">만 65세 이상</p>
        <p class="mt-5 t-headline font-bold text-primary">7년마다 1회 · 본인부담 30%</p>
      </div>
    </div>
    <p class="mt-4 t-body text-foreground-muted">대상 여부는 내원 시 확인해 드립니다.</p>
  </Section>

  <Section id="safe" eyebrow="만성질환 안전 진료" title="드시는 약부터, 먼저 살핍니다">
    <Process
      items={[
        { title: '문진', text: '복용 약 확인' },
        { title: '혈압·혈당 체크' },
        { title: '내과 협진', text: '필요 시' },
        { title: '신중한 시술', text: '꼼꼼한 지혈' },
        { title: '경과 확인', text: '다음 날' },
      ]}
    />
    <p class="mt-6 rounded-2xl bg-primary-surface px-6 py-4 t-mid font-semibold text-primary">진료 오실 때 약 봉투나 처방전을 가져와 주세요.</p>
  </Section>

  <Section tone="surface" eyebrow="잇몸 · 시린 이 · 구강건조 관리" title="노년기 구강 건강을 꾸준히 지킵니다">
    <p class="max-w-prose t-mid leading-relaxed text-foreground-muted">보험 잇몸 치료와 시린 이 치료(GI 충전), 정기 불소 관리로 노년기 구강 건강을 지킵니다.</p>
  </Section>

  <Section eyebrow="자주 묻는 질문" title="부모님 치아, 이것이 궁금해요">
    <FaqLinks group="silver" />
  </Section>
</Layout>
