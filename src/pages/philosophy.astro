---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { SITE, br } from '../site';
import doctorDeskSmile from '../assets/photos/doctor-desk-smile.jpg';
import xrayExplain from '../assets/photos/xray-explain.jpg';
import modelExplain from '../assets/photos/model-explain.jpg';
import xrayWoman from '../assets/photos/xray-woman2.jpg';

// 원장 인터뷰(원장님 말씀 그대로, 문단·줄바꿈도 그대로)
const interview = [
  "제가 진료할 때 가장 많이 되묻는\n질문이 하나 있어요.",
  "'내가 환자라면,\n내가 이 돈을 낸다면\n어떤 치료를 선택할까'라는 거예요.\n역지사지 정신을\n순간의 판단이 아니라,\n습관처럼 매 진료마다\n적용하려고 해요.",
  "그러다 보니\n무조건 비싼 치료를 권하기보다,\n환자분 상황에 맞는\n현실적인 치료를 함께 고민하고\n타고난 치아를 최대한 끝까지\n쓰실 수 있도록\n기본을 지키게 되더라고요.",
  "치료 전에는 늘 충분히 설명드려서\n막연한 불안감이 확신으로\n바뀔 수 있게 하고요.",
  "다만 이 역지사지가\n환자의 감정 공감에만\n쏠리는 건 아니에요.",
  "설명은 편안하고 따뜻하게\n해드리지만,\n정작 어떤 치료가 필요한지는\n냉정하게 이성적인 판단을\n하려고 노력합니다.",
  "환자 입장에서 생각하는 것과,\n환자에게 정말 필요한 걸\n객관적으로 진단하고 치료하는 것.\n이 두 가지를 같이 가져가는 게\n제 진료의 핵심이에요."
];

const questions = [
  { q: '내가 환자라면,\n무엇이 가장 두려울까', a: '치과 문을 열기까지의 망설임을 압니다. 치료보다 마음을 먼저 살핍니다.' },
  { q: '내가 이 비용을 낸다면,\n어떤 치료를 선택할까', a: '비싼 치료가 늘 좋은 치료는 아닙니다. 사정에 맞는 현실적인 치료를 함께 고민합니다.' },
  { q: '내 가족이라면,\n이 치료를 권할까', a: '내 부모님, 내 아이에게 하지 않을 치료는 권하지 않습니다.' },
];
const rules = [
  { t: '밝은 진료 분위기', d: '첫인사부터 귀가까지 웃는 얼굴로 맞이하고, 진료 중에도 지금 무엇을 하는지 말씀드립니다.', photo: '진료실에서 웃으며 맞이하는 대표원장', src: doctorDeskSmile },
  { t: '충분한 설명', d: '엑스레이를 함께 보며 통증·기간·비용을 치료 전에 안내합니다. 아이는 부모님께, 어르신은 자녀분께도 설명드립니다.', photo: '엑스레이 화면 앞에서 여성 환자에게 손짓하며 설명하는 대표원장', src: xrayWoman },
  { t: '두려움까지 배려', d: '눈높이를 맞추고, 무엇을 할지 먼저 보여 드리며 설명합니다. 표면 마취 후 천천히 마취하고, 손을 드시면 바로 멈춥니다.', photo: '치아 모형을 들고 설명하는 대표원장', src: modelExplain },
  { t: '꼭 필요한 치료', d: '자연치아를 지킬 방법부터 검토하고, 여러 방법의 장단점과 비용을 비교해 드린 뒤 선택을 기다립니다.', photo: '엑스레이 화면을 보며 설명하는 대표원장', src: xrayExplain },
];
---

<Layout
  title="진료철학"
  description="易地思之, 내가 환자라면. 김앤김치과 대표원장 김정민이 진료할 때마다 스스로에게 묻는 3가지 질문과 진료실에서 지키는 4가지 원칙."
  crumbs={[{ name: '진료철학', path: '/philosophy/' }]}
  keywords={["진료철학", "역지사지", "양심 치과"]}
>
  <!-- 첫 화면: 왼쪽 易地思之 · 핵심 질문(h1) · 블로그 자세히 보기 / 오른쪽 원장 인터뷰(원문·줄바꿈 그대로) -->
  <section class="relative isolate overflow-hidden bg-gradient-to-b from-primary-surface to-background pt-14 pb-section md:pt-20" aria-labelledby="philosophy-title">
    <Container class="relative">
      <p class="relative z-10 t-body text-foreground-muted">홈 &gt; 진료철학</p>
      <div class="mt-6 grid gap-10 md:grid-cols-[0.9fr_1.1fr] md:gap-16">
        <div class="relative md:sticky md:top-32 md:self-start">
          <p aria-hidden="true" class="pointer-events-none absolute top-[38%] left-[-0.06em] -z-10 -translate-y-1/2 font-serif text-[10rem] leading-none font-bold whitespace-nowrap text-primary opacity-[0.08] select-none sm:text-[14rem] md:text-[18rem]">易地思之</p>
          <p class="flex items-center gap-2.5 t-mid font-semibold text-primary"><ServiceIcon name="philosophy" class="size-10 md:size-12" />易地思之 · 원장 인터뷰</p>
          <span aria-hidden="true" class="mt-6 block h-[3.6rem] font-serif text-[7rem] leading-[0.9] text-primary-bright">“</span>
          <h1 id="philosophy-title" class="mt-2 font-serif text-[2.8rem] leading-[1.5] font-bold md:text-[3.8rem]">
            내가 환자라면…<br />내 가족이라면…
          </h1>
          <!-- 네이버 블로그 진료철학 글로 연결(주소는 src/site.ts의 blogPhilosophy) -->
          <div class="mt-8">
            <Button href={SITE.contact.blogPhilosophy} variant="primary" size="lg" class="shadow-md max-md:min-h-11 max-md:gap-1.5 max-md:px-5 max-md:py-2 max-md:text-[1.4rem]">
              역지사지 진료철학
              <span class="t-body font-medium opacity-80 max-md:text-[1.2rem]">더 자세히 보기</span>
              <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
            </Button>
          </div>
        </div>

        <div data-speakable class="space-y-7 border-l-2 border-primary/20 pl-6 t-mid leading-[1.85] text-foreground-muted md:pl-10">
          {interview.map((para) => <p class="whitespace-pre-line">{para}</p>)}
          <p class="!mt-10 t-body font-semibold text-foreground">— 김정민 원장 인터뷰 중에서 —</p>
        </div>
      </div>
    </Container>
  </section>

  <Section tone="surface" eyebrow="3가지 질문" title="제가 매번 스스로에게 묻는 3가지 질문">
    <ol class="grid gap-4 md:grid-cols-3">
      {
        questions.map((x, i) => (
          <li class="rounded-3xl bg-surface p-8">
            <span class="font-serif text-[4rem] leading-none font-bold text-primary/30">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 t-head font-bold whitespace-pre-line">{x.q}</h3>
            <p class="mt-4 t-body leading-relaxed text-foreground-muted whitespace-pre-line">{br(x.a)}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section eyebrow="4가지 원칙" title="진료실에서 지키는 4가지 원칙" lead="3가지 질문은 진료실에서 이렇게 지켜집니다.">
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        rules.map((r, i) => (
          <li class="overflow-hidden rounded-3xl bg-background shadow-sm">
            <Photo src={r.src} alt={r.photo} ratio="aspect-[16/9]" class="[&>*]:rounded-none" />
            <div class="p-7">
              <p class="t-body font-bold text-primary">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-1 t-head font-bold">{r.t}</h3>
              <p class="mt-3 t-body leading-relaxed text-foreground-muted whitespace-pre-line">{br(r.d)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
