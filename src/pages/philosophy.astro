---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Photo from '../components/Photo.astro';

const questions = [
  { q: '내가 환자라면,\n무엇이 가장 두려울까', a: '치과 문을 열기까지의 망설임을 압니다. 치료보다 마음을 먼저 살핍니다.' },
  { q: '내가 이 비용을 낸다면,\n어떤 치료를 선택할까', a: '비싼 치료가 늘 좋은 치료는 아닙니다. 사정에 맞는 현실적인 치료를 함께 고민합니다.' },
  { q: '내 가족이라면,\n이 치료를 권할까', a: '내 부모님, 내 아이에게 하지 않을 치료는 권하지 않습니다.' },
];
// TODO(원장님 확인): 03 마취 장비명
const rules = [
  { t: '밝은 진료 분위기', d: '첫인사부터 귀가까지 웃는 얼굴로 맞이하고, 진료 중에도 지금 무엇을 하는지 말씀드립니다.', photo: '어르신께 눈높이 맞춰 안내하는 스탭' },
  { t: '충분한 설명', d: '엑스레이를 함께 보며 통증·기간·비용을 치료 전에 안내합니다. 아이는 부모님께, 어르신은 자녀분께도 설명드립니다.', photo: '엑스레이를 가리키며 설명하는 원장' },
  { t: '두려움까지 배려', d: '표면 마취 후 천천히 마취하고, 손을 드시면 바로 멈춥니다.', photo: '스탭과 하이파이브하는 아이' },
  { t: '꼭 필요한 치료', d: '자연치아를 지킬 방법부터 검토하고, 여러 방법의 장단점과 비용을 비교해 드린 뒤 선택을 기다립니다.', photo: '치아 모형을 들고 설명하는 원장의 손' },
];
---

<Layout
  title="진료철학"
  description="易地思之, 내가 환자라면. 김앤김치과 대표원장 김정민이 진료할 때마다 스스로에게 묻는 세 가지 질문과 진료실에서 지키는 4가지 원칙."
  crumbs={[{ name: '진료철학', path: '/philosophy/' }]}
>
  <PageHero
    crumbs={['진료철학']}
    watermark="易地思之"
    eyebrow="易地思之"
    title="내가 환자라면"
    lead={'진료하는 모든 순간 습관처럼 생각합니다. “내가 환자라면…”\n그래야 환자분만을 위한 진료를 할 수 있기 때문입니다.'}
  />

  <Section eyebrow="세 가지 질문" title="제가 매번 스스로에게 묻는 세 가지 질문">
    <ol class="grid gap-4 md:grid-cols-3">
      {
        questions.map((x, i) => (
          <li class="rounded-3xl bg-surface p-8">
            <span class="font-serif text-[4rem] leading-none font-bold text-primary/30">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 t-head font-bold whitespace-pre-line">{x.q}</h3>
            <p class="mt-4 t-body leading-relaxed text-foreground-muted">{x.a}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section tone="surface" eyebrow="4가지 원칙" title="진료실에서 지키는 4가지 원칙" lead="세 가지 질문은 진료실에서 이렇게 지켜집니다.">
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        rules.map((r, i) => (
          <li class="overflow-hidden rounded-3xl bg-background shadow-sm">
            <Photo alt={r.photo} ratio="aspect-[16/9]" class="[&>*]:rounded-none" />
            <div class="p-7">
              <p class="t-body font-bold text-primary">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-1 t-head font-bold">{r.t}</h3>
              <p class="mt-3 t-body leading-relaxed text-foreground-muted">{r.d}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
