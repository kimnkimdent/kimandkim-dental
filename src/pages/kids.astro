---
import checkup1 from '../assets/kids/checkup1-v5.jpg';
import checkup2 from '../assets/kids/checkup2-v4.jpg';
import checkup3 from '../assets/kids/checkup3-v4.jpg';
const checkupImgs = [checkup1, checkup2, checkup3];
import ImageCard from '../components/ImageCard.astro';
import first1 from '../assets/kids/first1-v3.jpg';
import first2 from '../assets/kids/first2-v2.jpg';
import first3 from '../assets/kids/first3-v5.jpg';
import { SITE, br } from '../site';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Note from '../components/Note.astro';
import SubTabs from '../components/SubTabs.astro';
import ChapterHead from '../components/ChapterHead.astro';
import FaqLinks from '../components/FaqLinks.astro';
import Photo from '../components/Photo.astro';
import { Image } from 'astro:assets';
import tKids from '../assets/kids/care-v2.jpg';
import kidFriendly from '../assets/photos/logo-wall.jpg';
import chTreat from '../assets/photos/band-scanner.jpg';
import chTeen from '../assets/photos/xray-explain.jpg';
import kidCheckup from '../assets/photos/kid-checkup.jpg';
import frontInjury from '../assets/kids/front-injury-v2.jpg';
import between from '../assets/kids/between-v4.jpg';
import crooked from '../assets/kids/crooked-v2.jpg';

const checkups = [
  { t: '1차', d: '생후 18~29개월', x: '첫 이가 잘 나고 있는지, 젖병·밤중 수유로 인한 충치는 없는지 살핍니다.' },
  { t: '2차', d: '생후 42~53개월', x: '유치 충치와 양치 습관을 확인하고, 집에서 닦는 방법을 알려 드립니다.' },
  { t: '3차', d: '생후 54~65개월', x: '영구치가 나오기 전 유치 상태와 맞물림을 점검합니다.' },
];
import WorryBand from '../components/WorryBand.astro';
const worries = ["아이가 치과를 너무 무서워해요","첫 치과는 언제 가야 하나요?","유치는 빠질 텐데 꼭 치료해야 하나요?","밤에 젖병을 물고 자요","이 사이가 까맣게 보여요","양치를 싫어해서 매번 전쟁이에요","영구치가 삐뚤게 나고 있어요","넘어져서 앞니를 다쳤어요"];
const chapters = SITE.nav.find((n) => n.href === '/kids/')!.children!;
---

<Layout
  title="어린이·청소년 클리닉"
  description="파주 운정 김앤김치과 어린이·청소년 클리닉. 국가 영유아 구강검진(무료), 불소 도포·실란트, 유치 충치 치료, 청소년 정기 검진. 치과가 무서운 아이도 준비될 때까지 기다립니다."
  crumbs={[{ name: '어린이·청소년 클리닉', path: '/kids/' }]}
  treatment
  clinic="kids"
  keywords={["어린이 치과", "영유아 구강검진", "실란트", "불소 도포", "운정 어린이 치과"]}
  procedures={["국가 영유아 구강검진", "불소 도포", "실란트", "유치 충치 치료", "유치 신경 치료", "영구치 레진 치료"]}
>
  <PageHero clinic="kids" crumbs={['어린이·청소년 클리닉']} eyebrow="“내 아이라면”" title="우리 아이엔 안심을" suffix="김앤김치과" lead="첫 이가 나던 날부터 교복을 입는 날까지 함께 지켜봅니다.">
    <SubTabs items={SITE.nav.find((n) => n.href === '/kids/')!.children!} current="" />
  </PageHero>

  <WorryBand items={worries} />

  <!-- 역지사지 진료 노트: 고민 띠 바로 아래 -->
  <Section class="!pt-0">
    <Note align="left" quote={'제 아이라면, 오늘 치료를|다 끝내는 것보다\n다음에 또 와도 괜찮다고|느끼게 하는 게 먼저일 겁니다.\n그래서 무엇을 할지 먼저 말하고,|기구를 보여 주고,|아이가 준비될 때까지 기다립니다.\n처음 만난 치과의 기억이|평생의 치아 습관이 되니까요.'} />
  </Section>

  <ChapterHead id="first" photo={kidCheckup} position="60% 40%" index={1} title="처음 오는 아이" lead="치과가 무서운 아이를 위해" items={chapters} />

  <Section tone="surface" title="치과가 무서운 아이도 편안해지도록,|먼저 말하고 보여 주고 준비될 때까지 기다립니다">
    <ol class="grid gap-4 md:grid-cols-3">
      {([
        [first1, '무엇을 할지 말합니다', '오늘 무엇을 할지 아이 눈높이에 맞는 말로 먼저 이야기합니다.'],
        [first2, '기구를 보여 줍니다', '쓰는 기구를 직접 보고 만져 보게 해, 낯선 두려움을 줄입니다.'],
        [first3, '준비될 때까지 기다립니다', '아이가 괜찮다고 할 때 시작하고, 첫날은 치과와 친해지는 데서 끝나기도 합니다.'],
      ] as const).map(([img, t, d], i) => <ImageCard img={img} alt={t + ' 그림'} no={i + 1} title={t} text={d} cover />)}
    </ol>
  </Section>

  <ChapterHead id="checkup" photo={chTreat} position="50% 28%" index={2} title="영유아 구강검진" lead="무료 국가 검진과 충치 예방" items={chapters} />

  <Section title="나라에서 지원하는 무료 영유아 구강검진으로,|시기에 맞춰 아이 치아를 꼼꼼히 살핍니다">
    <ol class="grid gap-3 md:grid-cols-3">
      {
        checkups.map((c, i) => (
          <li class="overflow-hidden rounded-3xl border border-border pb-7 text-center">
            <Image src={checkupImgs[i]} alt={`${c.t} 영유아 구강검진 그림`} widths={[320, 640]} sizes="(min-width: 768px) 30vw, 100vw" class="mb-5 aspect-square h-auto w-full object-cover" />
            <p class="t-head font-bold text-primary">{c.t}</p>
            <p class="mt-2 px-7 t-mid whitespace-pre-line">{br(c.d)}</p>
            <p class="mt-3 px-7 t-body leading-relaxed text-foreground-muted">{c.x}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 rounded-2xl bg-primary-surface px-6 py-4 t-mid text-foreground"><strong class="text-primary">불소 도포 · 실란트</strong> 충치가 생기기 전에 미리 막습니다. 불소는 치아 표면을 단단하게 하고, 실란트는 어금니의 깊은 홈을 메워 음식물이 끼지 않게 합니다.</p>
  </Section>

  <ChapterHead id="care" photo={kidFriendly} position="50% 45%" index={3} title="어린이 충치 치료" items={chapters} />

  <Section tone="surface" title="유치도 소중한 치아이기에,|아이가 덜 힘들도록 차근차근 치료합니다">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-3xl bg-background p-6 shadow-sm">
        <Image src={tKids} alt="치과에서 아이 치아에 빛을 쬐어 치료하는 모습" widths={[480, 960]} sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw" class="mb-4 aspect-[3/2] h-auto w-full rounded-2xl object-cover" />
        <h3 class="t-mid font-bold">어린이 충치 치료</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">유치도 충치를 두면 아프고 영구치 자리에 영향을 줄 수 있어 꼭 치료합니다. 유치 신경 치료도 하며, 영구치 레진 치료는 만 12세 이하 보험이 적용됩니다.</p>
      </div>
      <div class="rounded-3xl bg-background p-6 shadow-sm">
        <Image src={crooked} alt="유치가 빠지고 영구치가 나는 아이의 입 모양" widths={[480, 960]} sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw" class="mb-4 aspect-[3/2] h-auto w-full rounded-2xl object-cover" />
        <h3 class="t-mid font-bold">영구치가 삐뚤게 날 때</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">유치가 늦게 빠지거나 영구치가 비켜 나면 엑스레이로 자리를 확인합니다. 지금 치료가 필요한지, 조금 더 지켜봐도 되는지 알기 쉽게 설명해 드리고, 정기 검진으로 함께 살핍니다.</p>
      </div>
      <div class="rounded-3xl bg-background p-6 shadow-sm">
        <Image src={between} alt="아이 앞니 사이가 까맣게 보이는 입 모양" widths={[480]} sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw" class="mb-4 aspect-[3/2] h-auto w-full rounded-2xl object-cover" />
        <h3 class="t-mid font-bold">이 사이가 까맣게 보일 때</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">이와 이 사이에 생긴 충치는 겉으로 잘 보이지 않아 늦게 발견되기 쉽습니다. 엑스레이로 크기를 확인하고, 작을 때 치료하면 아이도 덜 힘듭니다.</p>
      </div>
      <div class="rounded-3xl bg-background p-6 shadow-sm">
        <Image src={frontInjury} alt="앞니 끝이 깨진 입 모양" widths={[480, 690]} sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw" class="mb-4 aspect-[3/2] h-auto w-full rounded-2xl object-cover" />
        <h3 class="t-mid font-bold">넘어져 앞니를 다쳤을 때</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">깨진 조각이나 빠진 이는 우유나 식염수에 담가 바로 오세요. 빨리 오실수록 치아를 살릴 가능성이 높아집니다.</p>
      </div>
    </div>
  </Section>

  <ChapterHead id="teen" photo={chTeen} position="50% 40%" index={4} title="청소년 관리" lead="바쁜 중·고등학생 시기에도" items={chapters} />

  <Section title="공부로 바쁜 시기에도,|한 번 올 때 필요한 것을 꼼꼼히 확인합니다">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-border p-8 shadow-sm">
        <h3 class="t-head font-bold">정기 검진·스케일링</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">중·고등학생 때는 바빠서 검진을 놓치기 쉽습니다. 6개월마다 충치와 잇몸을 살피고, 필요하면 스케일링으로 치석을 정리합니다.</p>
      </div>
      <div class="rounded-3xl border border-border p-8 shadow-sm">
        <h3 class="t-head font-bold">사랑니 위치 확인</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">사랑니가 자리를 잡기 시작하는 시기입니다. 엑스레이로 방향과 위치를 미리 보고, 지켜볼지 뺄지를 함께 정합니다.</p>
      </div>
      <div class="rounded-3xl border border-border p-8 shadow-sm">
        <h3 class="t-head font-bold">이갈이·턱관절</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">시험 기간 스트레스로 이를 갈거나 턱에서 소리가 나기도 합니다. 턱 움직임과 치아 닳은 정도를 확인하고 생활 습관을 안내해 드립니다.</p>
      </div>
      <div class="rounded-3xl border border-border p-8 shadow-sm">
        <h3 class="t-head font-bold">잇몸 붓기·피 날 때</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">양치가 소홀해지면 사춘기에 잇몸이 쉽게 붓고 피가 납니다. 원인을 살피고, 잘 닦이지 않는 곳을 짚어 칫솔질 방법을 알려 드립니다.</p>
      </div>
      <div class="rounded-3xl border border-border p-8 shadow-sm">
        <h3 class="t-head font-bold">운동하다 다쳤을 때</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">깨지거나 흔들리는 이는 빨리 오실수록 좋습니다. 운동을 자주 한다면 치아를 다치지 않게 지키는 방법도 상담해 드립니다.</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="자주 묻는 질문" title="우리 아이 치아">
    <FaqLinks group="kids" />
  </Section>
</Layout>
