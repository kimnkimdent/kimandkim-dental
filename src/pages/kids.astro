---
import { SITE, br } from '../site';
import bandKid from '../assets/photos/band-kid.jpg';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Note from '../components/Note.astro';
import SubTabs from '../components/SubTabs.astro';
import ChapterHead from '../components/ChapterHead.astro';
import FaqLinks from '../components/FaqLinks.astro';
import Photo from '../components/Photo.astro';
import Mark from '../components/Mark.astro';
import { Image } from 'astro:assets';
import tKids from '../assets/treat/treat-06.jpg';
import kidFriendly from '../assets/photos/kid-friendly.jpg';
import kidCheckup from '../assets/photos/kid-checkup.jpg';

const checkups = [
  { t: '1차', d: '생후 18~29개월' },
  { t: '2차', d: '생후 42~53개월' },
  { t: '3차', d: '생후 54~65개월' },
];
import WorryBand from '../components/WorryBand.astro';
const worries = ["아이가 치과를 너무 무서워해요","첫 치과는 언제 가야 하나요?","유치는 빠질 텐데 꼭 치료해야 하나요?","밤에 젖병을 물고 자요","이 사이가 까맣게 보여요","양치를 싫어해서 매번 전쟁이에요","영구치가 삐뚤게 나고 있어요","넘어져서 앞니를 다쳤어요"];
const chapters = SITE.nav.find((n) => n.href === '/kids/')!.children!;
---

<Layout
  title="어린이·청소년 클리닉"
  description="파주 운정 김앤김치과 어린이·청소년 클리닉. 국가 영유아 구강검진(무료), 불소 도포·실란트, 유치 충치 치료, 청소년 정기 검진. 치과가 무서운 아이도 준비될 때까지 기다립니다."
  crumbs={[{ name: '어린이·청소년 클리닉', path: '/kids/' }]}
  treatment
  clinic="kids"
  keywords={["어린이 치과", "영유아 구강검진", "실란트", "불소 도포", "운정 어린이 치과"]}
  procedures={["국가 영유아 구강검진", "불소 도포", "실란트", "유치 충치 치료", "유치 신경 치료", "영구치 레진 치료"]}
>
  <PageHero clinic="kids" crumbs={['어린이·청소년 클리닉']} eyebrow="“내 아이라면”" title="우리 아이엔 안심을" suffix="김앤김치과" lead="첫 이가 나던 날부터 교복을 입는 날까지 함께 지켜봅니다.">
    <SubTabs items={SITE.nav.find((n) => n.href === '/kids/')!.children!} current="" />
    <!-- 역지사지 진료 노트: 제목 바로 아래 -->
    <div class="relative mt-10 md:mt-12">
      <Note align="left" quote={'제 아이라면, 오늘 치료를|다 끝내는 것보다\n다음에 또 와도 괜찮다고|느끼게 하는 게 먼저일 겁니다.\n그래서 무엇을 할지 먼저 말하고,|기구를 보여 주고,|아이가 준비될 때까지 기다립니다.\n처음 만난 치과의 기억이|평생의 치아 습관이 되니까요.'} />
    </div>
  </PageHero>

  <WorryBand items={worries} />

  <ChapterHead id="first" photo={bandKid} position="40% 40%" index={1} title="처음 오는 아이" lead="치과가 무서운 아이를 위해" items={chapters} />

  <Section tone="surface" title="말하고, 보여주고, 기다립니다">
    <ol class="grid gap-3 md:grid-cols-3">
      {['무엇을 할지 말하고', '기구를 보여준 다음 진료합니다', '아이가 준비될 때까지 기다립니다'].map((t, i) => (
        <li class="flex items-center gap-4 rounded-2xl bg-background p-6 shadow-sm">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary t-body font-bold text-primary-foreground">{i + 1}</span>
          <span class="t-mid font-semibold">{t}</span>
        </li>
      ))}
    </ol>
  </Section>

  <ChapterHead id="checkup" photo={kidCheckup} index={2} title="영유아 구강검진" lead="무료 국가 검진과 충치 예방" items={chapters} />

  <Section title="국가 영유아 구강검진 (무료)">
    <ol class="grid gap-3 md:grid-cols-3">
      {
        checkups.map((c) => (
          <li class="rounded-3xl border border-border p-7 text-center">
            <Mark class="mx-auto mb-3 h-12 w-auto" />
            <p class="t-head font-bold text-primary">{c.t}</p>
            <p class="mt-2 t-mid whitespace-pre-line">{br(c.d)}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-6 rounded-2xl bg-primary-surface px-6 py-4 t-mid text-foreground">불소 도포 · 실란트 · 충치가 생기기 전에 미리 막습니다.</p>
  </Section>

  <ChapterHead id="care" photo={kidFriendly} index={3} title="충치 치료·청소년 관리" items={chapters} />

  <Section tone="surface" title="자라는 치아에 맞춰 관리합니다">
    <Image src={tKids} alt="치과에서 아이 치아에 빛을 쬐어 치료하는 모습" widths={[480, 640]} sizes="(min-width: 768px) 50vw, 100vw" class="mb-6 aspect-[16/9] w-full rounded-3xl object-cover md:w-1/2" />
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">어린이 충치 치료</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">유치 충치 치료와 유치 신경 치료, 영구치 레진 치료(만 12세 이하 보험)를 합니다.</p>
      </div>
      <div class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">청소년 관리</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">중·고등학생 시기는 검진 공백이 생기기 쉬워, 정기 검진과 사랑니 위치 확인, 이갈이·턱관절 체크를 함께 합니다.</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="자주 묻는 질문" title="우리 아이 치아">
    <FaqLinks group="kids" />
  </Section>
</Layout>
