---
// 청장년 클리닉(한 페이지): 임플란트(#implant) · 자연치아·심미보철(#natural) · 사랑니·구강외과(#wisdom).
// 각 묶음은 역지사지 진료 노트로 시작한다. 제목 아래 탭과 상단 메뉴는 src/site.ts의 청장년 클리닉 children을 쓴다.
import PhotoBand from '../../components/PhotoBand.astro';
import bandSurgery from '../../assets/photos/band-surgery.jpg';
import bandTreat from '../../assets/photos/band-treat.jpg';
import bandRoom from '../../assets/photos/surgery-room.jpg';
import ctScan from '../../assets/photos/ct-scan.jpg';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Note from '../../components/Note.astro';
import Process from '../../components/Process.astro';
import FaqLinks from '../../components/FaqLinks.astro';
import Photo from '../../components/Photo.astro';
import { Image } from 'astro:assets';
import tImplant from '../../assets/treat/treat-04.jpg';
import tCavity from '../../assets/treat/treat-01.jpg';
import tCrown from '../../assets/treat/treat-07.jpg';
import SubTabs from '../../components/SubTabs.astro';
import { SITE, url, br } from '../../site';

const tabs = SITE.nav.find((n) => n.href === '/adult/')!.children!;
const parts = [
  { t: '픽스처', d: '인공 치근' },
  { t: '지대주', d: '연결 기둥' },
  { t: '크라운', d: '인공 치아' },
];
const kinds = [
  { t: '일반 임플란트', d: '잇몸뼈 상태에 맞춰 식립합니다.' },
  { t: '보험 임플란트', d: '만 65세 이상 평생 2개, 자세한 기준은 실버 클리닉에서 안내합니다.', link: '/silver/#insurance' },
  { t: '뼈이식 임플란트', d: '잇몸뼈가 얇거나 손상된 경우 뼈를 보강한 뒤 식립합니다.' },
  { t: '상악동 거상술 임플란트', d: '위쪽 어금니 뼈 높이가 부족할 때 뼈를 채운 뒤 식립합니다.' },
];
const cavity = [
  { s: '초기', t: '레진 충전' },
  { s: '중기', t: '인레이·온레이' },
  { s: '진행', t: '신경 치료 후 크라운' },
];
const esthetic = [
  { t: '크라운', d: '손상이 크거나 신경 치료한 치아를 감싸 보호합니다.' },
  { t: '인레이·온레이 · 브릿지', d: '충치 부위만 맞춤 제작하거나, 양옆 치아를 지지대로 빈자리를 메웁니다.' },
  { t: '미백 · 라미네이트 · 레진', d: '치아의 색과 모양을 자연스럽게 개선합니다.' },
];
import WorryBand from '../../components/WorryBand.astro';
const worries = ["이를 빼야 한다는데, 정말 살릴 방법은 없을까요?","임플란트 비용과 기간이 얼마나 될지 걱정돼요","바빠서 치과 갈 시간을 못 내고 있어요","찬물만 마시면 이가 시려요","씌운 이가 오래돼 색이 변했어요","사랑니가 욱신거리는데 뽑기가 무서워요","양치할 때마다 잇몸에서 피가 나요","과잉 진료는 아닐까 걱정돼요"];
---

<Layout
  title="청장년 클리닉 · 임플란트 · 자연치아 · 사랑니"
  description="파주 운정 김앤김치과 청장년 클리닉. 자연치아를 먼저 살펴보고 꼭 필요할 때 임플란트를 권합니다. CT 정밀 검사, 뼈이식·상악동 거상술 임플란트, 충치·신경 치료, 크라운·미백, 매복 사랑니 발치."
  crumbs={[{ name: '청장년 클리닉', path: '/adult/' }]}
  treatment
  clinic="adult"
  keywords={["파주 임플란트", "운정 임플란트", "뼈이식 임플란트", "상악동 거상술", "신경 치료", "크라운", "사랑니 발치", "매복 사랑니"]}
  procedures={["임플란트", "뼈이식 임플란트", "상악동 거상술 임플란트", "보험 임플란트", "레진 충전", "인레이·온레이", "신경 치료", "크라운", "브릿지", "잇몸 치료·스케일링", "미백", "라미네이트", "사랑니 발치", "매복 사랑니 발치", "치근단 절제술", "외과적 치주 처치"]}
>
  <PageHero
    clinic="adult"
    crumbs={['청장년 클리닉']}
    eyebrow="“내가 이 비용을 낸다면”"
    title="우리 부부엔 믿음을"
    suffix="김앤김치과"
    lead="일하고, 아이 키우고, 부모님 챙기느라 늘 뒷전이던 내 치아. 꼭 필요한 치료부터 정직하게 시작합니다."
  >
    <SubTabs items={tabs} current="" />
  </PageHero>

  <!-- ───────── 임플란트 ───────── -->

  <Section id="implant" eyebrow="임플란트" title="꼭 필요할 때, 꼭 필요한 만큼" lead="자연치아를 먼저 살펴보고, 임플란트가 꼭 필요한 경우에만 권해드립니다.">
    <Note quote={'일하고, 아이 키우고, 부모님 챙기느라|내 치아는 늘 뒷전이셨을 겁니다.\n제가 환자라면|‘정말 이 치아를 빼야 하나’부터|묻고 싶을 것 같아,\n살릴 방법을 먼저 말씀드립니다.\n임플란트가 꼭 필요하다면|기간과 총비용까지|미리 설명드리고 시작합니다.'} />
  </Section>

  <WorryBand items={worries} />

  <Section tone="surface" eyebrow="임플란트의 구조" title="옆 치아를 깎지 않고, 자연치아에 가까운 씹는 힘을 되찾습니다">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <Image src={tImplant} alt="3D CT로 임플란트 위치를 계획하는 화면과 임플란트 구조 모형" widths={[480, 640]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full rounded-3xl bg-white object-contain " />
      <ol class="space-y-3">
        {
          parts.map((p, i) => (
            <li class="flex items-center gap-5 rounded-2xl bg-background p-6 shadow-sm">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-primary t-mid font-bold text-primary-foreground">{i + 1}</span>
              <p><strong class="t-head">{p.t}</strong> <span class="ml-2 t-mid text-foreground-muted">{p.d}</span></p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section eyebrow="임플란트 종류" title="잇몸뼈 상태에 맞는 방법을 찾습니다">
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        kinds.map((k) => (
          <li class="rounded-3xl border border-border p-7">
            <h3 class="t-head font-bold">{k.t}</h3>
            <p class="mt-3 t-body text-foreground-muted whitespace-pre-line">{br(k.d)}</p>
            {k.link && <a href={url(k.link)} class="mt-4 inline-block t-body font-semibold text-primary hover:underline">실버 클리닉 보기 →</a>}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="surface" eyebrow="임플란트 치료 과정" title="검사부터 정기 검진까지">
    <Process
      items={[
        { title: '정밀 검사', text: '바텍(Vatech) CT로 뼈의 양과 신경 위치 확인' },
        { title: '상담', text: '치료 계획, 기간, 총비용 설명' },
        { title: '식립', text: '마취 후 식립' },
        { title: '골유착', text: '아래턱 약 2~3개월, 위턱 약 3~6개월' },
        { title: '보철', text: '맞춤 크라운 장착' },
        { title: '정기 검진', text: '6개월~1년마다 점검' },
      ]}
    />
  </Section>

  <PhotoBand src={bandSurgery} alt="직원과 함께 진료하는 대표원장" eyebrow="임플란트" text={'꼭 필요할 때,\n꼭 필요한 만큼'} position="50% 35%" />

  <!-- ───────── 자연치아·심미보철 ───────── -->

  <Section id="natural" eyebrow="자연치아·심미보철" title="내 치아를 오래, 자연스럽게" lead="덜 깎고, 나답게 되살립니다.">
    <Note quote={'제 치아라면 한 번이라도|덜 깎고 싶을 겁니다.\n그래서 충치는 범위를 확인해|꼭 필요한 만큼만 다듬고,\n신경 치료가 필요해도|뽑기 전에 살릴 방법부터 찾습니다.\n오래 쓰셔야 할 내 치아이니까요.'} />
  </Section>

  <Section tone="surface" eyebrow="자연치아 보존 치료" title="충치 치료">
    <Image src={tCavity} alt="충치를 다듬고 그 자리를 채우는 치료 그림" widths={[480, 640]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full rounded-3xl bg-white object-contain mb-6 max-h-[36rem] md:w-1/2" />
    <ol class="grid gap-3 md:grid-cols-3">
      {
        cavity.map((c) => (
          <li class="rounded-3xl bg-background p-7 shadow-sm">
            <span class="rounded-full bg-primary-surface px-3 py-1 t-body font-bold text-primary">{c.s}</span>
            <p class="mt-4 t-head font-bold">{c.t}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">신경 치료</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">염증이 신경까지 간 치아를 뽑지 않고 살리는 치료입니다.<br /> 오래 시리거나, 가만히 있어도 욱신거리거나, 잇몸이 붓는다면 검진을 받아보세요.</p>
      </div>
      <div class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">잇몸 치료 · 스케일링</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">잇몸 상태에 맞춰 단계별로 치료하며, 대부분 보험이 적용됩니다.</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="심미·보철 치료" title="자연스러운 색과 모양으로">
    <Image src={tCrown} alt="다듬은 치아 위에 크라운을 씌우는 보철 그림" widths={[480, 640]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full rounded-3xl bg-white object-contain mb-6 max-h-[36rem] md:w-1/2" />
    <ul class="grid gap-4 md:grid-cols-3">
      {
        esthetic.map((x) => (
          <li class="rounded-3xl border border-border p-7">
            <h3 class="t-head font-bold">{x.t}</h3>
            <p class="mt-3 t-body text-foreground-muted whitespace-pre-line">{br(x.d)}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <PhotoBand src={bandTreat} alt="직원과 함께 진료하는 대표원장" eyebrow="자연치아·심미보철" text={'덜 깎고,\n나답게 되살립니다.'} position="50% 35%" />

  <!-- ───────── 사랑니·구강외과 ───────── -->

  <Section id="wisdom" eyebrow="사랑니·구강외과" title="정확히 확인하고, 부담은 줄인 사랑니 발치" lead="미루지 말고, 편안하게.">
    <Note quote={'몇 년씩 미루는 마음, 충분히 압니다.\n얼마나 걸리고 얼마나 부을지,|신경과는 얼마나 가까운지|CT를 함께 보며 먼저 말씀드립니다.\n무엇이 기다리는지 알고 나면|막연한 걱정이 조금은 덜어지니까요.'} />
  </Section>

  <Section tone="surface" eyebrow="사랑니, 왜 빼야 할까요?" title="닦기 어려운 자리라 문제가 생기기 쉽습니다">
    <p class="max-w-prose t-mid leading-relaxed text-foreground-muted">칫솔이 닿기 어려워 충치와 잇몸 염증이 잘 생기고, 앞 어금니까지 상하게 할 수 있습니다.<br /> 나이가 들수록 회복도 더뎌집니다.</p>
  </Section>

  <Section eyebrow="매복 사랑니 발치" title="위치와 신경부터 확인합니다">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <Photo src={ctScan} alt="CT 촬영으로 사랑니 위치와 신경을 확인하는 모습" />
      <p class="t-mid leading-relaxed text-foreground-muted">정상 · 부분 매복 · 수평·완전 매복으로 나뉘며, 신경과 가까운 경우 CT로 거리를 확인한 뒤 계획합니다.</p>
    </div>
    <h3 class="mt-12 mb-5 t-head font-bold">발치 과정</h3>
    <Process items={[{ title: '위치·신경 확인' }, { title: '마취' }, { title: '발치·봉합' }, { title: '실밥 제거', text: '7~10일 뒤' }]} />
  </Section>

  <Section tone="surface" eyebrow="뽑기 전에, 살릴 방법부터" title="치아를 살리는 외과 치료">
    <ul class="grid gap-4 md:grid-cols-2">
      <li class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">치근단 절제술</h3>
        <p class="mt-3 t-body text-foreground-muted">신경 치료 후에도 남은 뿌리 끝 염증을 제거해 치아를 살립니다.</p>
      </li>
      <li class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">외과적 치주 처치</h3>
        <p class="mt-3 t-body text-foreground-muted">깊은 잇몸 속 염증을 직접 보며 정리합니다.</p>
      </li>
    </ul>
  </Section>

  <PhotoBand src={bandRoom} alt="김앤김치과 수술실" eyebrow="사랑니·구강외과" text={'얼마나 걸리고 얼마나 부을지\n먼저 말씀드립니다.'} />
  <!-- 자주 묻는 질문: 임플란트·자연치아·사랑니에서 2개씩(6개) 섞어서 맨 아래에. 나머지는 궁금해요 Q&A에서 -->
  <Section eyebrow="자주 묻는 질문" title="임플란트, 보철, 사랑니, 이것이 궁금해요">
    <FaqLinks groups={['implant', 'natural', 'wisdom']} limit={2} />
    <p class="mt-6 text-center"><a href={url('/qna/#implant')} class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border-accent px-6 t-body font-semibold text-primary hover:border-primary">궁금해요 Q&amp;A에서 더 보기 →</a></p>
  </Section>
</Layout>
