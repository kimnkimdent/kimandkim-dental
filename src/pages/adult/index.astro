---
// 청장년 클리닉(한 페이지): 임플란트(#implant) · 자연치아·심미보철(#natural) · 사랑니·구강외과(#wisdom).
// 각 묶음은 역지사지 진료 노트로 시작한다. 제목 아래 탭과 상단 메뉴는 src/site.ts의 청장년 클리닉 children을 쓴다.
import bandSurgery from '../../assets/photos/band-surgery.jpg';
import bandTreat from '../../assets/photos/band-treat.jpg';
import bandRoom from '../../assets/photos/surgery-room.jpg';
import ctScan from '../../assets/photos/ct-scan.jpg';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Note from '../../components/Note.astro';
import Process from '../../components/Process.astro';
import FaqLinks from '../../components/FaqLinks.astro';
import Photo from '../../components/Photo.astro';
import { Image } from 'astro:assets';
import tCavity from '../../assets/treat/treat-01.jpg';
import tCrown from '../../assets/treat/treat-07.jpg';
import part1 from '../../assets/implant/p1.jpg';
import part2 from '../../assets/implant/p2.jpg';
import part3 from '../../assets/implant/p3.jpg';
import SubTabs from '../../components/SubTabs.astro';
import ChapterHead from '../../components/ChapterHead.astro';
import { SITE, url, br } from '../../site';

const tabs = SITE.nav.find((n) => n.href === '/adult/')!.children!;
const parts = [
  { img: part1, t: '픽스처', d: '잇몸뼈 속에 심는 인공 치아 뿌리입니다. 뼈와 단단히 붙어 치아를 받쳐 줍니다.' },
  { img: part2, t: '지대주', d: '뿌리와 치아 머리를 이어 주는 연결 기둥입니다.' },
  { img: part3, t: '크라운', d: '눈에 보이는 치아 부분으로, 옆 치아의 색과 모양에 맞춰 만듭니다.' },
];
const kinds = [
  { t: '일반 임플란트', d: '잇몸뼈가 충분할 때 쓰는 가장 기본적인 방법입니다. CT로 뼈 상태를 확인하고 심을 위치를 정합니다.' },
  { t: '보험 임플란트', d: '만 65세 이상 평생 2개, 자세한 기준은 실버 클리닉에서 안내합니다.', link: '/silver/#insurance' },
  { t: '뼈이식 임플란트', d: '이를 뺀 지 오래되어 잇몸뼈가 얇아졌다면, 뼈를 먼저 채운 뒤 심습니다. 기간은 조금 더 걸리지만 임플란트를 튼튼하게 받칠 수 있습니다.' },
  { t: '상악동 거상술 임플란트', d: '위쪽 어금니 위에는 빈 공간(상악동)이 있어 뼈가 얕은 경우가 많습니다. 이 공간의 바닥을 살짝 올려 뼈를 채운 뒤 심습니다.' },
];
const cavity = [
  { s: '초기', t: '레진 충전', d: '작은 충치를 깎아 내고 치아 색 재료로 메웁니다. 대부분 당일에 끝납니다.' },
  { s: '중기', t: '인레이·온레이', d: '충치 범위가 넓으면 본을 떠 맞춤 조각을 만들어 채웁니다.' },
  { s: '진행', t: '신경 치료 후 크라운', d: '신경까지 상했다면 신경 치료로 치아를 살린 뒤 크라운으로 감싸 보호합니다.' },
];
const esthetic = [
  { t: '크라운', d: '많이 깨졌거나 신경 치료한 치아를 통째로 감싸, 더 깨지지 않게 보호합니다.' },
  { t: '인레이·온레이 · 브릿지', d: '충치 부위만 맞춤 조각으로 채우거나, 빠진 자리를 양옆 치아에 걸어 메웁니다.' },
  { t: '미백 · 라미네이트 · 레진', d: '누렇게 변한 색은 미백으로, 깨지거나 벌어진 앞니는 라미네이트나 레진으로 자연스럽게 다듬습니다.' },
];
import WorryBand from '../../components/WorryBand.astro';
const worries = ["이를 빼야 한다는데, 정말 살릴 방법은 없을까요?","임플란트 비용과 기간이 얼마나 될지 걱정돼요","퇴근하고 나면 치과 문이 다 닫혀 있어요","찬물만 마시면 이가 시려요","씌운 이가 오래돼 색이 변했어요","사랑니가 욱신거리는데 뽑기가 무서워요","양치할 때마다 잇몸에서 피가 나요","과잉 진료는 아닐까 걱정돼요"];
---

<Layout
  title="청장년 클리닉 · 임플란트 · 자연치아 · 사랑니"
  description="파주 운정 김앤김치과 청장년 클리닉. 자연치아를 먼저 살펴보고 꼭 필요할 때 임플란트를 권합니다. CT 정밀 검사, 뼈이식·상악동 거상술 임플란트, 충치·신경 치료, 크라운·미백, 매복 사랑니 발치."
  crumbs={[{ name: '청장년 클리닉', path: '/adult/' }]}
  treatment
  clinic="adult"
  keywords={["파주 임플란트", "운정 임플란트", "뼈이식 임플란트", "상악동 거상술", "신경 치료", "크라운", "사랑니 발치", "매복 사랑니"]}
  procedures={["임플란트", "뼈이식 임플란트", "상악동 거상술 임플란트", "보험 임플란트", "레진 충전", "인레이·온레이", "신경 치료", "크라운", "브릿지", "잇몸 치료·스케일링", "미백", "라미네이트", "사랑니 발치", "매복 사랑니 발치", "치근단 절제술", "외과적 치주 처치"]}
>
  <PageHero
    clinic="adult"
    crumbs={['청장년 클리닉']}
    eyebrow="“내가 이 비용을 낸다면”"
    title="우리 부부엔 믿음을"
    suffix="김앤김치과"
    lead="일하고, 아이 키우고, 부모님 챙기느라 늘 뒷전이던 내 치아. 꼭 필요한 치료부터 정직하게 시작합니다."
  >
    <SubTabs items={tabs} current="" />
  </PageHero>

  <WorryBand items={worries} />

  <!-- 역지사지 진료 노트: 고민 띠 바로 아래 -->
  <Section class="!pt-0">
    <Note quote={'일하고, 아이 키우고, 부모님 챙기느라|내 치아는 늘 뒷전이셨을 겁니다.\n제가 환자라면|‘정말 이 치아를 빼야 하나’부터|묻고 싶을 것 같아,\n살릴 방법을 먼저 말씀드립니다.\n꼭 치료가 필요하다면|기간과 총비용까지|미리 설명드리고 시작합니다.'} />
  </Section>

  <!-- ───────── 임플란트 ───────── -->

  <ChapterHead id="implant" photo={bandSurgery} position="50% 35%" index={1} title="임플란트" lead="자연치아를 먼저 살펴보고, 꼭 필요할 때만 권해 드립니다." items={tabs} />

  <Section tone="surface" eyebrow="임플란트의 구조" title="임플란트는 빠진 치아의 뿌리부터 다시 세우는 치료입니다">
    <!-- 심는 순서대로 세 부분: 그림(픽스처 → 지대주 → 크라운) + 번호 · 이름 · 설명 -->
    <ol class="grid gap-4 sm:grid-cols-3">
      {
        parts.map((p, i) => (
          <li class="relative flex flex-col rounded-3xl bg-background p-6 shadow-sm">
            <Image src={p.img} alt={`임플란트 ${p.t} 그림`} widths={[300, 540]} sizes="(min-width: 640px) 30vw, 100vw" class="mx-auto aspect-[54/74] h-auto w-full max-w-[22rem] object-contain" />
            <p class="mt-5 flex items-center gap-2.5"><span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary t-body font-bold text-primary-foreground">{i + 1}</span><strong class="t-head">{p.t}</strong></p>
            <p class="mt-2 t-body leading-relaxed text-foreground-muted">{p.d}</p>
            {i < parts.length - 1 && <span aria-hidden="true" class="absolute top-1/3 -right-3.5 z-10 hidden size-7 items-center justify-center rounded-full bg-primary-surface text-primary sm:flex">→</span>}
          </li>
        ))
      }
    </ol>
  </Section>

  <Section eyebrow="임플란트 종류" title="잇몸뼈 상태에 맞는 방법을 찾습니다">
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        kinds.map((k) => (
          <li class="rounded-3xl border border-border p-7">
            <h3 class="t-head font-bold">{k.t}</h3>
            <p class="mt-3 t-body text-foreground-muted whitespace-pre-line">{br(k.d)}</p>
            {k.link && <a href={url(k.link)} class="mt-4 inline-block t-body font-semibold text-primary hover:underline">실버 클리닉 보기 →</a>}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="surface" eyebrow="임플란트 치료 과정" title="검사부터 정기 검진까지">
    <Process
      items={[
        { title: '정밀 검사', text: '바텍(Vatech) CT로 뼈의 양과 신경 위치를 입체적으로 확인합니다.' },
        { title: '상담', text: '치료 계획과 기간, 총비용을 시작 전에 모두 설명드립니다.' },
        { title: '식립', text: '충분히 마취한 뒤 잇몸뼈에 인공 뿌리를 심습니다.' },
        { title: '골유착', text: '뼈와 단단히 붙을 때까지 기다립니다. 아래턱 약 2~3개월, 위턱 약 3~6개월입니다.' },
        { title: '보철', text: '본을 떠 만든 맞춤 크라운을 연결합니다.' },
        { title: '정기 검진', text: '6개월~1년마다 잇몸과 맞물림을 점검합니다.' },
      ]}
    />
  </Section>

  <!-- ───────── 자연치아·심미보철 ───────── -->

  <ChapterHead id="natural" photo={bandRoom} index={2} title="자연치아·심미보철" lead="덜 깎고, 나답게 되살립니다." items={tabs} />

  <Section tone="surface" eyebrow="자연치아 보존 치료" title="충치 치료">
    <Image src={tCavity} alt="충치를 다듬고 그 자리를 채우는 치료 그림" widths={[480, 640]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full rounded-3xl bg-white object-contain mb-6 max-h-[36rem] md:w-1/2" />
    <ol class="grid gap-3 md:grid-cols-3">
      {
        cavity.map((c) => (
          <li class="rounded-3xl bg-background p-7 shadow-sm">
            <span class="rounded-full bg-primary-surface px-3 py-1 t-body font-bold text-primary">{c.s}</span>
            <p class="mt-4 t-head font-bold">{c.t}</p>
            <p class="mt-2 t-body leading-relaxed text-foreground-muted">{c.d}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">신경 치료</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">염증이 신경까지 간 치아를 뽑지 않고 살리는 치료입니다.<br /> 오래 시리거나, 가만히 있어도 욱신거리거나, 잇몸이 붓는다면 검진을 받아보세요.</p>
      </div>
      <div class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">잇몸 치료 · 스케일링</h3>
        <p class="mt-3 t-body leading-relaxed text-foreground-muted">잇몸 상태에 맞춰 단계별로 치료하며, 대부분 보험이 적용됩니다.</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="심미·보철 치료" title="자연스러운 색과 모양으로">
    <Image src={tCrown} alt="다듬은 치아 위에 크라운을 씌우는 보철 그림" widths={[480, 640]} sizes="(min-width: 768px) 40vw, 100vw" class="w-full rounded-3xl bg-white object-contain mb-6 max-h-[36rem] md:w-1/2" />
    <ul class="grid gap-4 md:grid-cols-3">
      {
        esthetic.map((x) => (
          <li class="rounded-3xl border border-border p-7">
            <h3 class="t-head font-bold">{x.t}</h3>
            <p class="mt-3 t-body text-foreground-muted whitespace-pre-line">{br(x.d)}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- ───────── 사랑니·구강외과 ───────── -->

  <ChapterHead id="wisdom" photo={bandTreat} position="50% 35%" index={3} title="사랑니·구강외과" lead="미루지 말고, 편안하게." items={tabs} />

  <Section tone="surface" eyebrow="사랑니, 왜 빼야 할까요?" title="닦기 어려운 자리라 문제가 생기기 쉽습니다">
    <p class="max-w-prose t-mid leading-relaxed text-foreground-muted">칫솔이 닿기 어려워 충치와 잇몸 염증이 잘 생기고, 앞 어금니까지 상하게 할 수 있습니다.<br /> 나이가 들수록 회복도 더뎌집니다.</p>
  </Section>

  <Section eyebrow="매복 사랑니 발치" title="위치와 신경부터 확인합니다">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <Photo src={ctScan} alt="CT 촬영으로 사랑니 위치와 신경을 확인하는 모습" />
      <p class="t-mid leading-relaxed text-foreground-muted">정상 · 부분 매복 · 수평·완전 매복으로 나뉘며, 신경과 가까운 경우 CT로 거리를 확인한 뒤 계획합니다.</p>
    </div>
    <h3 class="mt-12 mb-5 t-head font-bold">발치 과정</h3>
    <Process items={[{ title: '위치·신경 확인', text: 'CT로 사랑니 방향과 신경까지의 거리를 확인합니다.' }, { title: '마취', text: '충분히 마취가 된 것을 확인한 뒤 시작합니다.' }, { title: '발치·봉합', text: '필요하면 나눠서 빼고, 잇몸을 꿰매 마무리합니다.' }, { title: '실밥 제거', text: '7~10일 뒤 실밥을 풀고 아문 상태를 확인합니다.' }]} />
  </Section>

  <Section tone="surface" eyebrow="뽑기 전에, 살릴 방법부터" title="치아를 살리는 외과 치료">
    <ul class="grid gap-4 md:grid-cols-2">
      <li class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">치근단 절제술</h3>
        <p class="mt-3 t-body text-foreground-muted">신경 치료 후에도 뿌리 끝에 염증이 남았을 때, 그 부분만 제거해 치아를 뽑지 않고 살립니다.</p>
      </li>
      <li class="rounded-3xl bg-background p-8 shadow-sm">
        <h3 class="t-head font-bold">외과적 치주 처치</h3>
        <p class="mt-3 t-body text-foreground-muted">잇몸 깊숙이 생긴 염증은 잇몸을 살짝 열고 직접 보며 깨끗이 정리합니다.</p>
      </li>
    </ul>
  </Section>

  <!-- 자주 묻는 질문: 임플란트·자연치아·사랑니의 최근 질문 5개를 섞어서 맨 아래에. 나머지는 궁금해요 Q&A에서 -->
  <Section eyebrow="자주 묻는 질문" title="임플란트, 보철, 사랑니, 이것이 궁금해요">
    <FaqLinks groups={['implant', 'natural', 'wisdom']} />
  </Section>
</Layout>
