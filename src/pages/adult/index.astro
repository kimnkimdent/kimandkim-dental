---
import Disclaimer from '../../components/Disclaimer.astro';
import perio from '../../assets/wisdom/perio-v4.jpg';
import apico from '../../assets/wisdom/apico-v2.jpg';
import ws1 from '../../assets/wisdom/ext1-v3.jpg';
import ws2 from '../../assets/wisdom/ext2-v3.jpg';
import ws3 from '../../assets/wisdom/ext3-v3.jpg';
import ws4 from '../../assets/wisdom/ext4-v3.jpg';
// 청장년 클리닉(한 페이지): 임플란트(#implant) · 자연치아·심미보철(#natural) · 사랑니·구강외과(#wisdom).
// 각 묶음은 역지사지 진료 노트로 시작한다. 제목 아래 탭과 상단 메뉴는 src/site.ts의 청장년 클리닉 children을 쓴다.
import bandSurgery from '../../assets/photos/band-surgery.jpg';
import bandTreat from '../../assets/photos/band-treat.jpg';
import bandRoom from '../../assets/photos/surgery-room.jpg';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Note from '../../components/Note.astro';
import Process from '../../components/Process.astro';
import FaqLinks from '../../components/FaqLinks.astro';
import Photo from '../../components/Photo.astro';
import { Image } from 'astro:assets';
import part1 from '../../assets/implant/p1.jpg';
import part2 from '../../assets/implant/p2.jpg';
import part3 from '../../assets/implant/p3.jpg';
import kBasic from '../../assets/implant/k-basic-v3.jpg';
import kInsurance from '../../assets/implant/k-insurance-v3.jpg';
import kGraft from '../../assets/implant/k-graft-v3.jpg';
import kSinus from '../../assets/implant/k-sinus-v3.jpg';
import ip1 from '../../assets/implant/i1.jpg';
import ip2 from '../../assets/implant/i2.jpg';
import ip3 from '../../assets/implant/i3.jpg';
import ip4 from '../../assets/implant/i4.jpg';
import ip5 from '../../assets/implant/i5.jpg';
import ip6 from '../../assets/implant/i6.jpg';
import StepFlow from '../../components/StepFlow.astro';
import nat1 from '../../assets/natural/n1.jpg';
import nat2 from '../../assets/natural/n2.jpg';
import nat3 from '../../assets/natural/n3.jpg';
import nat4 from '../../assets/natural/n4.jpg';
import imgCrown from '../../assets/natural/crown.jpg';
import imgBridge from '../../assets/natural/bridge.jpg';
import imgWhite from '../../assets/natural/whitening-v2.jpg';
import imgLam from '../../assets/natural/laminate-v5.jpg';
import imgResin from '../../assets/natural/resin-v2.jpg';
import imgWhy from '../../assets/wisdom/why.jpg';
import imgWhyMolar from '../../assets/wisdom/why-molar.jpg';
import ImageCard from '../../components/ImageCard.astro';
import SubTabs from '../../components/SubTabs.astro';
import ChapterHead from '../../components/ChapterHead.astro';
import { SITE, url, br } from '../../site';

const tabs = SITE.nav.find((n) => n.href === '/adult/')!.children!;
const parts = [
  { img: part1, t: '픽스처', d: '잇몸뼈 속에 심는 인공 치아 뿌리입니다. 뼈와 단단히 붙어 치아를 받쳐 줍니다.' },
  { img: part2, t: '지대주', d: '뿌리와 치아 머리를 이어 주는 연결 기둥입니다.' },
  { img: part3, t: '크라운', d: '눈에 보이는 치아 부분으로, 옆 치아의 색과 모양에 맞춰 만듭니다.' },
];
const kinds = [
  { img: kBasic, t: '일반 임플란트', d: '잇몸뼈가 충분할 때 쓰는 가장 기본적인 방법입니다. CT로 뼈 상태를 확인하고 심을 위치를 정합니다.' },
  { img: kInsurance, t: '보험 임플란트', d: '만 65세 이상 평생 2개, 자세한 기준은 실버 클리닉에서 안내합니다.', link: '/silver/#insurance' },
  { img: kGraft, t: '뼈이식 임플란트', d: '이를 뺀 지 오래되어 잇몸뼈가 얇아졌다면, 뼈를 먼저 채운 뒤 심습니다. 기간은 조금 더 걸리지만 임플란트를 튼튼하게 받칠 수 있습니다.' },
  { img: kSinus, t: '상악동 거상술 임플란트', d: '위쪽 어금니 위에는 빈 공간(상악동)이 있어 뼈가 얕은 경우가 많습니다. 이 공간의 바닥을 살짝 올려 뼈를 채운 뒤 심습니다.' },
];
// 자연치아·심미보철: 살리는 치료(보존) → 되살리는 치료(보철) → 다듬는 치료(심미). 서로 겹치지 않게 나눈다.
const cavity = [
  { img: nat1, s: '초기 충치', t: '레진 충전', d: '작은 충치를 깎아 내고 치아 색 재료로 메웁니다. 티가 잘 나지 않고 대부분 당일에 끝납니다.' },
  { img: nat2, s: '넓은 충치', t: '인레이 · 온레이', d: '충치 범위가 넓으면 본을 떠 맞춤 조각을 만들어, 상한 부분만 정확히 채웁니다.' },
  { img: nat3, s: '신경까지 간 충치', t: '신경 치료', d: '염증이 신경까지 갔다면 신경을 깨끗이 정리해 뽑지 않고 살립니다. 오래 시리거나 욱신거리면 검진을 받아 보세요.' },
  { img: nat4, s: '잇몸 염증', t: '잇몸 치료 · 스케일링', d: '치석을 없애고 잇몸 상태에 맞춰 단계별로 치료합니다. 대부분 건강보험이 적용됩니다.' },
];
const prosth = [
  { img: imgCrown, t: '크라운', d: '신경 치료한 치아나 크게 깨진 치아를 통째로 감싸, 더 깨지지 않고 오래 쓸 수 있게 보호합니다.' },
  { img: imgBridge, t: '브릿지', d: '빠진 치아 양옆을 지지대로 삼아 다리처럼 이어 빈자리를 메웁니다. 임플란트가 어려울 때 쓰며, 양옆 치아를 깎아야 하는 점도 함께 고려합니다.' },
];
const esthetic = [
  { img: imgWhite, t: '미백', d: '치아 표면을 깎지 않고, 누렇게 변한 색을 밝게 되돌립니다. 며칠간 시릴 수 있고, 씌운 치아나 레진은 색이 바뀌지 않습니다.' },
  { img: imgLam, t: '라미네이트', d: '앞니 겉면을 얇게 다듬고 맞춤 판을 붙여, 깨지거나 벌어진 모양을 정리합니다. 겉면을 깎아 원래대로 되돌릴 수 없으므로, 충분히 상담한 뒤 결정합니다.' },
  { img: imgResin, t: '앞니 레진', d: '작게 깨지거나 틈이 있는 앞니를 치아 색 재료로 메워 자연스럽게 다듬습니다.' },
];
import WorryBand from '../../components/WorryBand.astro';
const worries = ["이를 빼야 한다는데, 정말 살릴 방법은 없을까요?","임플란트 비용과 기간이 얼마나 될지 걱정돼요","퇴근하고 나면 치과 문이 다 닫혀 있어요","찬물만 마시면 이가 시려요","씌운 이가 오래돼 색이 변했어요","사랑니가 욱신거리는데 뽑기가 무서워요","양치할 때마다 잇몸에서 피가 나요","과잉 진료는 아닐까 걱정돼요"];
---

<Layout
  title="청장년 클리닉 · 임플란트 · 자연치아 · 사랑니"
  description="파주 운정 김앤김치과 청장년 클리닉. 자연치아를 먼저 살펴보고 꼭 필요할 때 임플란트를 권합니다. CT 정밀 검사, 뼈이식·상악동 거상술 임플란트, 충치·신경 치료, 크라운·미백, 매복 사랑니 발치."
  crumbs={[{ name: '청장년 클리닉', path: '/adult/' }]}
  treatment
  clinic="adult"
  keywords={["파주 임플란트", "운정 임플란트", "뼈이식 임플란트", "상악동 거상술", "신경 치료", "크라운", "사랑니 발치", "매복 사랑니"]}
  procedures={["임플란트", "뼈이식 임플란트", "상악동 거상술 임플란트", "보험 임플란트", "레진 충전", "인레이·온레이", "신경 치료", "크라운", "브릿지", "잇몸 치료·스케일링", "미백", "라미네이트", "사랑니 발치", "매복 사랑니 발치", "치근단 절제술", "외과적 치주 처치"]}
>
  <PageHero
    clinic="adult"
    crumbs={['청장년 클리닉']}
    eyebrow="“내가 이 비용을 낸다면”"
    title="우리 부부엔 믿음을"
    suffix="김앤김치과"
    lead="일하고, 아이 키우고, 부모님 챙기느라 늘 뒷전이던 내 치아. 꼭 필요한 치료부터 정직하게 시작합니다."
  >
    <SubTabs items={tabs} current="" />
  </PageHero>

  <WorryBand items={worries} />

  <!-- 역지사지 진료 노트: 고민 띠 바로 아래 -->
  <Section class="!pt-0">
    <Note quote={'일하고, 아이 키우고, 부모님 챙기느라|내 치아는 늘 뒷전이셨을 겁니다.\n제가 환자라면|‘정말 이 치아를 빼야 하나’부터|묻고 싶을 것 같아,\n살릴 방법을 먼저 말씀드립니다.\n꼭 치료가 필요하다면|기간과 총비용까지|미리 설명드리고 시작합니다.'} />
    <p class="mt-6 text-center t-mid text-foreground-muted">퇴근 후에도 오실 수 있도록 <strong class="text-primary">화요일은 저녁 8시 30분까지</strong> 진료합니다.</p>
  </Section>

  <!-- ───────── 임플란트 ───────── -->

  <ChapterHead id="implant" photo={bandSurgery} position="50% 35%" index={1} title="임플란트" lead="자연치아를 먼저 살펴보고, 꼭 필요할 때만 권해 드립니다." items={tabs} />

  <Section tone="surface" eyebrow="임플란트의 구조" title="임플란트는 빠진 치아를 뿌리부터 다시 만들어,|내 치아처럼 단단하게 씹을 수 있게 해 줍니다">
    <!-- 심는 순서대로 세 부분: 픽스처 → 지대주 → 크라운 -->
    <ol class="grid gap-4 sm:grid-cols-3">
      {parts.map((p, i) => <ImageCard img={p.img} alt={`임플란트 ${p.t} 그림`} no={i + 1} title={p.t} text={p.d} />)}
    </ol>
  </Section>

  <Section eyebrow="임플란트 종류" title="잇몸뼈의 양과 위치를 먼저 확인하고,|내 상태에 꼭 맞는 임플란트 방법을 찾습니다">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {kinds.map((k) => <ImageCard img={k.img} alt={`${k.t} 모형 그림`} title={k.t} text={k.d} link={k.link ? { href: k.link, label: '실버 클리닉 보기 →' } : undefined} />)}
    </ul>
  </Section>

  <Section tone="surface" eyebrow="임플란트 치료 과정" title="CT 정밀 검사부터 심은 뒤 정기 검진까지,|모든 과정을 미리 설명드리고 진행합니다">
    <StepFlow boxed
      items={[
        { img: ip1, t: '정밀 검사', d: '바텍(Vatech) CT로 뼈의 양과 신경 위치를 입체적으로 확인합니다.' },
        { img: ip2, t: '상담', d: '치료 계획과 기간, 총비용을 시작 전에 모두 설명드립니다.' },
        { img: ip3, t: '식립', d: '충분히 마취한 뒤 잇몸뼈에 인공 뿌리를 심습니다.' },
        { img: ip4, t: '골유착', d: '뼈와 단단히 붙을 때까지 기다립니다. 아래턱 약 2~3개월, 위턱 약 3~6개월입니다.' },
        { img: ip5, t: '보철', d: '본을 떠 만든 맞춤 크라운을 연결합니다.' },
        { img: ip6, t: '정기 검진', d: '6개월~1년마다 잇몸과 맞물림을 점검합니다.' },
      ]}
    />
    <div class="mt-8">
      <div class="rounded-3xl bg-background p-7 shadow-sm">
        <h3 class="t-head font-bold">심은 뒤에는 이렇게 관리합니다</h3>
        <p class="mt-2 t-body leading-relaxed text-foreground-muted">담배는 뼈와 붙는 것을 방해하니 치료 기간에는 피해 주세요. 당뇨가 있으시면 혈당을 꾸준히 관리하는 것이 중요합니다.</p>
      </div>
    </div>
  </Section>

  <!-- ───────── 자연치아·심미보철 ───────── -->

  <ChapterHead id="natural" photo={bandRoom} index={2} title="자연치아·심미보철" lead="덜 깎고, 나답게 되살립니다." items={tabs} />

  <!-- 1. 보존: 충치 단계별로 꼭 필요한 만큼 + 잇몸 치료 -->
  <Section tone="surface" eyebrow="자연치아 보존 치료" title="충치와 잇몸 상태를 먼저 확인하고,|내 치아를 최대한 남기도록 꼭 필요한 만큼만 치료합니다">
    <!-- 4가지 보존 치료: 흰 상자마다 그림 · 상태 · 치료 이름 · 설명 (충치가 깊어지는 순서 → 잇몸) -->
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        cavity.map((c) => (
          <li class="flex flex-col rounded-3xl bg-background p-6 shadow-sm">
            <Image src={c.img} alt={`${c.t} 그림`} widths={[300, 600]} sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 100vw" class="mx-auto aspect-square h-auto w-full max-w-[22rem] object-contain" />
            <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class="rounded-full bg-primary-surface px-3 py-1 t-body font-bold whitespace-nowrap text-primary">{c.s}</span>
              <h3 class="t-head font-bold">{c.t}</h3>
            </div>
            <p class="mt-2 t-body leading-relaxed text-foreground-muted">{c.d}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- 2. 보철: 잃은 부분을 되살리는 치료 -->
  <Section eyebrow="보철 치료" title="약해지거나 빠진 치아는,|다시 튼튼하게 되살립니다">
    <!-- 크라운 / 브릿지 -->
    <ul class="grid gap-4 sm:grid-cols-2 lg:mx-auto lg:max-w-[80rem]">
      {prosth.map((x) => <ImageCard img={x.img} alt={`${x.t} 치료 그림`} title={x.t} text={x.d} />)}
    </ul>
  </Section>

  <!-- 3. 심미: 색과 모양을 다듬는 치료 -->
  <Section tone="surface" eyebrow="심미 치료" title="누런 색, 깨지거나 벌어진 앞니도|자연스럽게 다듬습니다">
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {esthetic.map((x) => <ImageCard img={x.img} alt={`${x.t} 치료 그림`} title={x.t} text={x.d} />)}
    </ul>
  </Section>

  <!-- ───────── 사랑니·구강외과 ───────── -->

  <ChapterHead id="wisdom" photo={bandTreat} position="50% 35%" index={3} title="사랑니·구강외과" lead="미루지 말고, 편안하게." items={tabs} />

  <Section class="!py-14 md:!py-20" tone="surface" eyebrow="사랑니, 왜 빼야 할까요?" title="사랑니는 칫솔이 닿기 어려운 맨 안쪽에 있어,|충치와 잇몸 염증이 생기기 쉽습니다">
    <div class="grid items-center gap-6 md:grid-cols-[1fr_2fr] md:gap-10">
      <Photo class="mx-auto w-full max-w-[36rem]" ratio="aspect-[16/10]" src={imgWhyMolar} alt="아래턱 맨 안쪽 사랑니 주변에 기구가 닿기 어려운 모습을 보여 주는 그림" />
      <p class="t-mid leading-relaxed text-foreground-muted">칫솔이 닿기 어려워 충치와 잇몸 염증이 잘 생기고, 앞 어금니까지 상하게 할 수 있습니다.<br /> 나이가 들수록 회복도 더뎌집니다.</p>
    </div>
  </Section>

  <Section class="!py-14 md:!py-20" eyebrow="매복 사랑니 발치" title="누워 있거나 뼈 속에 묻힌 사랑니도,|위치와 신경까지의 거리를 먼저 확인하고 신중하게 뽑습니다">
    <div class="grid items-center gap-6 md:grid-cols-[1fr_2fr] md:gap-10">
      <Photo class="mx-auto w-full max-w-[36rem]" ratio="aspect-[16/10]" src={imgWhy} alt="3D 엑스레이에서 맨 안쪽에 비스듬히 난 위아래 사랑니를 화살표로 표시한 그림" />
      <p class="t-mid leading-relaxed text-foreground-muted">사랑니는 반듯하게 난 경우부터 비스듬히 눕거나 뼈 속에 묻힌 경우(매복)까지 다양합니다. 신경과 가깝다면 CT로 거리를 먼저 확인하고 계획합니다.</p>
    </div>
    <h3 class="mt-10 mb-4 t-head font-bold">발치 과정</h3>
