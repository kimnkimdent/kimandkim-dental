---
import '../styles/global.css';
import { SITE, url } from '../site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickMenu from '../components/QuickMenu.astro';
import VisitInfo from '../components/VisitInfo.astro';
import { baseSchema, breadcrumb, pageSchema, topics } from '../seo';
import { qnaUpdated } from '../qna';

interface Props {
  title?: string; // 페이지 제목. 없으면 홈 제목
  description?: string; // 검색 결과에 나오는 설명(80~150자 권장)
  image?: string;
  noindex?: boolean;
  crumbs?: { name: string; path: string }[]; // 검색엔진용 페이지 위치
  schema?: object[]; // 이 페이지에만 붙일 구조화데이터(FAQ 등). 병원·원장 정보는 모든 페이지에 자동으로 붙는다.
  clinic?: 'silver' | 'adult' | 'kids'; // 진료 과목 색(src/styles/global.css의 data-clinic)
  treatment?: boolean; // 진료 페이지: 하단 부작용 안내 문구 + 의료 페이지 구조화데이터(원장 검수)
  procedures?: string[]; // 진료 페이지가 다루는 진료 항목
  keywords?: string[]; // 이 페이지 핵심 검색어(병원 공통 검색어 앞에 붙는다)
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  noindex = false,
  crumbs = [],
  schema = [],
  treatment = false,
  procedures = [],
  clinic,
  keywords = [],
} = Astro.props;
const fullTitle = title ? `${title} | 파주 운정 ${SITE.name}` : `${SITE.name} | 파주 운정 야당동 치과 · 임플란트 · 틀니 · 어린이 치과 진료`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const modified = qnaUpdated; // 원고 최종 검수일. 내용을 크게 고치면 src/qna.ts의 qnaUpdated를 갱신한다.
const jsonLd = [
  ...baseSchema(Astro.site!),
  ...(noindex ? [] : [pageSchema(Astro.site!, { path, title: fullTitle, description, image, medical: treatment, procedures, modified })]),
  ...(crumbs.length ? [breadcrumb(Astro.site!, crumbs)] : []),
  ...schema,
];
const kw = [...new Set([...keywords, SITE.name, ...topics.slice(0, 8)])].join(', ');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={kw} />
    <meta name="author" content={SITE.fullName} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="geo.region" content="KR-41" />
    <meta name="geo.placename" content="경기도 파주시 야당동" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap-index.xml')} />
    <link rel="alternate" type="text/plain" title="llms.txt (AI용 병원 요약)" href={url('/llms.txt')} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.fullName} — ${SITE.concept}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
    {SITE.verification.naver && <meta name="naver-site-verification" content={SITE.verification.naver} />}

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body id="top" class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1" data-clinic={clinic}>
      <slot />
    </main>
    <VisitInfo />
    <Footer />
    <QuickMenu />
  </body>
</html>
